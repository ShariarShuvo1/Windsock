<?xml version="1.0" encoding="utf-8"?>

<!--
  The Microsoft Store package manifest, for the Store edition only.

  The Store takes an .msix, not an installer: Windsock-win-Setup.exe and
  Windsock-win.msi are the GitHub downloads and have nothing to do with this
  file. The package is uploaded
  unsigned and Microsoft signs it, which is the whole reason this route costs
  nothing where the EXE route needs a bought certificate.

  Identity is not ours to choose. Name and Publisher below are the exact
  strings Partner Center assigned when the name "Windsock" was reserved, read
  off Product management -> Product identity. A package whose identity differs
  by one character is rejected at upload, so do not tidy these.

  Version must be four parts and the fourth must be zero - the Store reserves
  the revision field. The release workflow overwrites this line with the tag's
  version; the literal here keeps the file valid on its own so the package can
  be built and installed locally for testing.
-->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 desktop rescap">

  <Identity
    Name="ShariarShuvo.Windsock"
    Publisher="CN=AEF1F62A-49C8-4FA5-87FD-5060B6E44A7F"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Windsock</DisplayName>
    <PublisherDisplayName>Shariar Shuvo</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!--
      1809 is the floor the README states and the runtime guards hold. Nothing
      in the Store edition reaches past it: the features that need more recent
      Windows are the ones this edition is built without.
    -->
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!--
      EntryPoint rather than the newer uap10:RuntimeBehavior and uap10:TrustLevel
      pair, and deliberately so. Those attributes arrived in Windows 10 2004
      (build 19041), and MinVersion above is 17763. Modernising this line would
      quietly drop every Windows version between the two.
    -->
    <Application
      Id="Windsock"
      Executable="Windsock.exe"
      EntryPoint="Windows.FullTrustApplication">

      <!--
        BackgroundColor is sampled from the icon's own ground (#0E2231), so the
        rounded square in the tile images meets the tile behind it without a
        seam. The tile assets carry transparent padding for the same reason -
        the glyph floats on the tile rather than sitting on a badge.
      -->
      <uap:VisualElements
        DisplayName="Windsock"
        Description="A network speed meter for the Windows 11 taskbar. Live upload and download rates on the taskbar itself, how much each app uses the network, and per-minute history you can chart and export."
        BackgroundColor="#0E2231"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">

        <uap:DefaultTile
          Square71x71Logo="Images\Square71x71Logo.png"
          Square310x310Logo="Images\Square310x310Logo.png"
          Wide310x150Logo="Images\Wide310x150Logo.png" />

      </uap:VisualElements>

      <Extensions>
        <!--
          Run at login, for the packaged edition only.

          The unpackaged Windsock writes an HKCU Run value. Inside this
          container that write is redirected into a private copy of the
          registry, so it succeeds, reads back as written, and Windows starts
          nothing. This declaration is the supported way, and it is also what
          lists Windsock under Settings and Task Manager where a person expects
          to find it and can turn it off.

          Enabled is false because the app's own setting is off by default, and
          it would be rude to add ourselves to someone's startup on install.
          PackagedStartup switches it through Windows.ApplicationModel.StartupTask.

          TaskId must match PackagedStartup.TaskId exactly. Windows matches on
          this string and simply answers no when it does not, so a typo shows up
          as the setting never working rather than as an error.
        -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="Windsock.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask
            TaskId="WindsockStartup"
            Enabled="false"
            DisplayName="Windsock" />
        </uap5:Extension>

      </Extensions>
    </Application>

    <!--
      The command line and the AI tools, each an application of its own whose
      Executable is the program its alias starts. Windows puts windsock.exe and
      windsock-mcp.exe in %LOCALAPPDATA%\Microsoft\WindowsApps, which is on
      PATH, so `windsock status` works in any console once the app is installed,
      the way winget does; a packaged program cannot be started by its path
      inside WindowsApps, so this is also how an AI assistant's settings name the
      tools server.

      Why not an alias on the main application, pointing its Executable at the
      command line: that is the form Windows Terminal uses, but the main
      application's own Executable is Windsock.exe, and nothing measured here
      shows which of the two such an alias would start. An application whose
      Executable is the command line cannot start anything else. One alias each,
      too: makeappx refuses a second windows.appExecutionAlias in one
      Application (measured). AppListEntry="none" keeps both out of Start.

      The unpackaged editions ship the same programs beside Windsock.exe, plus
      Windsock.com, and reach PATH only if the person adds the folder.

      Not yet exercised by a real Store package: on the first Store build,
      check that `windsock status` runs in a console and prints there, that
      piping it (`windsock status | more`) works, and that an assistant can
      start windsock-mcp. (No double hyphen in here: XML comments cannot hold
      one.)
    -->
    <Application
      Id="WindsockCommand"
      Executable="Windsock.Cli.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="Windsock command line"
        Description="The windsock command: status, usage, exports and home devices, for scripts."
        BackgroundColor="#0E2231"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="Windsock.Cli.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="windsock.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>

    <Application
      Id="WindsockTools"
      Executable="Windsock.Mcp.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="Windsock tools for AI assistants"
        Description="A read-only Model Context Protocol server over Windsock's local feed."
        BackgroundColor="#0E2231"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="Windsock.Mcp.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="windsock-mcp.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      A WPF desktop application is full trust by definition; this is the
      declaration that says so rather than a request for anything extra. It is
      "restricted" in name only - every packaged desktop app declares it, and
      it is granted on submission without review.
    -->
    <rescap:Capability Name="runFullTrust" />

    <!--
      Reads Windows' own data usage - how much each app used the network, the
      figures Settings shows - through
      ConnectionProfile.GetAttributedNetworkUsageAsync. Microsoft's capability
      list names this capability for that call and says anyone may request it
      for a Store submission; the Partner Center justification is that the Apps
      page, per-app history and the Process page's per-program figures are read
      from it, and nothing is sent anywhere.

      The Store edition takes no trace session, no driver and no elevation.
    -->
    <rescap:Capability Name="networkDataUsageManagement" />

    <!--
      Location, for Wi-Fi only. Since Windows 11 24H2 the network's name and
      the nearby networks a scan hears are given only to apps the person has
      allowed location, because both can tell where a PC is. Windsock never
      asks for a position: the Wi-Fi signal, band, channel and speed come from
      the realtime quality call, which needs nothing, and Windows asks the
      person only when they open Wi-Fi details or start a scan. Not wiFiControl:
      that governs the WinRT WiFiAdapter class and MSM notifications, and
      Windsock uses neither - only wlanapi's queries and scans. Not yet
      exercised inside a real package (2026-10-05).
    -->
    <DeviceCapability Name="location" />
  </Capabilities>

</Package>

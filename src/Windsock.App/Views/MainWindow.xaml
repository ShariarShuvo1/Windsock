<Window x:Class="Windsock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Windsock.App.Controls"
        mc:Ignorable="d"
        Title="Windsock"
        Width="1100"
        Height="760"
        MinWidth="460"
        MinHeight="470"
        Background="{DynamicResource WindowGroundBrush}"
        Cursor="Arrow"
        WindowStartupLocation="CenterScreen">

    <!--
        The cursor is stated on the window because nothing else states it. A
        control that wants a hand sets one and, being the innermost thing under
        the pointer, wins; but where nothing sets a cursor at all the framework
        leaves the last one alone, so a hand picked up over a tile or a button
        stayed a hand across the whole page. This is the floor it falls back to.

        The minimum width is the old one plus the folded sidebar, so the page
        beside it is never narrower than the whole window used to be allowed to
        get.
    -->

    <!--
        A sidebar down the left chooses the page; the page beside it is that one
        thing and nothing else.

        One entry per part of the machine, each carrying its live figure beside
        its name. A part with more than one page is a group: Network holds its
        overview, whether the internet is there, what has moved over time and
        which apps are using it, live or over a period.
        Pressing a group opens it at its overview; its pages are listed under it.
        Processor, graphics, memory and storage are one page each. The taskbar meter
        follows, and Settings sits apart at the bottom, where it is looked for.

        The panels are handed in from the code behind rather than declared here:
        they own view models with their own lifetimes, which is the container's
        business, not the markup's. The five machine overviews share one panel,
        which the code behind puts on the page when any of them is chosen.

        The window itself does not scroll. A page that needs more room than it
        has scrolls inside itself.
    -->
    <controls:NavigationPane x:Name="Sections"
                             Margin="12"
                             AutomationProperties.Name="Panels">
        <controls:NavigationPane.Body>
            <!--
                The chosen page. A presenter rather than a content control: a
                panel's logical parent is its section, and a content control
                would try to adopt it a second time. Filled from the code behind.
            -->
            <ContentPresenter x:Name="WorkspaceHost" />
        </controls:NavigationPane.Body>

        <!--
            An icon for every entry, pages inside a group included, so each says
            what it is about rather than decorating it: the icon is all that
            shows once the sidebar is folded, and in the list a page that had
            none read as a row with something missing. Both overviews share the
            chart, since that is what an overview is here.
        -->
        <controls:NavigationItem x:Name="NetworkItem"
                                 Header="Network"
                                 AutomationProperties.Name="Network"
                                 controls:NavigationPane.Icon="ArrowsBidirectional" />

        <controls:NavigationItem x:Name="NetworkOverviewTab"
                                 Header="Overview"
                                 ParentName="NetworkItem"
                                 AutomationProperties.Name="Network overview"
                                 controls:NavigationPane.Icon="DataArea" />

        <controls:NavigationItem x:Name="ConnectionTab"
                                 Header="Connection"
                                 ParentName="NetworkItem"
                                 AutomationProperties.Name="Connection"
                                 controls:NavigationPane.Icon="PlugConnected" />

        <controls:NavigationItem x:Name="HistoryTab"
                                 Header="History"
                                 ParentName="NetworkItem"
                                 AutomationProperties.Name="History"
                                 controls:NavigationPane.Icon="History" />

        <controls:NavigationItem x:Name="AppsTab"
                                 Header="Apps"
                                 ParentName="NetworkItem"
                                 AutomationProperties.Name="Apps"
                                 controls:NavigationPane.Icon="DataUsage" />

        <controls:NavigationItem x:Name="ProcessorItem"
                                 Header="Processor"
                                 AutomationProperties.Name="Processor"
                                 controls:NavigationPane.Icon="DeveloperBoard" />

        <controls:NavigationItem x:Name="GraphicsTab"
                                 Header="Graphics"
                                 AutomationProperties.Name="Graphics"
                                 controls:NavigationPane.Icon="Games" />

        <controls:NavigationItem x:Name="MemoryTab"
                                 Header="Memory"
                                 AutomationProperties.Name="Memory"
                                 controls:NavigationPane.Icon="Ram" />

        <controls:NavigationItem x:Name="StorageTab"
                                 Header="Storage"
                                 AutomationProperties.Name="Storage"
                                 controls:NavigationPane.Icon="HardDrive" />

        <controls:NavigationItem x:Name="TaskbarTab"
                                 Header="Taskbar"
                                 AutomationProperties.Name="Taskbar"
                                 controls:NavigationPane.Icon="PanelBottom" />

        <controls:NavigationItem x:Name="SettingsTab"
                                 Header="Settings"
                                 AutomationProperties.Name="Settings"
                                 DockPanel.Dock="Bottom"
                                 Margin="0"
                                 controls:NavigationPane.Icon="Settings" />
    </controls:NavigationPane>

</Window>

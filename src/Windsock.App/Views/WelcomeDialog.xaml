<Window x:Class="Windsock.App.Views.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:vm="clr-namespace:Windsock.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WelcomeViewModel}"
        Title="Welcome to Windsock"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Usage.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StepHeadStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource TextSize18}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="StepBodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource TextSize13}" />
                <Setter Property="Margin" Value="0,6,0,16" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <!--
                One step is shown at a time. The others are hidden rather than
                collapsed, so they still take their room and the window is the
                height of the tallest step throughout, instead of jumping as
                the steps go by.
            -->
            <Style x:Key="StepStyle" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Hidden" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!--
        A first run that would otherwise end with the meter never seen: it is
        off until someone finds the switch. Three steps, any of them skipped,
        each taking effect as it is chosen - the meter turns up on the bar
        while this is still open. The safe way out (Skip, Escape, the close
        button) keeps whatever was chosen so far and changes nothing else.
    -->
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding StepText}"
                   FontSize="{DynamicResource TextSize11_5}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource AccentBrush}"
                   AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="1">
            <!-- 1. The meter itself. -->
            <StackPanel x:Name="MeterStep">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Your speeds on the taskbar" Style="{StaticResource StepHeadStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource StepBodyStyle}"
                           Text="Windsock's meter sits in the taskbar beside the clock and shows how fast the network is moving, second by second. It is off until you switch it on, and it goes the moment Windsock closes." />

                <Border Style="{StaticResource BandStyle}">
                    <DockPanel LastChildFill="True">
                        <ToggleButton DockPanel.Dock="Right"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"
                                      IsChecked="{Binding MeterOn, Mode=TwoWay}"
                                      AutomationProperties.Name="Show the meter on the taskbar" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Show the meter on the taskbar"
                                       FontSize="{DynamicResource TextSize13}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding MeterStatus}"
                                       Margin="0,3,0,0"
                                       FontSize="{DynamicResource TextSize12}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- 2. What it shows. -->
            <StackPanel x:Name="LayoutStep">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Choose what it shows" Style="{StaticResource StepHeadStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource StepBodyStyle}"
                           Text="Pick a layout to start from. Every place on the meter can be changed afterwards on the Taskbar page, to show anything Windsock measures." />

                <Border Style="{StaticResource BandStyle}" Padding="8">
                    <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PresetChoice}">
                                <Button Style="{StaticResource ChoiceTileStyle}"
                                        Margin="1"
                                        Tag="{Binding IsChosen}"
                                        Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Name}"
                                        AutomationProperties.HelpText="{Binding Note}"
                                        ToolTip="{Binding Note}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <fluent:SymbolIcon DockPanel.Dock="Right"
                                                               Symbol="CheckmarkCircle"
                                                               IconVariant="Filled"
                                                               FontSize="14"
                                                               Margin="8,0,0,0"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Visibility="{Binding IsChosen, Converter={StaticResource BooleanToVisibility}}" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{DynamicResource TextSize13}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Readings}"
                                                   Margin="0,3,0,0"
                                                   FontSize="{DynamicResource TextSize11_5}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- 3. Starting with Windows. -->
            <StackPanel x:Name="StartStep">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Start with Windows?" Style="{StaticResource StepHeadStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource StepBodyStyle}"
                           Text="The meter is there only while Windsock runs. Started with Windows, it opens quietly in the notification area with the meter on the taskbar, and no window." />

                <Border Style="{StaticResource BandStyle}">
                    <DockPanel LastChildFill="True">
                        <ToggleButton DockPanel.Dock="Right"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      AutomationProperties.Name="Start Windsock with Windows" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start Windsock when I sign in"
                                       FontSize="{DynamicResource TextSize13}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding StartupNote}"
                                       Margin="0,3,0,0"
                                       FontSize="{DynamicResource TextSize12}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding StartupNote, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Margin="0,14,0,0"
                           FontSize="{DynamicResource TextSize12}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Everything here can be changed later: the meter and its layout on the Taskbar page, starting with Windows in Settings." />
            </StackPanel>
        </Grid>

        <!-- Skip on the left, away from the way forward; the way forward is the one under the finger. -->
        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="Skip"
                    IsCancel="True"
                    Command="{Binding SkipCommand}"
                    AutomationProperties.Name="Skip the welcome"
                    ToolTip="Close the welcome, keeping whatever you chose so far" />

            <Button x:Name="Forward"
                    DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="88"
                    IsDefault="True"
                    Content="{Binding NextText}"
                    Command="{Binding NextCommand}"
                    AutomationProperties.Name="{Binding NextText}" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Margin="0,0,8,0"
                    Content="Back"
                    Command="{Binding BackCommand}"
                    Visibility="{Binding IsFirst, Converter={StaticResource InverseBooleanToVisibility}}"
                    AutomationProperties.Name="Back a step" />
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="Windsock.App.Views.ApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="VirusTotal key"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=Key}"
        Background="{DynamicResource SurfaceBrush}">

    <!--
        Takes the person's own VirusTotal key. It is kept protected for their
        Windows account in a file of its own, never in settings.json, and never
        shown again once saved.
    -->
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <fluent:SymbolIcon DockPanel.Dock="Left"
                               Symbol="Key"
                               FontSize="18"
                               VerticalAlignment="Top"
                               Margin="0,1,10,0"
                               Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Add your VirusTotal key"
                       FontSize="{DynamicResource TextSize15}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,12"
                   FontSize="{DynamicResource TextSize12_5}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Paste the API key from your VirusTotal account (Profile, API key): 64 letters and digits. It is kept for your Windows account on this PC only, and used only when you look a program up." />

        <PasswordBox x:Name="Key"
                     Grid.Row="2"
                     Margin="0,0,0,18"
                     AutomationProperties.Name="VirusTotal API key"
                     PasswordChanged="OnTyped" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    IsCancel="True"
                    MinWidth="96"
                    MinHeight="32"
                    AutomationProperties.Name="Cancel"
                    Click="OnCancel" />
            <Button x:Name="Save"
                    Content="Save key"
                    IsDefault="True"
                    IsEnabled="False"
                    MinWidth="110"
                    MinHeight="32"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Save the key"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>

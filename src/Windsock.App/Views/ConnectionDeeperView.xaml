<UserControl x:Class="Windsock.App.Views.ConnectionDeeperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Windsock.App.Controls"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Windsock.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionDeeperViewModel}"
             d:DesignWidth="880"
             d:DesignHeight="1100">

    <!--
        Connection › Status, below the answer and its chart: how good the
        connection is for calls and games, what kind of connection it is, the
        hop-by-hop table, and the report for the provider. Each is a band of
        its own. Whatever would reach beyond this PC has its switch beside its
        button, the same setting as on the privacy page, and names where it
        goes before it is pressed.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- The field box lives with the Usage styles; merged here as the other pages that use it do. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Usage.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FigureValueStyle" TargetType="TextBlock" BasedOn="{StaticResource StatValueStyle}">
                <Setter Property="FontSize" Value="{DynamicResource TextSize18}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="LineStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource TextSize12}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- A verdict in colour as well as in words, never colour alone. -->
            <Style x:Key="VerdictStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource TextSize24}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- ============ Calls and games ============ -->
        <Border Style="{StaticResource BandStyle}" Margin="0,22,0,0">
            <StackPanel>
                <StackPanel Style="{StaticResource BandHeadStyle}">
                    <TextBlock Text="Calls and games" Style="{StaticResource CardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{Binding GradeNote}" TextWrapping="Wrap" Style="{StaticResource CardNoteStyle}" />
                </StackPanel>

                <controls:FlowGrid Style="{StaticResource PlateStripStyle}" MinimumColumnWidth="200">
                    <Border Style="{StaticResource InsetPlateCellStyle}"
                            ToolTip="Response time, steadiness, loss and latency under load, each held to published lines for voice and video calls; the worst decides.">
                        <StackPanel>
                            <TextBlock Text="FOR CALLS" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding CallsVerdict}" AutomationProperties.Name="Verdict for calls">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource VerdictStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CallsMood}" Value="Good">
                                                <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CallsMood}" Value="Poor">
                                                <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CallsDetail}" Style="{StaticResource StatNoteStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InsetPlateCellStyle}"
                            ToolTip="Response time, loss and latency under load, held to published lines for online games; the worst decides.">
                        <StackPanel>
                            <TextBlock Text="FOR GAMES" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding GamesVerdict}" AutomationProperties.Name="Verdict for games">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource VerdictStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GamesMood}" Value="Good">
                                                <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GamesMood}" Value="Poor">
                                                <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding GamesDetail}" Style="{StaticResource StatNoteStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </controls:FlowGrid>

                <controls:FlowGrid Style="{StaticResource PlateStripStyle}" MinimumColumnWidth="140" Margin="0,2,0,0">
                    <Border Style="{StaticResource InsetPlateCellStyle}" ToolTip="The median round trip over the last hour of checks.">
                        <StackPanel>
                            <TextBlock Text="RESPONSE TIME" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding MedianValue}" Style="{StaticResource FigureValueStyle}" AutomationProperties.Name="Median response time" />
                            <TextBlock Text="{Binding MedianNote}" Style="{StaticResource StatNoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InsetPlateCellStyle}" ToolTip="The average change in response time from one check to the next. Calls stutter when this is high, even if the response time itself is low.">
                        <StackPanel>
                            <TextBlock Text="JITTER" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding JitterValue}" Style="{StaticResource FigureValueStyle}" AutomationProperties.Name="Jitter" />
                            <TextBlock Text="{Binding JitterNote}" Style="{StaticResource StatNoteStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InsetPlateCellStyle}" ToolTip="The share of checks in the last hour that got no answer, outages left out.">
                        <StackPanel>
                            <TextBlock Text="LOSS" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding LossValue}" Style="{StaticResource FigureValueStyle}" AutomationProperties.Name="Packet loss" />
                            <TextBlock Text="{Binding LossNote}" Style="{StaticResource StatNoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InsetPlateCellStyle}" ToolTip="How much longer the response time got while the latest speed test filled the line: bufferbloat.">
                        <StackPanel>
                            <TextBlock Text="UNDER LOAD" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding UnderLoadValue}" Style="{StaticResource FigureValueStyle}" AutomationProperties.Name="Extra response time under load" />
                            <TextBlock Text="{Binding UnderLoadNote}" Style="{StaticResource StatNoteStyle}" />
                        </StackPanel>
                    </Border>
                </controls:FlowGrid>

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="-2,10,0,0"
                        Background="Transparent"
                        controls:PageLink.To="speedtest"
                        AutomationProperties.Name="Open Speed test"
                        ToolTip="Measure speed and latency under load on the Speed test page">
                    <StackPanel Orientation="Horizontal">
                        <fluent:SymbolIcon Symbol="Gauge" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Speed test" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ The connection ============ -->
        <Border Style="{StaticResource BandStyle}" Margin="0,14,0,0">
            <StackPanel>
                <StackPanel Style="{StaticResource BandHeadStyle}">
                    <TextBlock Text="This connection" Style="{StaticResource CardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="What Windows and this PC's addresses say, with nothing sent. The tests below ask further only when you press them."
                               TextWrapping="Wrap" Style="{StaticResource CardNoteStyle}" />
                </StackPanel>

                <!-- Narrow enough for three across at 640 px, where 170 left one plate alone under two. -->
                <controls:FlowGrid Style="{StaticResource PlateStripStyle}" MinimumColumnWidth="140">
                    <Border Style="{StaticResource InsetPlateCellStyle}" ToolTip="Whether the internet is reached over IPv6, from Windows' own checks.">
                        <StackPanel>
                            <TextBlock Text="IPV6" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding Ipv6Value}" Style="{StaticResource FigureValueStyle}" AutomationProperties.Name="IPv6" />
                            <TextBlock Text="{Binding Ipv6Note}" Style="{StaticResource StatNoteStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InsetPlateCellStyle}" ToolTip="Whether your provider shares one public address among many customers (carrier-grade NAT), which gets in the way of games and calls that need incoming connections.">
                        <StackPanel>
                            <TextBlock Text="CARRIER-GRADE NAT" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding NatValue}" Style="{StaticResource FigureValueStyle}" AutomationProperties.Name="Carrier-grade NAT" />
                            <TextBlock Text="{Binding NatNote}" Style="{StaticResource StatNoteStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InsetPlateCellStyle}" ToolTip="The DNS servers the connection uses, and whether Windows is set to encrypt lookups to them.">
                        <StackPanel>
                            <TextBlock Text="DNS" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding DnsValue}" Style="{StaticResource FigureValueStyle}" AutomationProperties.Name="DNS servers" />
                            <TextBlock Text="{Binding DnsNote}" Style="{StaticResource StatNoteStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </controls:FlowGrid>

                <!-- Public address -->
                <Border Style="{StaticResource BandRowStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <controls:AdaptiveRow Style="{StaticResource SettingLayoutStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <controls:SettingHead HorizontalAlignment="Left"
                                                      Text="Public address"
                                                      Hint="The address the internet sees this PC as - the VPN's exit when a VPN is on. One request to the service you pick, only when you press Look up. Who runs the network behind it is looked up in a table inside Windsock." />
                                <TextBlock Text="{Binding PublicDestination}" Style="{StaticResource DetailNoteStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Content="Allow looking it up"
                                      IsChecked="{Binding AllowPublicAddress, Mode=TwoWay}"
                                      AutomationProperties.Name="Allow looking up the public address" />
                        </controls:AdaptiveRow>

                        <controls:FlowRow Spacing="8" LineSpacing="8" Margin="0,10,0,0">
                            <controls:Picker Style="{StaticResource PickerStyle}"
                                             MinWidth="200"
                                             ItemsSource="{Binding PublicServices}"
                                             ItemTemplate="{StaticResource OptionLabelTemplate}"
                                             SelectedValuePath="Service"
                                             SelectedValue="{Binding PublicService, Mode=TwoWay}"
                                             AutomationProperties.Name="Public address service" />
                            <TextBox x:Name="PublicCustomBox"
                                     Style="{StaticResource FieldBoxStyle}"
                                     MinWidth="240"
                                     Text="{Binding PublicCustomUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsCustomPublicService, Converter={StaticResource BooleanToVisibility}}"
                                     AutomationProperties.Name="Public address service address"
                                     ToolTip="An https:// address that answers with your address as plain text">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyPublicCustomCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding LookUpCommand}"
                                    IsEnabled="{Binding AllowPublicAddress}"
                                    AutomationProperties.Name="Look up the public address">
                                <StackPanel Orientation="Horizontal">
                                    <fluent:SymbolIcon Symbol="Globe" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Look up" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </controls:FlowRow>

                        <TextBox Text="{Binding PublicResult, Mode=OneWay}"
                                 Style="{StaticResource SelectableTextStyle}"
                                 FontSize="{DynamicResource TextSize15}"
                                 FontWeight="SemiBold"
                                 Margin="0,8,0,0"
                                 Visibility="{Binding PublicResult, Converter={StaticResource TextToVisibility}}"
                                 AutomationProperties.Name="Public address"
                                 AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding PublicNetwork}" Style="{StaticResource LineStyle}" Margin="0,2,0,0"
                                   Visibility="{Binding PublicNetwork, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- NAT type -->
                <Border Style="{StaticResource BandRowStyle}">
                    <StackPanel>
                        <controls:AdaptiveRow Style="{StaticResource SettingLayoutStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <controls:SettingHead HorizontalAlignment="Left"
                                                      Text="NAT type"
                                                      Hint="How your router and provider translate addresses, which decides whether games and calls can take incoming connections. The test asks your router first; asking a STUN server as well tells the NAT's type." />
                                <TextBlock Text="{Binding NatDestination}" Style="{StaticResource DetailNoteStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Content="Also ask a STUN server"
                                      IsChecked="{Binding AllowStun, Mode=TwoWay}"
                                      AutomationProperties.Name="Allow asking a STUN server" />
                        </controls:AdaptiveRow>

                        <controls:FlowRow Spacing="8" LineSpacing="8" Margin="0,10,0,0">
                            <controls:Picker Style="{StaticResource PickerStyle}"
                                             MinWidth="220"
                                             ItemsSource="{Binding StunServers}"
                                             ItemTemplate="{StaticResource OptionLabelTemplate}"
                                             SelectedValuePath="Server"
                                             SelectedValue="{Binding StunServer, Mode=TwoWay}"
                                             IsEnabled="{Binding AllowStun}"
                                             AutomationProperties.Name="STUN server" />
                            <TextBox x:Name="StunCustomBox"
                                     Style="{StaticResource FieldBoxStyle}"
                                     MinWidth="200"
                                     Text="{Binding StunCustom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsCustomStun, Converter={StaticResource BooleanToVisibility}}"
                                     AutomationProperties.Name="STUN server address"
                                     ToolTip="host or host:port">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyStunCustomCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding TestNatCommand}"
                                    AutomationProperties.Name="Test the NAT">
                                <StackPanel Orientation="Horizontal">
                                    <fluent:SymbolIcon Symbol="Router" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Test" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </controls:FlowRow>

                        <TextBlock Text="{Binding NatResult}" Style="{StaticResource LineStyle}" Margin="0,8,0,0"
                                   Visibility="{Binding NatResult, Converter={StaticResource TextToVisibility}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- DNS response time -->
                <Border Style="{StaticResource BandRowStyle}">
                    <StackPanel>
                        <controls:AdaptiveRow Style="{StaticResource SettingLayoutStyle}">
                            <controls:SettingHead HorizontalAlignment="Left"
                                                  Text="DNS response time"
                                                  Hint="Times the DNS servers this PC uses with a few queries for the root of the DNS, which names no website, sent past Windows' own cache. A router's DNS forwards to your provider, so it is slower than a ping to the router; the difference is that trip." />
                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Content="Allow timing"
                                      IsChecked="{Binding AllowDnsTiming, Mode=TwoWay}"
                                      AutomationProperties.Name="Allow timing the DNS servers" />
                        </controls:AdaptiveRow>

                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Command="{Binding TimeDnsCommand}"
                                IsEnabled="{Binding AllowDnsTiming}"
                                AutomationProperties.Name="Time the DNS servers">
                            <StackPanel Orientation="Horizontal">
                                <fluent:SymbolIcon Symbol="Timer" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Time them" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{Binding DnsTimings}" Focusable="False" Margin="0,8,0,0" AutomationProperties.Name="DNS timings">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource LineStyle}" Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============ Hop by hop (full edition) ============ -->
        <Border x:Name="HopBand" Style="{StaticResource BandStyle}" Margin="0,14,0,0">
            <StackPanel>
                <controls:AdaptiveRow Breakpoint="560" Spacing="10" LeadFills="True" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Hop by hop" Style="{StaticResource CardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{Binding HopTarget}" TextWrapping="Wrap" Style="{StaticResource CardNoteStyle}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Content="Route tracing"
                              IsChecked="{Binding TraceRoutes, Mode=TwoWay}"
                              AutomationProperties.Name="Route tracing"
                              ToolTip="The same switch as on the map and the privacy page: lets Windsock send probes to the routers along the way" />
                </controls:AdaptiveRow>

                <controls:FlowRow Spacing="8" LineSpacing="8">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding StartHopsCommand}"
                            AutomationProperties.Name="Start the hop-by-hop table">
                        <StackPanel Orientation="Horizontal">
                            <fluent:SymbolIcon Symbol="Play" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Start" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding StopHopsCommand}"
                            AutomationProperties.Name="Stop the hop-by-hop table">
                        <StackPanel Orientation="Horizontal">
                            <fluent:SymbolIcon Symbol="Stop" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </controls:FlowRow>

                <TextBlock Text="{Binding HopHeadline}" Style="{StaticResource LineStyle}" Margin="0,10,0,6"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Visibility="{Binding HopHeadline, Converter={StaticResource TextToVisibility}}"
                           AutomationProperties.LiveSetting="Polite" />

                <ItemsControl ItemsSource="{Binding Hops}" Focusable="False" AutomationProperties.Name="Hops"
                              Visibility="{Binding HasHops, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HopRowView}">
                            <Border Style="{StaticResource TileStyle}" Padding="12,7">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="26" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Loss}" Margin="12,0,0,0" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular" ToolTip="Probes lost at this hop">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LossCarriesOn}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock FontSize="{DynamicResource TextSize12_5}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <Run Text="{Binding Address, Mode=OneWay}" />
                                            <Run Text="{Binding Network, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LineStyle}" Margin="0,1,0,0">
                                            <Run Text="Sent" /><Run Text=" " /><Run Text="{Binding Sent, Mode=OneWay}" />
                                            <Run Text="· last" /><Run Text=" " /><Run Text="{Binding Last, Mode=OneWay}" />
                                            <Run Text="· avg" /><Run Text=" " /><Run Text="{Binding Average, Mode=OneWay}" />
                                            <Run Text="· best" /><Run Text=" " /><Run Text="{Binding Best, Mode=OneWay}" />
                                            <Run Text="· worst" /><Run Text=" " /><Run Text="{Binding Worst, Mode=OneWay}" />
                                            <Run Text="ms" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============ Report for your ISP ============ -->
        <Border Style="{StaticResource BandStyle}" Margin="0,14,0,0">
            <StackPanel>
                <StackPanel Style="{StaticResource BandHeadStyle}">
                    <TextBlock Text="Report for your provider" Style="{StaticResource CardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="A dated page of outages, response time, jitter, loss and speed tests over a period, to attach to a complaint. Saved as one web page where you choose; nothing is sent."
                               TextWrapping="Wrap" Style="{StaticResource CardNoteStyle}" />
                </StackPanel>

                <controls:FlowRow Spacing="10" LineSpacing="8">
                    <controls:Picker Style="{StaticResource PickerStyle}"
                                     MinWidth="150"
                                     ItemsSource="{Binding ReportRanges}"
                                     ItemTemplate="{StaticResource OptionLabelTemplate}"
                                     SelectedValuePath="Days"
                                     SelectedValue="{Binding SelectedReportRange, Mode=TwoWay}"
                                     AutomationProperties.Name="Report period" />
                    <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                              VerticalAlignment="Center"
                              Content="Include network and provider names"
                              IsChecked="{Binding IncludeNames, Mode=TwoWay}"
                              AutomationProperties.Name="Include network and provider names in the report" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SaveReportCommand}"
                            AutomationProperties.Name="Save a report for your provider">
                        <StackPanel Orientation="Horizontal">
                            <fluent:SymbolIcon Symbol="DocumentArrowDown" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Save report…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenReportCommand}"
                            Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibility}}"
                            AutomationProperties.Name="Open the saved report">
                        <StackPanel Orientation="Horizontal">
                            <fluent:SymbolIcon Symbol="Open" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Open it" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </controls:FlowRow>

                <TextBlock Text="{Binding ReportNotice}" Style="{StaticResource LineStyle}" Margin="0,8,0,0"
                           Visibility="{Binding ReportNotice, Converter={StaticResource TextToVisibility}}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

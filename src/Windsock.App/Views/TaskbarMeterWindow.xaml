<Window x:Class="Windsock.App.Views.TaskbarMeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Windsock.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TaskbarMeterViewModel}"
        Title="Windsock meter"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Manual"
        Width="118"
        Height="40"
        Left="-32000"
        Top="-32000"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        AutomationProperties.HelpText="Point at it for the last minute, today's totals and the busiest apps. Right-click for more.">

    <!--
        The meter that sits in the Windows taskbar.

        Transparent, and painting nothing of its own. The taskbar behind it is
        acrylic over the wallpaper, so there is no colour this could be filled
        with that would match it; the only way to look like part of the bar is
        to draw the figures and nothing else.

        Text is rendered in greyscale rather than ClearType on purpose. ClearType
        tunes subpixels against a known background, and this window has none -
        left on, the figures pick up coloured fringes wherever the wallpaper
        underneath happens to be bright.

        Placement, size and the parenting into Explorer's window are not here.
        They belong to the service that owns this window, because they have to
        be redone as the taskbar changes and this has no way of knowing that.
    -->
    <!--
        The hover card is given in code by whoever owns the window, with its
        placement for the bar's edge; until then the readings' text stands in.
        A screen reader meets the window, named by its title, and each reading
        inside it; the grid has no automation peer, so its name went to the
        window. The meter is pressed with the mouse only, on purpose: its menu
        is also the tray icon's, and its actions have keyboard shortcuts.
    -->
    <Grid x:Name="Root"
          Background="Transparent"
          ToolTip="{Binding Tooltip}"
          ToolTipService.InitialShowDelay="450"
          ToolTipService.ShowDuration="2147483647">
        <!--
            A ground of the reader's own, under everything else and transparent
            unless one was asked for. Rounded to the same radius as the hover
            wash above it, so a filled meter reads as one of the taskbar's own
            buttons rather than as a rectangle laid over the bar.
        -->
        <Border CornerRadius="{Binding Corner}" Background="{Binding Ground}" />

        <!--
            The taskbar lights its own buttons under the pointer, so the meter
            does too. Without it the figures read as something painted on the
            bar rather than something that answers a click.

            Only where a click actually does something, though. Set to do
            nothing, the meter is a readout rather than a button, and lighting
            it under the pointer would promise a press that goes nowhere. Both
            conditions have to hold, so the trigger is a multi one.
        -->
        <Border CornerRadius="{Binding Corner}" Background="{Binding Hover}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Value="True" />
                                <Condition Binding="{Binding LightsOnHover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!--
            The soft outline, when one was asked for, is an effect on the
            readings alone: on the whole grid it would blur the hover wash and
            the painted ground as well.
        -->
        <ContentControl x:Name="Readings"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource MeterTemplate}"
                        Effect="{Binding Glow}"
                        Margin="{Binding Inset}"
                        Focusable="False" />
    </Grid>
</Window>

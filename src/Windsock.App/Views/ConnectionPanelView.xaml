<UserControl x:Class="Windsock.App.Views.ConnectionPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Windsock.App.Controls"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Windsock.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionPanelViewModel}"
             d:DesignWidth="880"
             d:DesignHeight="900">

    <!--
        Connection › Status. Read top down, the page answers in the order people
        ask: is the internet there, what was asked to decide that, how well it has
        been answering, and how all that is decided. The answer, its figures and
        the last hour lead on the page itself; the checks are a subject of their
        own, on a band. The outage log is the Outages page beside this one, and
        the alert switches are on the Alerts page.
    -->
    <UserControl.Resources>
        <Style x:Key="FigureValueStyle" TargetType="TextBlock" BasedOn="{StaticResource StatValueStyle}">
            <Setter Property="FontSize" Value="{DynamicResource TextSize18}" />
        </Style>

        <!-- The state in colour as well as words, but never in colour alone. -->
        <Style x:Key="MoodBrushStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mood}" Value="Good">
                    <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mood}" Value="Bad">
                    <Setter Property="Fill" Value="{DynamicResource HotBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <controls:SectionPage Title="Connection" Subtitle="{Binding Circumstance}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource PagePadding}">
            <StackPanel>
                <!-- ============ The answer ============ -->
                <DockPanel LastChildFill="True" Margin="4,0,4,0">
                    <!-- A dot in a ring of its own colour, so the state reads from across the room. -->
                    <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource MoodBrushStyle}" Opacity="0.18" />
                        <Ellipse Style="{StaticResource MoodBrushStyle}" Width="14" Height="14" />
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Headline}"
                                   FontSize="{DynamicResource TextSize20}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Text="{Binding Explanation}"
                                   Margin="0,3,0,0"
                                   FontSize="{DynamicResource TextSize13}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>

                <!--
                    The evidence behind the answer, on plates. Each figure is one
                    thing that was asked and what it said, so a person who wants
                    to know why the headline says what it says can see it.
                -->
                <controls:FlowGrid Style="{StaticResource PlateStripStyle}"
                                   MinimumColumnWidth="136"
                                   Margin="0,18,0,0">
                    <Border Style="{StaticResource PlateCellStyle}"
                            ToolTip="How long your router took to answer a ping. Your router is the box that connects this PC to the internet.">
                        <StackPanel>
                            <TextBlock Text="ROUTER" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding RouterValue}" AutomationProperties.Name="Router">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FigureValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RouterSilent}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding RouterDetail}" Style="{StaticResource StatNoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PlateCellStyle}"
                            ToolTip="How long the internet address you chose took to answer. Choose one under Checks, below.">
                        <StackPanel>
                            <TextBlock Text="INTERNET" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding InternetValue}" AutomationProperties.Name="Internet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FigureValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InternetSilent}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource HotBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding InternetDetail}" Style="{StaticResource StatNoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PlateCellStyle}"
                            ToolTip="What Windows itself thinks - the same verdict as the network icon on the taskbar.">
                        <StackPanel>
                            <TextBlock Text="WINDOWS SAYS" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding WindowsValue}"
                                       Style="{StaticResource FigureValueStyle}"
                                       AutomationProperties.Name="Windows says" />
                            <TextBlock Text="{Binding WindowsDetail}" Style="{StaticResource StatNoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PlateCellStyle}"
                            ToolTip="The network this PC is using, and whether a VPN is on.">
                        <StackPanel>
                            <TextBlock Text="NETWORK" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding NetworkValue}"
                                       Style="{StaticResource FigureValueStyle}"
                                       AutomationProperties.Name="Network" />
                            <TextBlock Text="{Binding NetworkDetail}" Style="{StaticResource StatNoteStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PlateCellStyle}"
                            ToolTip="The share of pings in the last hour that got no answer. A few now and then is normal on Wi-Fi.">
                        <StackPanel>
                            <TextBlock Text="LOST" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock Text="{Binding LossValue}"
                                       Style="{StaticResource FigureValueStyle}"
                                       AutomationProperties.Name="Lost pings" />
                            <TextBlock Text="{Binding LossDetail}" Style="{StaticResource StatNoteStyle}" />
                        </StackPanel>
                    </Border>
                </controls:FlowGrid>

                <!-- ============ The last hour, on the page ============ -->
                <StackPanel Margin="4,22,4,0">
                    <controls:AdaptiveRow Breakpoint="520" Spacing="10" LeadFills="True" LeadMinimumWidth="220">
                        <DockPanel LastChildFill="True" MinHeight="34">
                            <Ellipse DockPanel.Dock="Left"
                                     Width="8"
                                     Height="8"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource RouterBrush}" />

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Response time" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="The last hour. Lower is better; gaps are checks nobody answered, or times nobody was watching."
                                           Style="{StaticResource CardNoteStyle}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- The legend, beside the name while there is room and under it when not. -->
                        <controls:FlowRow Spacing="14" LineSpacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center"
                                           Fill="{DynamicResource RouterBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Router" FontSize="{DynamicResource TextSize12}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasInternetLine, Converter={StaticResource BooleanToVisibility}}">
                                <Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center"
                                           Fill="{DynamicResource DownloadBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Internet" FontSize="{DynamicResource TextSize12}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Opacity="0.35"
                                           Fill="{DynamicResource HotBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Outage or no answer" FontSize="{DynamicResource TextSize12}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </controls:FlowRow>
                    </controls:AdaptiveRow>

                    <Border Style="{StaticResource ChartWellStyle}" Height="220" Margin="0,10,0,0">
                        <controls:LatencyChart x:Name="Chart"
                                               Points="{Binding Points}"
                                               Revision="{Binding Revision}"
                                               WindowEnd="{Binding ChartEnd}"
                                               Span="{Binding ChartSpanValue, Mode=OneTime}"
                                               RouterBrush="{DynamicResource RouterBrush}"
                                               InternetBrush="{DynamicResource DownloadBrush}"
                                               OutageBrush="{DynamicResource HotBrush}"
                                               GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                               AxisBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                               EmptyText="The first checks appear here within a few seconds. Nothing is drawn while no Connection page is open and background watching is off."
                                               AutomationProperties.Name="Response time over the last hour" />
                    </Border>
                </StackPanel>

                <!--
                    Calls and games, this connection, hop by hop and the report
                    for the provider: ConnectionDeeperView, handed in by the
                    constructor.
                -->
                <ContentPresenter x:Name="DeeperHost" />

                <!--
                    ============ How it is decided ============

                    Each option is its name beside its control while there is
                    room, and the control under the name when there is not, so a
                    narrow window never cuts a sentence off to make room for a
                    tick box.
                -->
                <Border Style="{StaticResource BandStyle}" Margin="0,22,0,0">
                    <StackPanel>
                        <StackPanel Style="{StaticResource BandHeadStyle}">
                            <TextBlock Text="Checks" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="How Windsock decides the internet is gone. What it tells you when it is, is on the Alerts page."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CardNoteStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource BandRowStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <controls:AdaptiveRow Style="{StaticResource SettingLayoutStyle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <controls:SettingHead
                                            HorizontalAlignment="Left"
                                            Text="How to check the internet"
                                            Hint="Windows' own check is right for most people. Pinging an address as well catches an outage sooner and more surely, and is how a flaky connection shows up on the chart. Pinging a public address is listed with everything else that leaves this PC under Settings, Data and privacy." />
                                        <TextBlock Text="{Binding CheckNote}"
                                                   Style="{StaticResource DetailNoteStyle}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <controls:Picker Style="{StaticResource PickerStyle}"
                                                     MinWidth="220"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     ItemsSource="{Binding Checks}"
                                                     ItemTemplate="{StaticResource OptionLabelTemplate}"
                                                     SelectedValuePath="Check"
                                                     SelectedValue="{Binding SelectedCheck, Mode=TwoWay}"
                                                     AutomationProperties.Name="How to check the internet" />
                                </controls:AdaptiveRow>

                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibility}}">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Margin="8,0,0,0"
                                                Content="Use this address"
                                                Command="{Binding ApplyCustomTargetCommand}" />
                                        <TextBox x:Name="CustomTargetBox"
                                                 Text="{Binding CustomTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="30"
                                                 VerticalContentAlignment="Center"
                                                 MaxLength="253"
                                                 AutomationProperties.Name="Address to ping"
                                                 ToolTip="An IP address such as 1.1.1.1, or a name such as example.com">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ApplyCustomTargetCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>

                                    <TextBlock Text="{Binding CustomProblem}"
                                               Margin="0,6,0,0"
                                               FontSize="{DynamicResource TextSize12}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource HotBrush}"
                                               Visibility="{Binding CustomProblem, Converter={StaticResource TextToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BandRowStyle}">
                            <controls:AdaptiveRow Style="{StaticResource SettingLayoutStyle}">
                                <controls:SettingHead
                                    HorizontalAlignment="Left"
                                    Text="Keep watching with these pages closed"
                                    Hint="Needed for the connection alerts on the Alerts page, for outages to be logged while you are doing something else, and for the taskbar meter to show a dash while the internet is gone. Turned off, Windsock checks only while a Connection page is on screen." />

                                <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="Watch in the background"
                                          IsChecked="{Binding WatchInBackground, Mode=TwoWay}"
                                          AutomationProperties.Name="Watch the connection in the background" />
                            </controls:AdaptiveRow>
                        </Border>

                        <!-- For whoever wants them; the defaults suit nearly everyone. -->
                        <Border Style="{StaticResource BandRowStyle}" Visibility="{Binding ShowsMore, Converter={StaticResource BooleanToVisibility}}">
                            <controls:AdaptiveRow Style="{StaticResource SettingLayoutStyle}">
                                <controls:SettingHead
                                    HorizontalAlignment="Left"
                                    Text="How often to check"
                                    Hint="More often notices a drop sooner and draws a finer chart. Each check is a few tiny packets, so even every 2 seconds costs nothing you would notice." />

                                <controls:Picker Style="{StaticResource PickerStyle}"
                                                 MinWidth="170"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 ItemsSource="{Binding Intervals}"
                                                 ItemTemplate="{StaticResource OptionLabelTemplate}"
                                                 SelectedValuePath="Seconds"
                                                 SelectedValue="{Binding SelectedInterval, Mode=TwoWay}"
                                                 AutomationProperties.Name="How often to check" />
                            </controls:AdaptiveRow>
                        </Border>

                        <Border Style="{StaticResource BandRowStyle}" Visibility="{Binding ShowsMore, Converter={StaticResource BooleanToVisibility}}">
                            <controls:AdaptiveRow Style="{StaticResource SettingLayoutStyle}">
                                <controls:SettingHead
                                    HorizontalAlignment="Left"
                                    Text="When to call it an outage"
                                    Hint="How long the internet has to be gone before it counts. Shorter catches every blip; longer ignores the few seconds Wi-Fi sometimes takes to recover, so you are only told about drops that matter. The outage is still timed from the moment it began." />

                                <controls:Picker Style="{StaticResource PickerStyle}"
                                                 MinWidth="170"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 ItemsSource="{Binding Delays}"
                                                 ItemTemplate="{StaticResource OptionLabelTemplate}"
                                                 SelectedValuePath="Seconds"
                                                 SelectedValue="{Binding SelectedDelay, Mode=TwoWay}"
                                                 AutomationProperties.Name="When to call it an outage" />
                            </controls:AdaptiveRow>
                        </Border>

                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="-6,6,0,0"
                                Background="Transparent"
                                Command="{Binding ToggleMoreCommand}"
                                AutomationProperties.Name="More options">
                            <StackPanel Orientation="Horizontal">
                                <fluent:SymbolIcon FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <fluent:SymbolIcon.Style>
                                        <Style TargetType="fluent:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowsMore}" Value="True">
                                                    <Setter Property="Symbol" Value="ChevronUp" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </fluent:SymbolIcon.Style>
                                </fluent:SymbolIcon>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="More options" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowsMore}" Value="True">
                                                    <Setter Property="Text" Value="Fewer options" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </controls:SectionPage>
</UserControl>

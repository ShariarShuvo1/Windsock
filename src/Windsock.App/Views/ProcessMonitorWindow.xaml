<Window x:Class="Windsock.App.Views.ProcessMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Windsock.App.Controls"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:vm="clr-namespace:Windsock.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProcessMonitorViewModel}"
        Title="{Binding Title}"
        Width="1040"
        Height="740"
        MinWidth="620"
        MinHeight="560"
        Background="{DynamicResource SurfaceBrush}"
        Cursor="Arrow"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!--
            The popover shows whichever kind of node the pointer is over. Chosen
            by type rather than by a flag, so the graph can hand it a peer, a
            hop or a note of its own without knowing which template will run.
        -->
        <DataTemplate DataType="{x:Type vm:PeerNodeViewModel}">
            <StackPanel MaxWidth="330">
                <TextBlock Text="{Binding Label}"
                           FontSize="{DynamicResource TextSize13}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <!--
                    Only when there are rates to state. Without them RateText
                    falls back to the socket count, which the line below
                    already says.
                -->
                <TextBlock Text="{Binding RateText}"
                           FontSize="{DynamicResource TextSize12}"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRates}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Sockets}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding States}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Ports}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Addresses}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Totals}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Where}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Distance}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Latency}" />
                <TextBlock Style="{StaticResource PopoverNoteStyle}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HopNodeViewModel}">
            <StackPanel MaxWidth="330">
                <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionTextStyle}" />

                <TextBlock Text="{Binding Label}"
                           FontSize="{DynamicResource TextSize13}"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding AddressLine}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Where}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Latency}" />
                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Carries}" />
                <TextBlock Style="{StaticResource PopoverNoteStyle}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:GraphNote}">
            <StackPanel MaxWidth="330">
                <TextBlock Text="{Binding Title}"
                           FontSize="{DynamicResource TextSize13}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <TextBlock Style="{StaticResource PopoverLineStyle}" Text="{Binding Body}" />
                <TextBlock Style="{StaticResource PopoverNoteStyle}" Text="{Binding Detail}" />
            </StackPanel>
        </DataTemplate>

        <!--
            Who the app is and what can be done about it: who signed it, which
            program started it, the services it runs, whether the firewall
            blocks it. Its actions are a row of the window's own, below.
        -->
        <DataTemplate DataType="{x:Type vm:AppFactsViewModel}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <fluent:SymbolIcon Symbol="Warning"
                                       FontSize="12"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource HotBrush}"
                                       AutomationProperties.Name="Not signed, or the signature does not hold"
                                       Visibility="{Binding IsFlagged, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="{Binding Publisher}"
                               FontSize="{DynamicResource TextSize11_5}"
                               TextWrapping="Wrap"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Text="{Binding StartedBy}"
                           Margin="0,2,0,0"
                           FontSize="{DynamicResource TextSize11_5}"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding StartedBy, Converter={StaticResource TextToVisibility}}" />

                <TextBlock Text="{Binding Services}"
                           Margin="0,2,0,0"
                           FontSize="{DynamicResource TextSize11_5}"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding Services, Converter={StaticResource TextToVisibility}}" />

                <TextBlock Text="{Binding Firewall}"
                           Margin="0,2,0,0"
                           FontSize="{DynamicResource TextSize11_5}"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource HotBrush}"
                           Visibility="{Binding Firewall, Converter={StaticResource TextToVisibility}}" />

            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!--
        One window per process, independent of the main one and of each other,
        so several can be opened and compared side by side.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!--
                Collapsing the card has to give its height back, or the table
                would stay pinned under a gap the size of the graph that is no
                longer there. The handle between them is what makes the split
                the reader's to choose rather than the window's.

                Sized from the code behind rather than by a trigger on the state:
                dragging the handle writes a height straight onto these rows, and
                a value written straight on beats anything a style has to say
                afterwards. The collapse would then be ignored by the very rows
                that had been resized.
            -->
            <RowDefinition x:Name="GraphRow" Height="*" MinHeight="330" />

            <RowDefinition Height="Auto" />

            <RowDefinition x:Name="TableRow" Height="1.6*" MinHeight="150" />
        </Grid.RowDefinitions>

        <!--
            One card: who this is, what it is moving, and who it is moving it
            to. They were two, and two cards describing the same process is one
            border more than the thing needs.
        -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <!--
                        Docked outside the wrapping row on purpose: when the
                        readouts drop to a second line this stays on the first,
                        where a section control belongs.
                    -->
                    <ToggleButton DockPanel.Dock="Right"
                                  VerticalAlignment="Top"
                                  Margin="18,0,0,0"
                                  Style="{StaticResource SectionCollapseStyle}"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="Collapse section"
                                  ToolTip="Collapse or expand the graph" />

                    <!--
                        The rates first, then who they belong to. It reads the
                        way the overview does - the figures on the left, where
                        the eye lands - and the identity beside them takes what
                        room is left, which is what a path of any length needs.

                        The figures are given a width rather than taking their
                        own. Left to measure themselves they would be a little
                        wider at "1.03 KB/s" than at "0 B/s", and the name and
                        path beside them would step sideways every time a rate
                        changed shape.
                    -->
                    <controls:AdaptiveRow Breakpoint="600" Spacing="28" LeadWidth="290">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,26,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                    <fluent:SymbolIcon Symbol="ArrowDownload"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource DownloadBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                    <TextBlock Text="RECEIVING"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Height="38">
                                    <TextBox Text="{Binding ReceiveValue, Mode=OneWay}"
                                             Style="{StaticResource ReadoutTextStyle}"
                                             FontSize="{Binding ReceiveFontSize}"
                                             AutomationProperties.Name="Receive rate"
                                             VerticalAlignment="Bottom" />
                                    <TextBox Text="{Binding ReceiveUnit, Mode=OneWay}"
                                             Style="{StaticResource ReadoutUnitTextStyle}"
                                             AutomationProperties.Name="Receive rate unit"
                                             VerticalAlignment="Bottom" />
                                </StackPanel>

                                <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource TextSize11}">
                                    <Run Text="total " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Run Text="{Binding ReceivedTotal, Mode=OneWay}"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                    <fluent:SymbolIcon Symbol="ArrowUpload"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource UploadBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                    <TextBlock Text="SENDING"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Height="38">
                                    <TextBox Text="{Binding SendValue, Mode=OneWay}"
                                             Style="{StaticResource ReadoutTextStyle}"
                                             FontSize="{Binding SendFontSize}"
                                             AutomationProperties.Name="Send rate"
                                             VerticalAlignment="Bottom" />
                                    <TextBox Text="{Binding SendUnit, Mode=OneWay}"
                                             Style="{StaticResource ReadoutUnitTextStyle}"
                                             AutomationProperties.Name="Send rate unit"
                                             VerticalAlignment="Bottom" />
                                </StackPanel>

                                <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource TextSize11}">
                                    <Run Text="total " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Run Text="{Binding SentTotal, Mode=OneWay}"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <!-- Stacked: sits under the figures, so align with them. -->
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <!-- In a row it takes the far end, so the
                                             spare width falls between the two
                                             halves rather than trailing off the
                                             right of the card. -->
                                        <DataTrigger Binding="{Binding IsRow, RelativeSource={RelativeSource AncestorType=controls:AdaptiveRow}}"
                                                     Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding Name}"
                                       FontSize="{DynamicResource TextSize17}"
                                       HorizontalAlignment="Right"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Text="{Binding Description}"
                                       FontSize="{DynamicResource TextSize12}"
                                       HorizontalAlignment="Right"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Margin="0,8,0,0"
                                       FontSize="{DynamicResource TextSize11_5}"
                                       HorizontalAlignment="Right"
                                       TextWrapping="Wrap">
                                <Run Text="{Binding IdentityLabel, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Run Text="{Binding IdentityValue, Mode=OneWay}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Run Text="   started " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Run Text="{Binding Started, Mode=OneWay}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>

                            <Button Style="{StaticResource PathLinkStyle}"
                                    Content="{Binding FilePath}"
                                    FontSize="{DynamicResource TextSize11}"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding RevealCommand}"
                                    IsEnabled="{Binding CanReveal}"
                                    ToolTip="Show this program in Explorer"
                                    AutomationProperties.Name="Show this program in Explorer" />

                            <ContentControl x:Name="FactsHost"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Right"
                                            Focusable="False"
                                            IsTabStop="False" />

                            <!--
                                The facts' actions, each asking first. Out of the
                                facts' template so the Store edition can take Block
                                away before anything binds (it is built without the
                                firewall); the code-behind gives them the facts.
                            -->
                            <controls:FlowRow x:Name="FactActions" Margin="0,8,0,0" HorizontalAlignment="Right" Spacing="6" LineSpacing="6">
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding CheckReputationCommand}"
                                        AutomationProperties.Name="Look up on VirusTotal"
                                        ToolTip="Send this program's hash, and nothing else, to VirusTotal with your own key. You are asked first.">
                                    <StackPanel Orientation="Horizontal">
                                        <fluent:SymbolIcon Symbol="ShieldQuestion" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="VirusTotal" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BlockButton"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding ToggleBlockCommand}"
                                        AutomationProperties.Name="Block or unblock in Windows Firewall"
                                        ToolTip="Block this program from the network with a Windows Firewall rule, or remove Windsock's block. Needs administrator rights; you are asked first.">
                                    <StackPanel Orientation="Horizontal">
                                        <fluent:SymbolIcon Symbol="ShieldProhibited" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Block…" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding EndCommand}"
                                        AutomationProperties.Name="End this app"
                                        ToolTip="Stop every process of this app at once. You are asked first; anything unsaved in it is lost.">
                                    <StackPanel Orientation="Horizontal">
                                        <fluent:SymbolIcon Symbol="DismissCircle" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="End…" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </controls:FlowRow>
                        </StackPanel>
                    </controls:AdaptiveRow>
                </DockPanel>

                <!-- Who it is talking to, and the traffic moving as it happens. -->
                <controls:DetachHost x:Name="GraphHost"
                                     Grid.Row="1"
                                     CanDetach="{Binding CanDetachGraph}"
                                     WindowTitle="Traffic graph"
                                     Note="The graph is open in a window of its own."
                                     Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}">
                    <!--
                        The gap above the graph belongs to the host rather than
                        to what it holds. The button that lifts the graph out
                        floats in the host's own top right corner, so any gap
                        between the two leaves it hanging in the space above the
                        picture instead of sitting on it.
                    -->
                    <controls:DetachHost.Style>
                        <Style TargetType="controls:DetachHost"
                               BasedOn="{StaticResource {x:Type controls:DetachHost}}">
                            <Setter Property="Margin" Value="0,12,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                    <Setter Property="Margin" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:DetachHost.Style>

                    <Grid x:Name="GraphBox">

                        <!--
                            One cell, not two. The subject line and the buttons that
                            went with it now float inside the picture instead of
                            standing in a strip above it, and that strip of height
                            goes to the graph.

                            The well has a ground of its own, a step below the card:
                            the graph is a thing to look into rather than more of the
                            card it sits in, and its edge is where panning ends.
                        -->
                        <Border Background="{DynamicResource CanvasGroundBrush}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True" />

                        <!-- A Tab stop of its own: the arrow keys move the graph, plus and minus zoom, 0 fits it. -->
                        <controls:PanZoomHost x:Name="Viewport"
                                              Radius="8"
                                              Inset="0,0,0,36"
                                              AutomationProperties.Name="Graph view">
                        <controls:NetworkGraphView x:Name="Graph"
                                                   Tree="{Binding Graph}"
                                                   Caption="{Binding Name}"
                                                   Subtitle="{Binding SocketSummary}"
                                                   Hint="{Binding GraphHint}"
                                                   Icon="{Binding Icon}"
                                                   IsLive="{Binding IsLive}"
                                                   ShowSignals="{Binding ShowSignals}"
                                                   ShowLabels="{Binding ShowLabels}"
                                                   ShowAllLabels="{Binding ShowAllLabels}"
                                                   ShowHeat="{Binding ShowHeat}"
                                                   LandBusyBrush="{DynamicResource MapBusyBrush}"
                                                   EmptyMessage="Not talking to anything right now"
                                                   PeerStyle="{StaticResource GraphPeerNodeStyle}"
                                                   HopStyle="{StaticResource GraphHopNodeStyle}"
                                                   NodeStyle="{StaticResource GraphHubNodeStyle}"
                                                   PopoverStyle="{StaticResource GraphPopoverStyle}"
                                                   PeerTemplate="{StaticResource GraphPeerNodeTemplate}"
                                                   HopTemplate="{StaticResource GraphHopNodeTemplate}"
                                                   NoteTemplate="{StaticResource GraphNoteNodeTemplate}"
                                                   IsWorld="{Binding IsWorld}"
                                                   World="{Binding World}"
                                                   Home="{Binding Home}"
                                                   CountryNotes="{Binding CountryNotes}"
                                                   WorldPeerStyle="{StaticResource GraphWorldPeerStyle}"
                                                   WorldHopStyle="{StaticResource GraphWorldHopStyle}"
                                                   WorldProcessStyle="{StaticResource GraphWorldProcessStyle}"
                                                   LandBrush="{DynamicResource MapLandBrush}"
                                                   LandLitBrush="{DynamicResource MapLandLitBrush}"
                                                   CoastBrush="{DynamicResource MapCoastBrush}"
                                                   SendBrush="{DynamicResource UploadBrush}"
                                                   ReceiveBrush="{DynamicResource DownloadBrush}"
                                                   AccentBrush="{DynamicResource AccentBrush}"
                                                   TrackBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                   QuietBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                   AutomationProperties.Name="Traffic graph" />
                        </controls:PanZoomHost>

                        <!--
                            What the graph is showing, and the controls that belong to
                            it, floating along the bottom of the picture rather than
                            taking a strip of height above it. Nothing here has a
                            ground of its own, so a drag that starts between them
                            still pans the canvas underneath.
                        -->
                        <Grid VerticalAlignment="Bottom" Margin="12,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                One line that says what the graph is showing: every
                                peer, or the route to one of them. Left out of the hit
                                test so it never swallows a drag.
                            -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        IsHitTestVisible="False">
                            <TextBlock VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="Graph subject">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="{DynamicResource TextSize12}" />
                                        <Setter Property="Text" Value="{Binding PeerSummary}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFollowing}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Whose map this is, while the map is on screen. -->
                            <TextBlock Text="{Binding MapCredit}"
                                       FontSize="{DynamicResource TextSize12}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!--
                                    Everything that only has to be decided once
                                    lives behind this, so the picture keeps the
                                    room - including the two switches the table
                                    below also has, which go away with the table
                                    whenever the graph is full screen.
                                -->
                                <ToggleButton Style="{StaticResource ToolbarButtonStyle}"
                                              Padding="8,0"
                                              Margin="0,0,6,0"
                                              IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}"
                                              AutomationProperties.Name="Graph settings"
                                              ToolTip="Live, names and the world map">
                                    <fluent:SymbolIcon Symbol="Settings" FontSize="15" />
                                </ToggleButton>

                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Margin="0,0,6,0"
                                        Command="{Binding ShowEverythingCommand}"
                                        Visibility="{Binding IsFollowing, Converter={StaticResource BooleanToVisibility}}"
                                        AutomationProperties.Name="Show everything"
                                        ToolTip="Stop following this branch and show the whole picture again" >
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <fluent:SymbolIcon Symbol="ArrowReset"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,7,0" />
                                                <TextBlock Text="Show everything" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button.Content>
                                </Button>

                                <Button x:Name="FitButton"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Margin="0,0,6,0"
                                        AutomationProperties.Name="Fit the graph"
                                        ToolTip="Frame the whole thing. Press again to go back to the view you had. Drag to move it, scroll to zoom, double-click to fit; from the keyboard, Ctrl and the arrow keys move it, plus and minus zoom, Ctrl+0 fits." >
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <fluent:SymbolIcon Symbol="ZoomFit"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,7,0" />
                                                <TextBlock Text="Fit" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button.Content>
                                </Button>

                                <Button x:Name="FullScreenButton"
                                        Style="{StaticResource GraphCornerStyle}"
                                        Command="{Binding ToggleFullScreenCommand}"
                                        AutomationProperties.Name="Full screen"
                                        ToolTip="Give the graph the whole window. Escape brings the rest back." />
                            </StackPanel>
                        </Grid>

                    <!--
                        The switches, out of the way until they are wanted. The panel is always
                        in the tree so it can slide rather than appear, and is collapsed while
                        shut so nothing in it can be tabbed to or clicked through.
                    -->
                    <Border x:Name="Drawer">
                        <Border.RenderTransform>
                            <TranslateTransform X="26" />
                        </Border.RenderTransform>

                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GraphDrawerStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                            <DiscreteObjectKeyFrame.Value>
                                                                <Visibility>Visible</Visibility>
                                                            </DiscreteObjectKeyFrame.Value>
                                                        </DiscreteObjectKeyFrame>
                                                    </ObjectAnimationUsingKeyFrames>

                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1"
                                                                     Duration="0:0:0.14" />

                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="0"
                                                                     Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>

                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="26"
                                                                     Duration="0:0:0.14" />

                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.14">
                                                            <DiscreteObjectKeyFrame.Value>
                                                                <Visibility>Collapsed</Visibility>
                                                            </DiscreteObjectKeyFrame.Value>
                                                        </DiscreteObjectKeyFrame>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,2">
                                <ToggleButton DockPanel.Dock="Right"
                                              Style="{StaticResource GraphDrawerCloseStyle}"
                                              IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}"
                                              AutomationProperties.Name="Close the graph settings"
                                              ToolTip="Close" />

                                <TextBlock Text="GRAPH" Style="{StaticResource GraphDrawerHeadStyle}" />
                            </DockPanel>

                            <Border DockPanel.Dock="Top"
                                    Height="1"
                                    Margin="10,4,10,2"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <!--
                                The switches scroll when the window is too short to
                                hold them. The drawer takes only the height it needs
                                up to whatever the window has, so on a tall window
                                there is nothing to scroll and no bar to see.
                            -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,2,0">
                                <StackPanel>

                                        <!--
                                            No Live switch here: the window's one
                                            Pause, beside the table, holds the
                                            picture still too.
                                        -->
                                        <StackPanel Style="{StaticResource GraphDrawerRowStyle}" Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                      Content="Names"
                                                      IsChecked="{Binding ShowNames, Mode=TwoWay}"
                                                      AutomationProperties.Name="Names" />

                                            <controls:SettingHead Hint="Call each far end by its name where one is known, rather than its address." Margin="6,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Style="{StaticResource GraphDrawerRowStyle}" Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                      Content="Signals"
                                                      IsChecked="{Binding ShowSignals, Mode=TwoWay}"
                                                      AutomationProperties.Name="Signals" />

                                            <controls:SettingHead Hint="Draw the traffic travelling each road. Off holds the picture still." Margin="6,0,0,0" />
                                        </StackPanel>

                                        <!-- Taken out in the Store edition, which traces no routes; see the code behind. -->
                                        <StackPanel x:Name="RoutesRow" Style="{StaticResource GraphDrawerRowStyle}" Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                      Content="Routes"
                                                      IsChecked="{Binding ShowRoutes, Mode=TwoWay}"
                                                      AutomationProperties.Name="Routes" />

                                            <controls:SettingHead Hint="Draw the way to each far end, hop by hop, found by sending packets towards it as tracert does. Off shows only where the traffic ends up. The same switch as the map's, and as Route tracing under Settings, Data and privacy." Margin="6,0,0,0" />
                                        </StackPanel>

                                        <Border Height="1"
                                                Margin="10,10,10,2"
                                                Visibility="{Binding HasWorld, Converter={StaticResource BooleanToVisibility}}"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                        <TextBlock Text="EARTH"
                                                   Style="{StaticResource GraphDrawerHeadStyle}"
                                                Visibility="{Binding HasWorld, Converter={StaticResource BooleanToVisibility}}"
                                                   Margin="10,6,0,0" />

                                        <StackPanel Style="{StaticResource GraphDrawerRowStyle}" Orientation="Horizontal"
                                                    Visibility="{Binding HasWorld, Converter={StaticResource BooleanToVisibility}}">
                                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                      Content="World map"
                                                      IsChecked="{Binding IsWorld, Mode=TwoWay}"
                                                      AutomationProperties.Name="World map" />

                                            <controls:SettingHead Hint="Lay the picture out on the earth, with every far end where its address says it is." Margin="6,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Style="{StaticResource GraphDrawerRowStyle}" Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                      Content="Country names"
                                                      IsChecked="{Binding ShowLabels, Mode=TwoWay}"
                                                      AutomationProperties.Name="Country names" />

                                            <controls:SettingHead Hint="Write the name of every country that has something on it." Margin="6,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Margin="26,8,10,8" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <!--
                                                            Two conditions: there has to be a map, and it has to be
                                                            naming anything at all.
                                                        -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsWorld}" Value="True" />
                                                                <Condition Binding="{Binding ShowLabels}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                      Content="Every country"
                                                      IsChecked="{Binding ShowAllLabels, Mode=TwoWay}"
                                                      AutomationProperties.Name="Every country" />

                                            <controls:SettingHead Hint="Name the rest of the world too, wherever the name fits inside the country. Zoom in and more appear." Margin="6,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Style="{StaticResource GraphDrawerRowStyle}" Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                      Content="Shade by traffic"
                                                      IsChecked="{Binding ShowHeat, Mode=TwoWay}"
                                                      AutomationProperties.Name="Shade by traffic" />

                                            <controls:SettingHead Hint="Fill each country by how much of your traffic goes there." Margin="6,0,0,0" />
                                        </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    </Grid>
                </controls:DetachHost>
            </Grid>
        </Border>

        <!--
            Drag to decide how much of the window the graph gets. Hidden while
            the card is collapsed, because there is then nothing to resize.
        -->
        <GridSplitter Grid.Row="1"
                      Height="10"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      AutomationProperties.Name="Resize the graph"
                      ToolTip="Drag to give the graph more or less room">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent" Cursor="SizeNS">
                        <Border Width="46"
                                Height="3"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- The toolbar and the table share a row, so the handle above them
             has a star row on each side to move between. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!--
            Above the toolbar rather than under it: a standing fact about the
            whole window, and in the middle it separated the controls that
            narrow the table from the table they narrow.
        -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="14,9"
                CornerRadius="8"
                Background="{DynamicResource AccentSoftBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RateNotice}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Orientation="Horizontal">
                <fluent:SymbolIcon Symbol="Info"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding RateNotice}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource TextSize12_5}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!--
            What this window shows, and in what units. The unit choice is this
            window's alone: it starts from what the overview is set to and never
            writes back, so two windows open side by side can read in different
            units without arguing.
        -->
        <!--
            Three sets, each wrapping as a unit: what the table does, what units
            it reads in, and the count of sockets at the far end. A narrow
            window stacks them from one left edge rather than splitting a set
            across two lines.
        -->
        <!--
            The toolbar and the table on one card, the way every table in the
            app sits: drawn behind the two rows rather than around them, so the
            rows stay rows of this grid.
        -->
        <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource TableCardStyle}" />

        <controls:FlowRow Grid.Row="1" Margin="12,12,8,10" Spacing="8" LineSpacing="8">
            <controls:FlowRow Spacing="8" LineSpacing="8">
                <!-- A verb, not a state: the same button the other two tables offer. -->
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ToggleLiveCommand}"
                        AutomationProperties.Name="{Binding LiveLabel}"
                        ToolTip="Hold this window still - the graph and the table both - so it can be read. Nothing stops being measured while it is paused.">
                    <StackPanel Orientation="Horizontal">
                        <fluent:SymbolIcon FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0">
                            <fluent:SymbolIcon.Style>
                                <Style TargetType="fluent:SymbolIcon">
                                    <Setter Property="Symbol" Value="PauseCircle" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="False">
                                            <Setter Property="Symbol" Value="PlayCircle" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fluent:SymbolIcon.Style>
                        </fluent:SymbolIcon>

                        <TextBlock Text="{Binding LiveLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                          Content="Names"
                          IsChecked="{Binding ShowNames, Mode=TwoWay}"
                          AutomationProperties.Name="Show names"
                          ToolTip="Call each far end by its name where one is known. Unticked, every far end is shown as the address it really is." />

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ResetViewCommand}"
                        Visibility="{Binding IsCustomised, Converter={StaticResource BooleanToVisibility}}"
                        ToolTip="Put the column filters and the sort back to their defaults" >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <fluent:SymbolIcon Symbol="ArrowReset"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0" />
                                <TextBlock Text="Reset view" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                </Button>
            </controls:FlowRow>

            <controls:FlowRow Spacing="8" LineSpacing="8">
                <controls:Picker Style="{StaticResource PickerStyle}"
                                 MinWidth="92"
                                 ItemsSource="{Binding Families}"
                                 ItemTemplate="{StaticResource OptionLabelTemplate}"
                                 SelectedValuePath="Family"
                                 SelectedValue="{Binding SelectedFamily, Mode=TwoWay}"
                                 AutomationProperties.Name="Unit family"
                                 ToolTip="Count in bytes or in bits, in this window only" />

                <controls:Picker Style="{StaticResource PickerStyle}"
                                 MinWidth="96"
                                 ItemsSource="{Binding Scales}"
                                 ItemTemplate="{StaticResource OptionLabelTemplate}"
                                 SelectedValuePath="Scale"
                                 SelectedValue="{Binding SelectedScale, Mode=TwoWay}"
                                 AutomationProperties.Name="Unit scale"
                                 ToolTip="Auto picks the best magnitude, or pin one" />
            </controls:FlowRow>

            <TextBlock controls:FlowRow.Trailing="True"
                       Text="{Binding SocketSummary}"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource TextSize12}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </controls:FlowRow>

        <!-- Everything Windows will say about each socket. -->
        <Grid Grid.Row="2" Margin="6,0,6,6">

            <DataGrid x:Name="Table"
                      Style="{StaticResource TableStyle}"
                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                      RowStyle="{StaticResource ConnectionRowStyle}"
                      CellStyle="{StaticResource TableCellStyle}"
                      AutomationProperties.Name="Connections">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="HostColumn"
                                        Binding="{Binding Host}"
                                        SortMemberPath="Host"
                                        Width="215"
                                        MinWidth="130"
                                        ElementStyle="{StaticResource ConnectionTextStyle}">
                        <!-- A listening socket's "::" is no far end, said so rather than as a symbol. -->
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding HostSpoken}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="RemotePortColumn"
                                        Binding="{Binding RemotePortText}"
                                        SortMemberPath="RemotePort"
                                        Width="105"
                                        MinWidth="80"
                                        ElementStyle="{StaticResource ConnectionQuietTextStyle}" />

                    <!-- Who runs the far end's network, and a mark when a blocklist the person switched on names it. -->
                    <!-- Named by what the cell shows, not "Item: ..., Column Display Index: 2". -->
                    <DataGridTemplateColumn x:Name="NetworkColumn"
                                            SortMemberPath="Network"
                                            Width="190"
                                            MinWidth="120">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Network, Converter={StaticResource SpokenDash}}" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0">
                                    <fluent:SymbolIcon Symbol="ShieldError"
                                                       FontSize="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource HotBrush}"
                                                       ToolTip="{Binding Listed}"
                                                       AutomationProperties.Name="{Binding Listed}"
                                                       Visibility="{Binding IsListed, Converter={StaticResource BooleanToVisibility}}" />
                                    <TextBlock Text="{Binding Network}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource TextSize12}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               ToolTip="{Binding Network}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="StateColumn"
                                        Binding="{Binding State}"
                                        SortMemberPath="State"
                                        Width="98"
                                        MinWidth="76"
                                        ElementStyle="{StaticResource ConnectionTextStyle}" />

                    <DataGridTextColumn x:Name="ProtocolColumn"
                                        Binding="{Binding Protocol}"
                                        SortMemberPath="Protocol"
                                        Width="64"
                                        MinWidth="54"
                                        ElementStyle="{StaticResource ConnectionQuietTextStyle}" />

                    <DataGridTextColumn x:Name="VersionColumn"
                                        Binding="{Binding Version}"
                                        SortMemberPath="Version"
                                        Width="58"
                                        MinWidth="50"
                                        ElementStyle="{StaticResource ConnectionQuietTextStyle}" />

                    <DataGridTextColumn x:Name="LocalAddressColumn"
                                        Binding="{Binding LocalAddress}"
                                        SortMemberPath="LocalAddress"
                                        Width="140"
                                        MinWidth="100"
                                        ElementStyle="{StaticResource ConnectionQuietTextStyle}">
                        <!-- "::" is a symbol to a screen reader; it is every IPv6 address. -->
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding LocalAddressSpoken}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="LocalPortColumn"
                                        Binding="{Binding LocalPortText}"
                                        SortMemberPath="LocalPort"
                                        Width="105"
                                        MinWidth="80"
                                        ElementStyle="{StaticResource ConnectionQuietTextStyle}" />

                    <DataGridTextColumn x:Name="OpenedColumn"
                                        Binding="{Binding OpenedText}"
                                        SortMemberPath="Opened"
                                        Width="98"
                                        MinWidth="80"
                                        ElementStyle="{StaticResource ConnectionQuietTextStyle}" />

                    <DataGridTextColumn x:Name="AgeColumn"
                                        Binding="{Binding Age}"
                                        SortMemberPath="Opened"
                                        Width="78"
                                        MinWidth="64"
                                        ElementStyle="{StaticResource ConnectionQuietTextStyle}" />

                    <!-- The service that opened each socket, for a service host. -->
                    <DataGridTextColumn x:Name="ServiceColumn"
                                        Binding="{Binding Service}"
                                        SortMemberPath="Service"
                                        Width="140"
                                        MinWidth="90"
                                        ElementStyle="{StaticResource ConnectionQuietTextStyle}" />

                    <!-- Close one TCP connection: the full edition, as administrator. -->
                    <DataGridTemplateColumn x:Name="CloseColumn"
                                            Width="84"
                                            MinWidth="84"
                                            CanUserSort="False"
                                            CanUserResize="False"
                                            CanUserReorder="False"
                                            HeaderStyle="{StaticResource ActionsHeaderStyle}">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding CloseName}" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Named for its row, so each Close says which connection it closes. -->
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Margin="4,2"
                                        Padding="8,2"
                                        Content="Close"
                                        Command="{Binding CloseCommand}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibility}}"
                                        AutomationProperties.Name="{Binding CloseName}"
                                        ToolTip="Reset this TCP connection. Needs administrator rights; you are asked first." />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        </Grid>
    </Grid>
</Window>

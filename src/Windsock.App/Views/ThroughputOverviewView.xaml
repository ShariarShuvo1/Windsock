<UserControl x:Class="Windsock.App.Views.ThroughputOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Windsock.App.Controls"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Windsock.App.ViewModels"
             xmlns:views="clr-namespace:Windsock.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ThroughputOverviewViewModel}"
             d:DesignWidth="880"
             d:DesignHeight="320">

    <!--
        The network's chart, as the System section shows it at the top of the
        page: the readouts on the left with the chart's own unit controls under
        them, and the chart on the right. No name over it - the chosen tile
        under it already says what it is - so the chart starts where the page
        does.
    -->
    <Border Style="{StaticResource SectionStyle}">
        <StackPanel>
            <!--
                Row while there is room, stacked below the breakpoint. The lead
                column holds both readouts; the chart takes whatever is left.
            -->
            <controls:AdaptiveRow Breakpoint="600"
                                  LeadWidth="{StaticResource ChartLeadWidth}"
                                  Spacing="24">

                <!--
                    The readouts, and under them how the chart counts: at the foot
                    of the column beside the chart while they are side by side,
                    straight under the readouts once the chart drops below.
                -->
                <!--
                    Declared top to bottom, so Tab reads the column as the eye
                    does: the readouts, then the units at its foot. (The foot was
                    declared first, and Tab went to the units and then jumped
                    back up to the readouts.)
                -->
                <DockPanel LastChildFill="False" VerticalAlignment="Stretch">
                    <WrapPanel DockPanel.Dock="Top" Margin="-8,-6,0,0">
                        <ToggleButton Style="{StaticResource SeriesToggleStyle}"
                                      IsChecked="{Binding IsDownloadVisible, Mode=TwoWay}"
                                      MinWidth="176"
                                      Margin="0,0,16,6"
                                      AutomationProperties.Name="Show download series"
                                      ToolTip="Click to hide or show this series on the chart">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                    <fluent:SymbolIcon Symbol="ArrowDownload"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource DownloadBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0" />
                                    <TextBlock Text="DOWNLOAD"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Fixed height so a size change never reflows the block. -->
                                <StackPanel Orientation="Horizontal" Height="50">
                                    <TextBox Text="{Binding DownloadValue, Mode=OneWay}"
                                             Style="{StaticResource ReadoutTextStyle}"
                                             FontSize="{Binding DownloadFontSize}"
                                             AutomationProperties.Name="Download rate"
                                             VerticalAlignment="Bottom" />
                                    <TextBox Text="{Binding DownloadUnit, Mode=OneWay}"
                                             Style="{StaticResource ReadoutUnitTextStyle}"
                                             AutomationProperties.Name="Download rate unit"
                                             VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource SeriesToggleStyle}"
                                      IsChecked="{Binding IsUploadVisible, Mode=TwoWay}"
                                      MinWidth="176"
                                      Margin="0,0,0,6"
                                      AutomationProperties.Name="Show upload series"
                                      ToolTip="Click to hide or show this series on the chart">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                    <fluent:SymbolIcon Symbol="ArrowUpload"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource UploadBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0" />
                                    <TextBlock Text="UPLOAD"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Height="50">
                                    <TextBox Text="{Binding UploadValue, Mode=OneWay}"
                                             Style="{StaticResource ReadoutTextStyle}"
                                             FontSize="{Binding UploadFontSize}"
                                             AutomationProperties.Name="Upload rate"
                                             VerticalAlignment="Bottom" />
                                    <TextBox Text="{Binding UploadUnit, Mode=OneWay}"
                                             Style="{StaticResource ReadoutUnitTextStyle}"
                                             AutomationProperties.Name="Upload rate unit"
                                             VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </ToggleButton>
                    </WrapPanel>

                    <!-- Local network against internet, from the kernel trace (full edition, as administrator). -->
                    <views:LanSplitLine x:Name="LanSplit" DockPanel.Dock="Top" />

                    <!--
                        Lifted by the chart's time axis (18), so the row ends on
                        the plot's baseline. The page's Pause is in its heading,
                        where every live page keeps it; these are the chart's own
                        units, remembered from one start to the next.
                    -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,18">
                        <controls:Picker Style="{StaticResource PickerStyle}"
                                         MinWidth="80"
                                         ItemsSource="{Binding Families}"
                                         ItemTemplate="{StaticResource OptionLabelTemplate}"
                                         SelectedValuePath="Family"
                                         SelectedValue="{Binding SelectedFamily, Mode=TwoWay}"
                                         AutomationProperties.Name="Unit family"
                                         ToolTip="Count in bytes or in bits. Also decides what Auto scales through." />

                        <controls:Picker Style="{StaticResource PickerStyle}"
                                         MinWidth="80"
                                         Margin="8,0,0,0"
                                         ItemsSource="{Binding Scales}"
                                         ItemTemplate="{StaticResource OptionLabelTemplate}"
                                         SelectedValuePath="Scale"
                                         SelectedValue="{Binding SelectedScale, Mode=TwoWay}"
                                         AutomationProperties.Name="Unit scale"
                                         ToolTip="Auto picks the best magnitude, or pin one." />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource ChartWellStyle}" Height="232">
                    <controls:DetachHost x:Name="ChartHost"
                                         WindowTitle="Throughput"
                                         Note="The chart is open in a window of its own.">
                        <Grid>
                            <!-- Row 1 is the Wi-Fi signal under the plot (d-signal), while Wi-Fi is connected. -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:ThroughputChart x:Name="Chart"
                                                      DownloadSeries="{Binding DownloadSeries}"
                                                      UploadSeries="{Binding UploadSeries}"
                                                      Revision="{Binding SeriesRevision}"
                                                      SampleIntervalSeconds="{Binding SampleIntervalSeconds}"
                                                      MinimumVisibleSamples="20"
                                                      ShowDownload="{Binding IsDownloadVisible}"
                                                      ShowUpload="{Binding IsUploadVisible}"
                                                      Family="{Binding SelectedFamily}"
                                                      Scale="{Binding SelectedScale}"
                                                      DownloadBrush="{DynamicResource DownloadBrush}"
                                                      UploadBrush="{DynamicResource UploadBrush}"
                                                      GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                      AxisBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                      SurfaceBrush="{DynamicResource SurfaceBrush}"
                                                      MarkerBrush="{DynamicResource HotBrush}"
                                                      AutomationProperties.Name="Download and upload over time" />

                            <Canvas x:Name="PopoverLayer" IsHitTestVisible="False">
                                <Border x:Name="Popover"
                                        Style="{StaticResource PopoverStyle}"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{Binding HoverTimeLabel}"
                                                   Style="{StaticResource CaptionTextStyle}" />

                                        <!-- The outage, network change or alert marked under the pointer; set by the code behind. -->
                                        <TextBlock x:Name="HoverEvent"
                                                   Margin="0,6,0,0"
                                                   MaxWidth="240"
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource TextSize12}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Visibility="Collapsed" />

                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                                    Visibility="{Binding IsDownloadVisible, Converter={StaticResource BooleanToVisibility}}">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{DynamicResource DownloadBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding HoverDownload}"
                                                       FontSize="{DynamicResource TextSize12}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                    Visibility="{Binding IsUploadVisible, Converter={StaticResource BooleanToVisibility}}">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{DynamicResource UploadBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding HoverUpload}"
                                                       FontSize="{DynamicResource TextSize12}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <!--
                                            Who was moving it. Absent rather than empty
                                            when Windsock cannot say - an unattributed point
                                            should look like no answer, not like nobody.
                                        -->
                                        <StackPanel Margin="0,9,0,0"
                                                    Visibility="{Binding HasHoverShares, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock Text="TOP PROCESSES"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Margin="0,0,0,4" />

                                            <ItemsControl ItemsSource="{Binding HoverShares}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,0" MinWidth="150">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontSize="{DynamicResource TextSize11_5}"
                                                                       MaxWidth="130"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Rate}"
                                                                       FontSize="{DynamicResource TextSize11_5}"
                                                                       FontWeight="SemiBold"
                                                                       Margin="12,0,0,0"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Canvas>

                            <!--
                                The Wi-Fi signal on the chart's own time axis: inset by
                                the chart's value axis and following its zoom, so a slow
                                moment lines up with a weak signal under it.
                            -->
                            <controls:SignalStrip x:Name="Signal"
                                                  Grid.Row="1"
                                                  Height="34"
                                                  Margin="0,4,0,0"
                                                  Points="{Binding Points}"
                                                  Revision="{Binding Revision}"
                                                  Label="{Binding Label}"
                                                  VisibleSampleCount="{Binding VisibleSampleCount, ElementName=Chart}"
                                                  SampleIntervalSeconds="{Binding SampleIntervalSeconds, ElementName=Chart}"
                                                  EndAt="{Binding LatestSampleTime, ElementName=Chart}"
                                                  LeftInset="54"
                                                  LineBrush="{DynamicResource NetworkBrush}"
                                                  GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                  AxisBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                  Visibility="{Binding IsShowing, Converter={StaticResource BooleanToVisibility}}"
                                                  AutomationProperties.Name="Wi-Fi signal under the chart"
                                                  AutomationProperties.HelpText="{Binding Summary}" />
                        </Grid>
                    </controls:DetachHost>
                </Border>
            </controls:AdaptiveRow>
        </StackPanel>
    </Border>
</UserControl>

<UserControl x:Class="Windsock.App.Views.ProcessPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Windsock.App.Controls"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Windsock.App.ViewModels"
             xmlns:views="clr-namespace:Windsock.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProcessPanelViewModel}"
             d:DesignWidth="880"
             d:DesignHeight="360">

    <!--
        One scroller around the whole body. Everything under the tab band moves
        together, so a short window is scrolled rather than having its last
        section squeezed to nothing, and the window itself never scrolls.

        The grid inside is held to the height of that scroller, so a table with
        room to spare fills what is left rather than stopping halfway down with
        a blank space under it, and a window too short for the whole layout
        pushes past the viewport and scrolls the toolbar away with it.

        The table has no scroller of its own. One region that scrolls means one
        scrollbar and one gesture; a table that scrolls inside a page that also
        scrolls is two of each, and they never agree with one another.
    -->
    <ScrollViewer x:Name="Body"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=Body}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <!--
                The map above the table, sized from the code behind: dragging
                the handle writes a height straight onto these rows, and a value
                written straight on outranks anything a style says afterwards.
            -->
            <RowDefinition x:Name="MapRow" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="TableRow" Height="*" />
        </Grid.RowDefinitions>

        <!--
            One surface under both rows: the controls that narrow the table and
            the picture of what the machine is talking to are one section, the
            same way the history tab keeps its period controls and its chart on
            a single card.

            Drawn as a card spanning the two rows rather than wrapped around
            them, because the handle underneath resizes rows of this grid and
            can only do that while the map has a row of its own.
        -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource CardStyle}" />

        <!--
            Toolbar: what narrows the table, and what it currently shows. Two
            groups on one line while there is room, stacked when there is not.
        -->
        <DockPanel Grid.Row="1" LastChildFill="True" Margin="16,12,16,12">
            <!--
                Opens the map under it. Docked outside the wrapping row on
                purpose: when the toolbar drops to a second line this stays on
                the first, where a section control belongs - the same
                arrangement the history tab uses.

                Chevron alone, with no heading beside it. The map names itself
                the moment it is open, and a title bar over the top of it spent
                a line of height on a word.
            -->
            <ToggleButton DockPanel.Dock="Right"
                          VerticalAlignment="Top"
                          Margin="10,0,0,0"
                          Style="{StaticResource SectionCollapseStyle}"
                          IsChecked="{Binding IsMapOpen, Mode=TwoWay}"
                          AutomationProperties.Name="Network map"
                          ToolTip="Show everything this machine is talking to, above the table" />

        <controls:AdaptiveRow Breakpoint="620" Spacing="8">
            <!--
                Wrapped rather than in a row: a narrow window has to put these
                on two lines, and a row that cannot wrap simply runs the last of
                them off the edge of the card where they cannot be reached at
                all. The negative margin takes back the gap under the last line.
            -->
            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,-6">
                <TextBox Style="{StaticResource SearchBoxStyle}"
                         Width="220"
                         Margin="0,0,10,6"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search processes"
                         ToolTip="Matches the process name, description or id" />

                <!--
                    A verb, not a state, and the same button the history tab
                    offers: the reader is told what pressing it does.
                -->
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,10,6"
                        Command="{Binding ToggleLiveCommand}"
                        AutomationProperties.Name="{Binding LiveLabel}"
                        ToolTip="Hold the table and the map below it still so they can be read. Nothing stops being measured while they are paused.">
                    <StackPanel Orientation="Horizontal">
                        <fluent:SymbolIcon FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0">
                            <fluent:SymbolIcon.Style>
                                <Style TargetType="fluent:SymbolIcon">
                                    <Setter Property="Symbol" Value="PauseCircle" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="False">
                                            <Setter Property="Symbol" Value="PlayCircle" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fluent:SymbolIcon.Style>
                        </fluent:SymbolIcon>

                        <TextBlock Text="{Binding LiveLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                          Margin="0,0,4,6"
                          Content="Group"
                          IsChecked="{Binding IsGrouped, Mode=TwoWay}"
                          ToolTip="Collect processes that share a name under one row" />

                <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                          Margin="0,0,8,6"
                          Content="Active only"
                          IsChecked="{Binding ActiveOnly, Mode=TwoWay}"
                          ToolTip="Hide processes that are not moving anything right now" />

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,0,6"
                        Command="{Binding ResetViewCommand}"
                        Visibility="{Binding IsCustomised, Converter={StaticResource BooleanToVisibility}}"
                        ToolTip="Put the search, filters, columns and sort back to their defaults" >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <fluent:SymbolIcon Symbol="ArrowReset"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0" />
                                <TextBlock Text="Reset view" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                </Button>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRow, RelativeSource={RelativeSource AncestorType=controls:AdaptiveRow}}"
                                         Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding CountText}"
                           Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <ToggleButton x:Name="ColumnsButton"
                              Style="{StaticResource ToolbarButtonStyle}"
                              ToolTip="Choose which columns are shown"
                              AutomationProperties.Name="Choose columns">
                    <StackPanel Orientation="Horizontal">
                        <fluent:SymbolIcon Symbol="ColumnTriple"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0" />
                        <TextBlock Text="Columns" VerticalAlignment="Center" />
                        <Path Data="M 0 0 L 4 4 L 8 0"
                              Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Margin="7,1,0,0"
                              VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsButton, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=ColumnsButton}"
                       Placement="Bottom"
                       VerticalOffset="6"
                       HorizontalOffset="-90"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Style="{StaticResource FlyoutStyle}" MinWidth="210" Padding="6">
                        <!--
                            Capped and scrollable: the list grows with every
                            column Windsock learns to show, and a popup taller than
                            the screen simply runs off the bottom of it.
                        -->
                        <ScrollViewer MaxHeight="360"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Columns}"
                                          ItemTemplate="{StaticResource ColumnChoiceTemplate}" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </StackPanel>
        </controls:AdaptiveRow>
        </DockPanel>

        <!--
            Shown when per-process rates are not being collected. The table
            still lists who is on the network from the connection tables, which
            need no privileges; only the byte counts do.
        -->
        <!--
            Above the toolbar, not between it and the table. It is a standing
            fact about the whole panel, and putting it in the middle separated
            the controls that narrow the table from the table they narrow.
        -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="12,9"
                CornerRadius="7"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Visibility="{Binding RatesAvailable, Converter={StaticResource InverseBooleanToVisibility}}">
            <DockPanel LastChildFill="True">
                <fluent:SymbolIcon DockPanel.Dock="Left"
                                   Symbol="Info"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"
                                   Foreground="{DynamicResource AccentBrush}" />

                <!--
                    Named, like every other control here, and for a stronger
                    reason than most: its content is an icon beside a line of
                    text, which leaves automation nothing to call it by. Pressing
                    it asks Windows for consent and restarts the app, and a
                    button that does that must not announce itself as "button".
                -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="12,0,0,0"
                        Command="{Binding RestartElevatedCommand}"
                        AutomationProperties.Name="Restart as administrator"
                        AutomationProperties.HelpText="Closes Windsock and starts it again with administrator rights, after asking Windows for consent. Per-process rates need that; nothing else does."
                        ToolTip="Restart with administrator rights, so traffic can be attributed to each program"
                        Visibility="{Binding CanElevate, Converter={StaticResource BooleanToVisibility}}" >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <fluent:SymbolIcon Symbol="Shield"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0" />
                                <TextBlock Text="Restart as administrator" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                </Button>

                <TextBlock Text="{Binding RateNotice}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           ToolTip="{Binding RateDetail}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>

        <!--
            The table scrolls itself, so it asks the window for a floor and
            takes whatever it is given above that. Reporting the height of every
            row it holds would push the section above it around and scroll the
            page instead of the table.
        -->

        <!--
            Everything this machine is talking to, above the table of what is
            doing the talking - the same pairing the window for one process
            makes, and the same picture the map window shows. Shut to begin
            with, because open it watches every program on the machine by
            endpoint and walks every route they use.
        -->
        <controls:DetachHost x:Name="MapHost"
                             Grid.Row="2"
                             Margin="16,0,16,12"
                             WindowTitle="Network map"
                             WindowWidth="1240"
                             WindowHeight="820"
                             Note="The map is open in a window of its own."
                             Visibility="{Binding IsMapOpen, Converter={StaticResource BooleanToVisibility}}">
            <views:NetworkMapView DataContext="{Binding Map}" />
        </controls:DetachHost>

        <!-- Drag to decide how much of the tab the map gets. -->
        <GridSplitter Grid.Row="3"
                      Height="10"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      AutomationProperties.Name="Resize the map"
                      ToolTip="Drag to give the map more or less room">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMapOpen}" Value="True" />
                                <Condition Binding="{Binding IsDetached, ElementName=MapHost}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>

            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent" Cursor="SizeNS">
                        <Border Width="46"
                                Height="3"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Grid Grid.Row="4" Margin="0,12,0,0">
        <Grid>
            <!--
                Every column carries a width in pixels rather than a share of
                the table. A star column swallows all the slack, and the grid
                only ever takes back space from the columns to the right of the
                one being dragged - so with the wide column on the left, the
                columns beside it had nothing to give and would not move. Fixed
                widths let each column resize on its own, in both directions,
                and the grid fills whatever is left over itself.
            -->
            <DataGrid x:Name="Table"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Style="{StaticResource TableStyle}"
                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                      RowStyle="{StaticResource ProcessRowStyle}"
                      CellStyle="{StaticResource TableCellStyle}"
                      ItemsSource="{Binding Rows}"
                      AutomationProperties.Name="Processes using the network">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="NameColumn"
                                            CellTemplate="{StaticResource ProcessNameTemplate}"
                                            SortMemberPath="Name"
                                            Width="260"
                                            MinWidth="140" />

                    <DataGridTextColumn x:Name="DescriptionColumn"
                                        Binding="{Binding Description}"
                                        SortMemberPath="Description"
                                        Width="220"
                                        MinWidth="140"
                                        ElementStyle="{StaticResource TableQuietTextStyle}" />

                    <DataGridTextColumn x:Name="ProcessIdColumn"
                                        Binding="{Binding ProcessIdText}"
                                        SortMemberPath="ProcessId"
                                        Width="78"
                                        MinWidth="70"
                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                    <DataGridTextColumn x:Name="SendColumn"
                                        Binding="{Binding SendText}"
                                        SortMemberPath="SendBytesPerSecond"
                                        Width="118"
                                        MinWidth="88"
                                        ElementStyle="{StaticResource TableSendStyle}" />

                    <DataGridTextColumn x:Name="ReceiveColumn"
                                        Binding="{Binding ReceiveText}"
                                        SortMemberPath="ReceiveBytesPerSecond"
                                        Width="118"
                                        MinWidth="88"
                                        ElementStyle="{StaticResource TableReceiveStyle}" />

                    <DataGridTextColumn x:Name="TotalColumn"
                                        Binding="{Binding TotalText}"
                                        SortMemberPath="TotalBytesPerSecond"
                                        Width="118"
                                        MinWidth="88"
                                        ElementStyle="{StaticResource TableNumberStyle}" />

                    <DataGridTextColumn x:Name="ConnectionColumn"
                                        Binding="{Binding Connections}"
                                        SortMemberPath="Connections"
                                        Width="98"
                                        MinWidth="82"
                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                    <DataGridTextColumn x:Name="TcpColumn"
                                        Binding="{Binding TcpConnections}"
                                        SortMemberPath="TcpConnections"
                                        Width="76"
                                        MinWidth="66"
                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                    <DataGridTextColumn x:Name="UdpColumn"
                                        Binding="{Binding UdpEndpoints}"
                                        SortMemberPath="UdpEndpoints"
                                        Width="76"
                                        MinWidth="66"
                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                    <DataGridTextColumn x:Name="PacketColumn"
                                        Binding="{Binding PacketsText}"
                                        SortMemberPath="PacketsPerSecond"
                                        Width="104"
                                        MinWidth="92"
                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                    <DataGridTextColumn x:Name="SentColumn"
                                        Binding="{Binding SentText}"
                                        SortMemberPath="BytesSent"
                                        Width="112"
                                        MinWidth="88"
                                        ElementStyle="{StaticResource TableNumberStyle}" />

                    <DataGridTextColumn x:Name="ReceivedColumn"
                                        Binding="{Binding ReceivedText}"
                                        SortMemberPath="BytesReceived"
                                        Width="112"
                                        MinWidth="88"
                                        ElementStyle="{StaticResource TableNumberStyle}" />

                    <DataGridTextColumn x:Name="TransferredColumn"
                                        Binding="{Binding TransferredText}"
                                        SortMemberPath="BytesTransferred"
                                        Width="128"
                                        MinWidth="104"
                                        ElementStyle="{StaticResource TableNumberStyle}" />

                    <DataGridTextColumn x:Name="UptimeColumn"
                                        Binding="{Binding UptimeText}"
                                        SortMemberPath="UptimeSeconds"
                                        Width="104"
                                        MinWidth="84"
                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                    <DataGridTemplateColumn x:Name="PathColumn"
                                            SortMemberPath="FilePath"
                                            Width="340"
                                            MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PathLinkStyle}"
                                        Content="{Binding FilePath}"
                                        Command="{Binding DataContext.RevealCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding FilePath}"
                                        ToolTip="{Binding FilePath}"
                                        AutomationProperties.Name="Show this program in Explorer" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--
                        Row actions. Double-clicking a row opens the same
                        window, but a gesture nobody can see is not a way to
                        offer a feature.
                    -->
                    <DataGridTemplateColumn x:Name="ActionsColumn"
                                            Width="44"
                                            MinWidth="44"
                                            CanUserSort="False"
                                            CanUserResize="False"
                                            CanUserReorder="False"
                                            HeaderStyle="{StaticResource ActionsHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton x:Name="RowMenu"
                                              Style="{StaticResource RowMenuStyle}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              AutomationProperties.Name="Row actions"
                                              ToolTip="More for this process">
                                    <Grid>
                                        <StackPanel Orientation="Vertical"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <Popup IsOpen="{Binding IsChecked, ElementName=RowMenu, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=RowMenu}"
                                               Placement="Bottom"
                                               HorizontalOffset="-150"
                                               VerticalOffset="4"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Style="{StaticResource FlyoutStyle}"
                                                    MinWidth="176"
                                                    Padding="4">
                                                <StackPanel>
                                                    <Button Style="{StaticResource MenuItemStyle}"
                                                            Content="Open details"
                                                            Command="{Binding Tag.WatchCommand, ElementName=RowMenu}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanOpenDetails}"
                                                            AutomationProperties.Name="Open details"
                                                            ToolTip="Open a window showing what this process is connected to" />

                                                    <Button Style="{StaticResource MenuItemStyle}"
                                                            Content="{Binding PinLabel}"
                                                            Command="{Binding Tag.TogglePinCommand, ElementName=RowMenu}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding PinLabel}"
                                                            ToolTip="Hold this row at the top of the table. Right-clicking a row does the same." />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding EmptyText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,40,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Windsock.App.Views.HistoryPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Windsock.App.Controls"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Windsock.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryPanelViewModel}"
             d:DesignWidth="880"
             d:DesignHeight="420">

    <!--
        One scroller around the whole body. Everything under the tab band moves
        together, so a short window is scrolled rather than having its last
        section squeezed to nothing, and the window itself never scrolls.

        The grid inside is held to the height of that scroller, so a table with
        room to spare fills what is left rather than stopping halfway down with
        a blank space under it, and a window too short for the whole layout
        pushes past the viewport and scrolls the toolbar away with it.

        The table has no scroller of its own. One region that scrolls means one
        scrollbar and one gesture; a table that scrolls inside a page that also
        scrolls is two of each, and they never agree with one another. What that
        costs is a row really built rather than recycled, which is why the rows
        are handed over a screenful at a time - see Rebuild.
    -->
    <ScrollViewer x:Name="Body"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=Body}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            One card: what period is being looked at, what it came to, and the
            shape of it over time. They were four things stacked loose on the
            page, which is one section's worth of information wearing three
            different surfaces. A process window says the same kind of thing in
            one card with the picture sunk into it, and this now matches.
        -->
        <!--
            The tighter inset the process card uses. The house padding leaves a
            band of nothing above a strip of thirty pixel controls, and these
            two toolbars sit side by side in the same window.
        -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12,16,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!--
            What period to look at, and how finely to cut it. Wrapped for the
            same reason the process toolbar is: a row that cannot wrap runs its
            last control off the edge of the card where it cannot be reached.
        -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <!--
                Docked outside the wrapping row on purpose: when the toolbar
                drops to a second line this stays on the first, where a section
                control belongs - the same arrangement the overview uses.
            -->
            <ToggleButton DockPanel.Dock="Right"
                          Style="{StaticResource SectionCollapseStyle}"
                          VerticalAlignment="Top"
                          Margin="8,0,0,0"
                          IsChecked="{Binding IsDetailExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="Collapse summary"
                          ToolTip="Fold away the totals and the chart to give the table more room" />

            <WrapPanel Margin="0,0,0,-6">
            <controls:Picker Style="{StaticResource PickerStyle}"
                             MinWidth="132"
                             Margin="0,0,8,6"
                             ItemsSource="{Binding Ranges}"
                             ItemTemplate="{StaticResource OptionLabelTemplate}"
                             SelectedValuePath="Range"
                             SelectedValue="{Binding SelectedRange, Mode=TwoWay}"
                             AutomationProperties.Name="Period"
                             ToolTip="Which stretch of history to total up" />

            <controls:Picker Style="{StaticResource PickerStyle}"
                             MinWidth="112"
                             Margin="0,0,8,6"
                             ItemsSource="{Binding Resolutions}"
                             ItemTemplate="{StaticResource OptionLabelTemplate}"
                             SelectedValuePath="Granularity"
                             SelectedValue="{Binding SelectedResolution, Mode=TwoWay}"
                             AutomationProperties.Name="Resolution"
                             ToolTip="How wide each row and bar is. Minutes are offered for periods up to a week." />

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,8,6"
                        Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibility}}">
                <controls:DateTimeBox Value="{Binding CustomFrom, Mode=TwoWay}"
                                      AutomationProperties.Name="Range start"
                                      ToolTip="The first minute to include" />

                <TextBlock Text="to"
                           VerticalAlignment="Center"
                           Margin="8,0,8,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <controls:DateTimeBox Value="{Binding CustomTo, Mode=TwoWay}"
                                      AutomationProperties.Name="Range end"
                                      ToolTip="The last minute to include, counted in full" />
            </StackPanel>

            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Margin="0,0,6,6"
                    Command="{Binding ExportCommand}"
                    AutomationProperties.Name="Export"
                    ToolTip="Write the period on screen to a CSV file">
                <StackPanel Orientation="Horizontal">
                    <fluent:SymbolIcon Symbol="ArrowDownload"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                    <TextBlock Text="Export" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Margin="0,0,0,6"
                    Command="{Binding ImportCommand}"
                    AutomationProperties.Name="Import"
                    ToolTip="Read a CSV file back in. Minutes already recorded are left alone.">
                <StackPanel Orientation="Horizontal">
                    <fluent:SymbolIcon Symbol="ArrowUpload"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                    <TextBlock Text="Import" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!--
                Whether anything new is being written at all. Last in the row
                because it is a decision about the data rather than about what
                is on screen, and a checkbox rather than a button because that
                is what the toolbar above the process table already uses.
            -->
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Margin="10,0,0,6"
                    Command="{Binding ResetViewCommand}"
                    Visibility="{Binding IsCustomised, Converter={StaticResource BooleanToVisibility}}"
                    ToolTip="Put the column filters and the sort back to their defaults" >
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <fluent:SymbolIcon Symbol="ArrowReset"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,7,0" />
                            <TextBlock Text="Reset view" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
            </Button>

            <!--
                A verb, not a state. The reader is told what pressing it does
                rather than being asked to work out what a tick means.
            -->
            <Button Style="{StaticResource ToolbarButtonStyle}"
                        Margin="10,0,0,6"
                        Command="{Binding ToggleRecordingCommand}"
                        AutomationProperties.Name="{Binding RecordingLabel}"
                        ToolTip="Whether new minutes are written to disk. Pausing leaves everything already recorded alone.">
                    <StackPanel Orientation="Horizontal">
                        <!-- The glyph says the same thing as the words. -->
                        <fluent:SymbolIcon FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0">
                            <fluent:SymbolIcon.Style>
                                <Style TargetType="fluent:SymbolIcon">
                                    <Setter Property="Symbol" Value="PauseCircle" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="False">
                                            <Setter Property="Symbol" Value="PlayCircle" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fluent:SymbolIcon.Style>
                        </fluent:SymbolIcon>

                        <TextBlock Text="{Binding RecordingLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </DockPanel>

        <!--
            The answer, before the detail: how much moved, which way, and over
            what dates. The numbers shrink a tier at a time as they grow so a
            terabyte reads the same way a kilobyte does.
        -->
        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Visibility="{Binding IsDetailExpanded, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <controls:AdaptiveRow Breakpoint="520" Spacing="28">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,28,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                <fluent:SymbolIcon Symbol="ArrowDownload"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource DownloadBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0" />
                                <TextBlock Text="DOWNLOADED"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Fixed height so a size change never reflows the block. -->
                            <StackPanel Orientation="Horizontal" Height="42">
                                <TextBox Text="{Binding DownloadValue, Mode=OneWay}"
                                         Style="{StaticResource ReadoutTextStyle}"
                                         FontSize="{Binding DownloadFontSize}"
                                         AutomationProperties.Name="Downloaded"
                                         VerticalAlignment="Bottom" />
                                <TextBox Text="{Binding DownloadUnit, Mode=OneWay}"
                                         Style="{StaticResource ReadoutUnitTextStyle}"
                                         VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                <fluent:SymbolIcon Symbol="ArrowUpload"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource UploadBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0" />
                                <TextBlock Text="UPLOADED"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="42">
                                <TextBox Text="{Binding UploadValue, Mode=OneWay}"
                                         Style="{StaticResource ReadoutTextStyle}"
                                         FontSize="{Binding UploadFontSize}"
                                         AutomationProperties.Name="Uploaded"
                                         VerticalAlignment="Bottom" />
                                <TextBox Text="{Binding UploadUnit, Mode=OneWay}"
                                         Style="{StaticResource ReadoutUnitTextStyle}"
                                         VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <!-- Stacked: sits under the figures, so align with them. -->
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Style.Triggers>
                                    <!-- In a row it takes the far end, so the spare
                                         width falls between the two halves instead
                                         of trailing off the right of the card. -->
                                    <DataTrigger Binding="{Binding IsRow, RelativeSource={RelativeSource AncestorType=controls:AdaptiveRow}}"
                                                 Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!--
                            Which period this is, at the head of what it came
                            to. It used to have a line of its own above the
                            figures, which is a caption for the card floating
                            over the one part of the card it was not captioning.
                        -->
                        <TextBlock Text="{Binding RangeLabel}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   Margin="0,0,0,5" />

                        <TextBlock Margin="0,0,0,3"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right">
                            <Run Text="Together " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding TotalText, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </TextBlock>

                        <TextBlock Text="{Binding PeakText}"
                                   FontSize="12"
                                   Margin="0,0,0,3"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="{Binding CoverageText}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </controls:AdaptiveRow>
            </StackPanel>
        </Border>

        <!-- Says what an import or an export just did. Absent until one has. -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Notice}"
                   Margin="2,8,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AccentBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="3"
                Height="150"
                Margin="0,12,0,0"
                Padding="10,8"
                CornerRadius="8"
                SnapsToDevicePixels="True"
                Background="{DynamicResource CanvasGroundBrush}"
                Visibility="{Binding IsChartVisible, Converter={StaticResource BooleanToVisibility}}">
            <controls:DetachHost WindowTitle="History"
                                 Note="The chart is open in a window of its own.">
                <Grid>
                <!--
                    A word while a long span is read. The reading itself happens off
                    the interface thread, so the card stays alive; this is only so a
                    chart that has not arrived yet does not look like a chart with
                    nothing in it.
                -->
                <TextBlock Text="Reading&#8230;"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Panel.ZIndex="1"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />

                <controls:UsageBarChart x:Name="Chart"
                                        Buckets="{Binding Buckets}"
                                        Revision="{Binding Revision}"
                                        RangeStart="{Binding RangeStart}"
                                        RangeEnd="{Binding RangeEnd}"
                                        Granularity="{Binding SelectedResolution}"
                                        DownloadBrush="{DynamicResource DownloadBrush}"
                                        UploadBrush="{DynamicResource UploadBrush}"
                                        GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        AxisBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                        HighlightBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        HighlightedStart="{Binding HighlightedStart}"
                                        AutomationProperties.Name="Usage over the period"
                                        ToolTip="Scroll to zoom the time axis, drag to pan" />

                <Canvas x:Name="PopoverLayer" IsHitTestVisible="False">
                    <Border x:Name="Popover"
                            Style="{StaticResource PopoverStyle}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{Binding HoverLabel}"
                                       Style="{StaticResource CaptionTextStyle}" />

                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{DynamicResource DownloadBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding HoverDownload}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{DynamicResource UploadBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding HoverUpload}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Margin="0,6,0,0" FontSize="11.5">
                                <Run Text="Together " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Run Text="{Binding HoverTotal, Mode=OneWay}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </TextBlock>

                            <!--
                                Said only when part of the bucket is missing, so a
                                complete hour stays quiet about it.
                            -->
                            <TextBlock Text="{Binding HoverRecorded}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HoverRecorded}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Canvas>
                </Grid>
            </controls:DetachHost>
        </Border>

        <!--
            The exact numbers. Newest first, because the question a history
            answers is nearly always about the recent end of it.
        -->
        </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <DataGrid x:Name="Table"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Style="{StaticResource TableStyle}"
                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                      RowStyle="{StaticResource HistoryRowStyle}"
                      CellStyle="{StaticResource TableCellStyle}"
                      ItemsSource="{Binding Rows}"
                      AutomationProperties.Name="Recorded usage">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="FromColumn"
                                        Binding="{Binding From}"
                                        SortMemberPath="Start"
                                        Width="150"
                                        MinWidth="110"
                                        ElementStyle="{StaticResource TableTextStyle}" />

                    <DataGridTextColumn x:Name="ToColumn"
                                        Binding="{Binding To}"
                                        SortMemberPath="End"
                                        Width="150"
                                        MinWidth="80"
                                        ElementStyle="{StaticResource TableQuietTextStyle}" />

                    <DataGridTextColumn x:Name="DownloadColumn"
                                        Binding="{Binding Download}"
                                        SortMemberPath="BytesDown"
                                        Width="110"
                                        MinWidth="90"
                                        ElementStyle="{StaticResource TableReceiveStyle}" />

                    <DataGridTextColumn x:Name="UploadColumn"
                                        Binding="{Binding Upload}"
                                        SortMemberPath="BytesUp"
                                        Width="110"
                                        MinWidth="90"
                                        ElementStyle="{StaticResource TableSendStyle}" />

                    <DataGridTextColumn x:Name="TotalColumn"
                                        Binding="{Binding Total}"
                                        SortMemberPath="BytesTotal"
                                        Width="110"
                                        MinWidth="90"
                                        ElementStyle="{StaticResource TableNumberStyle}" />

                    <DataGridTextColumn x:Name="PeakDownColumn"
                                        Binding="{Binding PeakDown}"
                                        SortMemberPath="PeakDownBytes"
                                        Width="120"
                                        MinWidth="90"
                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                    <DataGridTextColumn x:Name="PeakUpColumn"
                                        Binding="{Binding PeakUp}"
                                        SortMemberPath="PeakUpBytes"
                                        Width="120"
                                        MinWidth="90"
                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                    <DataGridTextColumn x:Name="RecordedColumn"
                                        Binding="{Binding Recorded}"
                                        SortMemberPath="MinutesRecorded"
                                        Width="90"
                                        MinWidth="70"
                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                    <!--
                        Row actions. Last, narrow, and unsortable: it holds a
                        button rather than a value.
                    -->
                    <DataGridTemplateColumn x:Name="ActionsColumn"
                                            Width="44"
                                            MinWidth="44"
                                            CanUserSort="False"
                                            CanUserResize="False"
                                            CanUserReorder="False"
                                            HeaderStyle="{StaticResource ActionsHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton x:Name="RowMenu"
                                              Style="{StaticResource RowMenuStyle}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              AutomationProperties.Name="Row actions"
                                              ToolTip="More for this row">
                                    <Grid>
                                        <StackPanel Orientation="Vertical"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <Popup IsOpen="{Binding IsChecked, ElementName=RowMenu, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=RowMenu}"
                                               Placement="Bottom"
                                               HorizontalOffset="-130"
                                               VerticalOffset="4"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Style="{StaticResource FlyoutStyle}"
                                                    MinWidth="156"
                                                    Padding="4">
                                                <Button Style="{StaticResource MenuItemStyle}"
                                                        Content="Delete"
                                                        Command="{Binding Tag.DeleteRowCommand, ElementName=RowMenu}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Delete this row"
                                                        ToolTip="Forget everything recorded in this stretch of time" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Windsock.App.Views.TaskbarPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Windsock.App.Controls"
             xmlns:settings="clr-namespace:Windsock.Core.Settings;assembly=Windsock.Core"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Windsock.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TaskbarPanelViewModel}"
             d:DesignWidth="880"
             d:DesignHeight="420">

    <!--
        The Taskbar tab: what the meter shows, and what it looks like showing it.

        The preview comes first and stays at the top, because it is the answer
        to every question below it. Two bars rather than one: Windows draws its
        taskbar light or dark independently of what Windsock is set to, and the
        meter has to be legible on whichever the reader ends up with.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!--
                What the meter shows comes first, because it is what a reader
                opens this tab to change. How it sits on the bar follows, since
                that is set once and then left alone.
            -->
            <!--
                The slot editor. Laid out as the meter itself is laid out, so
                the picker in the top-right corner is the one that fills the
                top-right corner of the bar. A numbered list of dropdowns would
                make the reader keep the arrangement in their head.
            -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ResetStyle}"
                                Content="Reset everything"
                                VerticalAlignment="Center"
                                Command="{Binding ResetAllCommand}"
                                AutomationProperties.Name="Put the whole tab back"
                                ToolTip="Put every choice on this tab back the way it shipped. Whether the meter is shown is left alone." />

                        <controls:SettingHead
                            Text="Slots"
                            Hint="Choose what each position on the bar shows. Anything Windsock measures can go in any slot - network rates, processor, graphics, memory or disk. Each part of a cell opens its own settings: what it is marked with, what it counts in, how large it is drawn, which colour it takes and which end of its place it sits at."
                            Note="{Binding TemperatureNote}" />
                    </DockPanel>

                    <!--
                        One grid, one kind of cell. The slots are cells; the
                        ones that add a reading are cells as well, standing
                        where the reading they add will appear. Every place the
                        meter may have is on the board from the start, so
                        nothing moves as readings come and go.
                    -->
                    <ScrollViewer x:Name="Board"

                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="0,16,0,0"
                                  Padding="0,0,0,2">
                    <ItemsControl ItemsSource="{Binding GridCells}" Margin="0,0,-8,-8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding GridRows}" Columns="{Binding GridColumns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.Resources>
                            <!--
                                The colour of one part of one cell: the two
                                colours that are rules rather than colours, the
                                short row that reads well on a bar, and one
                                mixed by hand for when none of those is it.

                                One template for all three parts, because the
                                choice is the same choice three times over.
                            -->
                            <DataTemplate x:Key="InkChoiceTemplate" DataType="{x:Type vm:InkChoiceViewModel}">
                                <StackPanel>
                                    <TextBlock Text="COLOUR" Style="{StaticResource PartHeadStyle}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <Button Style="{StaticResource PartChoiceStyle}"
                                                Content="Taskbar text"
                                                Command="{Binding PaintCommand}"
                                                AutomationProperties.Name="Draw this in the taskbar own text colour"
                                                ToolTip="Whatever colour the taskbar writes in, which is the most legible" />

                                        <Button Style="{StaticResource PartChoiceStyle}"
                                                Content="Its own colour"
                                                Foreground="{Binding OwnInk}"
                                                Command="{Binding PaintCommand}"
                                                CommandParameter="{x:Static settings:MeterSlot.Own}"
                                                AutomationProperties.Name="Draw this in the reading own colour"
                                                ToolTip="The colour this reading has elsewhere in Windsock" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Inks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource InkStyle}"
                                                        Background="{Binding Converter={StaticResource InkToBrush}}"
                                                        Command="{Binding DataContext.PaintCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding}"
                                                        ToolTip="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--
                                        Any colour at all, for when none of the
                                        eight is the one in mind. Dragged or
                                        typed: a reader who knows the colour
                                        writes it down, and one who does not
                                        slides until it looks right.
                                    -->
                                    <ToggleButton x:Name="Mixer"
                                                  Style="{StaticResource PartToggleStyle}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,2,0,0"
                                                  Content="Mix a colour"
                                                  AutomationProperties.Name="Mix a colour"
                                                  ToolTip="Choose any colour at all" />

                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding IsChecked, ElementName=Mixer, Converter={StaticResource BooleanToVisibility}}">
                                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Left"
                                                    Width="24"
                                                    Height="24"
                                                    CornerRadius="5"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                    Background="{Binding Showing}" />

                                            <TextBox Style="{StaticResource EmbeddedTextBoxStyle}"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="The colour, written down"
                                                     ToolTip="The colour as #rrggbb" />
                                        </DockPanel>

                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="R"
                                                       Width="14"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                            <Slider Style="{StaticResource FlatSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="255"
                                                    SmallChange="1"
                                                    LargeChange="16"
                                                    Value="{Binding Red, Mode=TwoWay}"
                                                    AutomationProperties.Name="How much red"
                                                    ToolTip="How much red" />
                                        </DockPanel>

                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="G"
                                                       Width="14"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                            <Slider Style="{StaticResource FlatSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="255"
                                                    SmallChange="1"
                                                    LargeChange="16"
                                                    Value="{Binding Green, Mode=TwoWay}"
                                                    AutomationProperties.Name="How much green"
                                                    ToolTip="How much green" />
                                        </DockPanel>

                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="B"
                                                       Width="14"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                            <Slider Style="{StaticResource FlatSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="255"
                                                    SmallChange="1"
                                                    LargeChange="16"
                                                    Value="{Binding Blue, Mode=TwoWay}"
                                                    AutomationProperties.Name="How much blue"
                                                    ToolTip="How much blue" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>

                            <!--
                                A cell, drawn the way the taskbar will draw it:
                                the mark, the figure and the unit, each in its
                                own colour and weight. Every part is a button
                                onto its own settings, so a reader changes what
                                they are pointing at rather than finding its
                                name in a list.
                            -->
                            <DataTemplate DataType="{x:Type vm:MeterSlotChoiceViewModel}">
                                <Grid>
                                <Border Style="{StaticResource SlotCellStyle}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <!-- Empties this slot, and only this slot. -->
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource SlotDropStyle}"
                                                    VerticalAlignment="Top"
                                                    Command="{Binding ClearCommand}"
                                                    AutomationProperties.Name="Leave this slot blank"
                                                    ToolTip="Leave this slot blank" />

                                            <TextBlock Text="{Binding Address}"
                                                       Style="{StaticResource SlotAddressStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <!--
                                            The mark at one end and the unit at
                                            the other, exactly as the meter
                                            draws them, with the reading filling
                                            what is left. So every cell is one
                                            line however wide its column is, and
                                            a column dragged narrow shortens the
                                            reading rather than folding the cell
                                            into three lines.

                                            The sheets hang underneath rather
                                            than in the row: a popup is a child
                                            like any other, and three of them in
                                            the row would each be given a share
                                            of it.
                                        -->
                                        <controls:SlotRow Margin="0,4,0,0"
                                                          LeftCount="{Binding PartsOnTheLeft}">

                                            <!-- The mark: which part of the machine this is. -->
                                            <ToggleButton x:Name="MarkPart"
                                                          Style="{StaticResource CellPartStyle}"
                                                          AutomationProperties.Name="The mark on this reading"
                                                          ToolTip="What marks this reading, and its colour">
                                                <Grid>
                                                    <fluent:SymbolIcon Symbol="{Binding Mark, Converter={StaticResource MarkToSymbol}}"
                                                                       IconVariant="{Binding Bold, Converter={StaticResource WeightToVariant}}"
                                                                       Foreground="{Binding MarkInk.Showing}"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center">
                                                        <fluent:SymbolIcon.Style>
                                                            <Style TargetType="fluent:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MarkIsIcon}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fluent:SymbolIcon.Style>
                                                    </fluent:SymbolIcon>

                                                    <TextBlock Text="{Binding LabelText}"
                                                               FontSize="11"
                                                               FontWeight="{Binding Bold, Converter={StaticResource BoolToWeight}}"
                                                               Foreground="{Binding MarkInk.Showing}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MarkIsIcon}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!--
                                                        Struck through rather
                                                        than gone: a mark that
                                                        is not being shown is
                                                        still the part of the
                                                        cell that says so.
                                                    -->
                                                    <Border Height="1"
                                                            Background="{Binding MarkInk.Showing}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding ShowLabel, Converter={StaticResource InverseBooleanToVisibility}}" />
                                                </Grid>
                                            </ToggleButton>


                                            <!-- The figure: which reading, in what units, how large. -->
                                            <ToggleButton x:Name="ValuePart"
                                                          Style="{StaticResource CellPartStyle}"
                                                          AutomationProperties.Name="{Binding ValueText}"
                                                          ToolTip="Which reading this is, its units, size and colour">
                                                <TextBlock Text="{Binding ValueText}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontWeight="{Binding Bold, Converter={StaticResource BoolToWeight}}"
                                                           Foreground="{Binding ValueInk.Showing}" />
                                            </ToggleButton>


                                            <!-- The unit: what the figure is counted in. -->
                                            <ToggleButton x:Name="UnitPart"
                                                          Style="{StaticResource CellPartStyle}"
                                                          AutomationProperties.Name="The unit on this reading"
                                                          ToolTip="Whether the unit is written, and its colour">
                                                <TextBlock Text="{Binding UnitText}"
                                                           FontSize="11"
                                                           Foreground="{Binding UnitInk.Showing}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowUnit}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.35" />
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </ToggleButton>
                                        </controls:SlotRow>

                                            <Popup IsOpen="{Binding IsChecked, ElementName=MarkPart, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=MarkPart}"
                                                   Placement="Bottom"
                                                   VerticalOffset="6"
                                                   StaysOpen="True"
                                                   controls:Flyout.DismissOnOutsideClick="True"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade">
                                                <Border Style="{StaticResource FlyoutStyle}" MinWidth="232" Padding="12,8,12,12">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                            <TextBlock Text="THE MARK"
                                                                       Style="{StaticResource PartHeadStyle}"
                                                                       Margin="0"
                                                                       VerticalAlignment="Center" />

                                                            <Button DockPanel.Dock="Right"
                                                                    Style="{StaticResource PartResetStyle}"
                                                                    Content="Reset"
                                                                    Command="{Binding ResetMarkCommand}"
                                                                    AutomationProperties.Name="Put the mark back"
                                                                    ToolTip="Forget everything chosen for the mark" />
                                                        </DockPanel>

                                                        <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                                  Content="Show the mark"
                                                                  IsChecked="{Binding ShowLabel, Mode=TwoWay}"
                                                                  AutomationProperties.Name="Show the mark" />

                                                        <TextBlock Text="DRAWN AS" Style="{StaticResource PartHeadStyle}" />

                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource PartChoiceStyle}"
                                                                    Command="{Binding MarkAsPictureCommand}"
                                                                    AutomationProperties.Name="Mark this reading with a picture"
                                                                    ToolTip="A picture of the part of the machine this reading is about">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <fluent:SymbolIcon Symbol="{Binding Mark, Converter={StaticResource MarkToSymbol}}"
                                                                                       FontSize="13"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,6,0" />
                                                                    <TextBlock Text="Picture" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>

                                                            <Button Style="{StaticResource PartChoiceStyle}"
                                                                    Command="{Binding MarkAsLettersCommand}"
                                                                    AutomationProperties.Name="Mark this reading with letters"
                                                                    ToolTip="The short name the reader already calls it">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding LabelText}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,6,0" />
                                                                    <TextBlock Text="Letters" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>


                                                        <TextBlock Text="SITS AT" Style="{StaticResource PartHeadStyle}" />

                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource PartChoiceStyle}"
                                                                    Content="Left"
                                                                    Command="{Binding MarkOnTheLeftCommand}"
                                                                    AutomationProperties.Name="Put the mark on the left"
                                                                    ToolTip="Against the left edge of this place on the bar" />

                                                            <Button Style="{StaticResource PartChoiceStyle}"
                                                                    Content="Right"
                                                                    Command="{Binding MarkOnTheRightCommand}"
                                                                    AutomationProperties.Name="Put the mark on the right"
                                                                    ToolTip="Against the right edge of this place on the bar" />
                                                        </StackPanel>

                                                        <ContentControl Content="{Binding MarkInk}"
                                                                        ContentTemplate="{StaticResource InkChoiceTemplate}"
                                                                        Focusable="False" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>

                                            <Popup IsOpen="{Binding IsChecked, ElementName=ValuePart, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=ValuePart}"
                                                   Placement="Bottom"
                                                   VerticalOffset="6"
                                                   StaysOpen="True"
                                                   controls:Flyout.DismissOnOutsideClick="True"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade">
                                                <Border Style="{StaticResource FlyoutStyle}" MinWidth="248" Padding="12,8,12,12">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                            <TextBlock Text="THE READING"
                                                                       Style="{StaticResource PartHeadStyle}"
                                                                       Margin="0"
                                                                       VerticalAlignment="Center" />

                                                            <Button DockPanel.Dock="Right"
                                                                    Style="{StaticResource PartResetStyle}"
                                                                    Content="Reset"
                                                                    Command="{Binding ResetValueCommand}"
                                                                    AutomationProperties.Name="Put the figure back"
                                                                    ToolTip="Forget the units, the size, the weight and the colour chosen here" />
                                                        </DockPanel>

                                                        <controls:Picker Style="{StaticResource PickerStyle}"
                                                                         HorizontalAlignment="Stretch"
                                                                         ItemsSource="{Binding Fields}"
                                                                         ItemTemplate="{StaticResource OptionLabelTemplate}"
                                                                         SelectedValuePath="Value"
                                                                         SelectedValue="{Binding Field, Mode=TwoWay}"
                                                                         AutomationProperties.Name="What this slot shows" />

                                                        <TextBlock Text="COUNTED IN" Style="{StaticResource PartHeadStyle}" />

                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:Picker Style="{StaticResource PickerStyle}"
                                                                             MinWidth="104"
                                                                             Margin="0,0,8,0"
                                                                             ItemsSource="{Binding Families}"
                                                                             ItemTemplate="{StaticResource OptionLabelTemplate}"
                                                                             SelectedValuePath="Family"
                                                                             SelectedValue="{Binding Family, Mode=TwoWay}"
                                                                             AutomationProperties.Name="Bytes or bits" />

                                                            <controls:Picker Style="{StaticResource PickerStyle}"
                                                                             MinWidth="104"
                                                                             ItemsSource="{Binding Scales}"
                                                                             ItemTemplate="{StaticResource OptionLabelTemplate}"
                                                                             SelectedValuePath="Scale"
                                                                             SelectedValue="{Binding Scale, Mode=TwoWay}"
                                                                             AutomationProperties.Name="How far it is scaled" />
                                                        </StackPanel>

                                                        <TextBlock Text="SIZE" Style="{StaticResource PartHeadStyle}" />

                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:Picker Style="{StaticResource PickerStyle}"
                                                                             MinWidth="124"
                                                                             Margin="0,0,10,0"
                                                                             ItemsSource="{Binding TextSizes}"
                                                                             ItemTemplate="{StaticResource OptionLabelTemplate}"
                                                                             SelectedValuePath="Value"
                                                                             SelectedValue="{Binding TextSize, Mode=TwoWay}"
                                                                             AutomationProperties.Name="How large this figure is" />

                                                            <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                                      VerticalAlignment="Center"
                                                                      Content="Bold"
                                                                      IsChecked="{Binding Bold, Mode=TwoWay}"
                                                                      AutomationProperties.Name="Bold" />
                                                        </StackPanel>


                                                        <TextBlock Text="SITS AT" Style="{StaticResource PartHeadStyle}" />

                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource PartChoiceStyle}"
                                                                    Content="Left"
                                                                    Command="{Binding ValueOnTheLeftCommand}"
                                                                    AutomationProperties.Name="Put the figure on the left"
                                                                    ToolTip="Against the left edge of this place on the bar" />

                                                            <Button Style="{StaticResource PartChoiceStyle}"
                                                                    Content="Right"
                                                                    Command="{Binding ValueOnTheRightCommand}"
                                                                    AutomationProperties.Name="Put the figure on the right"
                                                                    ToolTip="Against the right edge of this place on the bar" />
                                                        </StackPanel>

                                                        <ContentControl Content="{Binding ValueInk}"
                                                                        ContentTemplate="{StaticResource InkChoiceTemplate}"
                                                                        Focusable="False" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>

                                            <Popup IsOpen="{Binding IsChecked, ElementName=UnitPart, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=UnitPart}"
                                                   Placement="Bottom"
                                                   VerticalOffset="6"
                                                   StaysOpen="True"
                                                   controls:Flyout.DismissOnOutsideClick="True"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade">
                                                <Border Style="{StaticResource FlyoutStyle}" MinWidth="232" Padding="12,8,12,12">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                            <TextBlock Text="THE UNIT"
                                                                       Style="{StaticResource PartHeadStyle}"
                                                                       Margin="0"
                                                                       VerticalAlignment="Center" />

                                                            <Button DockPanel.Dock="Right"
                                                                    Style="{StaticResource PartResetStyle}"
                                                                    Content="Reset"
                                                                    Command="{Binding ResetUnitCommand}"
                                                                    AutomationProperties.Name="Put the unit back"
                                                                    ToolTip="Forget everything chosen for the unit" />
                                                        </DockPanel>

                                                        <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                                                  Content="Write the unit"
                                                                  IsChecked="{Binding ShowUnit, Mode=TwoWay}"
                                                                  AutomationProperties.Name="Write the unit" />


                                                        <TextBlock Text="SITS AT" Style="{StaticResource PartHeadStyle}" />

                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource PartChoiceStyle}"
                                                                    Content="Left"
                                                                    Command="{Binding UnitOnTheLeftCommand}"
                                                                    AutomationProperties.Name="Put the unit on the left"
                                                                    ToolTip="Against the left edge of this place on the bar" />

                                                            <Button Style="{StaticResource PartChoiceStyle}"
                                                                    Content="Right"
                                                                    Command="{Binding UnitOnTheRightCommand}"
                                                                    AutomationProperties.Name="Put the unit on the right"
                                                                    ToolTip="Against the right edge of this place on the bar" />
                                                        </StackPanel>

                                                        <ContentControl Content="{Binding UnitInk}"
                                                                        ContentTemplate="{StaticResource InkChoiceTemplate}"
                                                                        Focusable="False" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                    </StackPanel>
                                </Border>

                                </Grid>
                            </DataTemplate>

                            <!-- The cell that adds one more of something. -->
                            <DataTemplate DataType="{x:Type vm:MeterGridAddViewModel}">
                                <Button Style="{StaticResource SlotAddStyle}"
                                        Margin="0,0,8,8"
                                        Command="{Binding Add}"
                                        AutomationProperties.Name="{Binding Name}"
                                        ToolTip="Show another reading here">
                                    <TextBlock Text="+" Style="{StaticResource SlotAddSignStyle}" />
                                </Button>
                            </DataTemplate>

                        </ItemsControl.Resources>
                    </ItemsControl>
                    </ScrollViewer>

                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <DockPanel LastChildFill="True">
                    <ToggleButton DockPanel.Dock="Right"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Margin="16,0,0,0"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="Show the meter"
                                  ToolTip="Add the live readings to the Windows taskbar" />

                    <StackPanel VerticalAlignment="Center">
                        <!--
                            Where the meter actually ended up sits behind the
                            mark with the rest, since most of the time it says
                            the obvious: that it went where it was asked.
                        -->
                        <controls:SettingHead
                            Text="Show in the taskbar"
                            Hint="Put live readings on the Windows taskbar. Off by default, and removed the moment Windsock closes."
                            Note="{Binding Status}" />

                        <!--
                            Unless it did not get there. Windows 11 has no
                            supported way in, so the attempt can fail - and a
                            failure nobody is told about is a meter that has
                            simply vanished. That one stays on the page.
                        -->
                        <TextBlock Text="{Binding Status}"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource HotBrush}"
                                   Visibility="{Binding IsWarning, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <DockPanel LastChildFill="True">
                    <controls:Picker DockPanel.Dock="Right"
                                     Style="{StaticResource PickerStyle}"
                                     MinWidth="170"
                                     Margin="16,0,0,0"
                                     VerticalAlignment="Center"
                                     ItemsSource="{Binding Placements}"
                                     ItemTemplate="{StaticResource OptionLabelTemplate}"
                                     SelectedValuePath="Value"
                                     SelectedValue="{Binding Placement, Mode=TwoWay}"
                                     AutomationProperties.Name="Position" />

                    <controls:SettingHead
                        Text="Position"
                        Hint="Inside the taskbar looks native, but Windows has no supported way to add anything there, so an update could stop it working. Above the taskbar always works." />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <DockPanel LastChildFill="True">
                    <controls:Picker DockPanel.Dock="Right"
                                     Style="{StaticResource PickerStyle}"
                                     MinWidth="170"
                                     Margin="16,0,0,0"
                                     VerticalAlignment="Center"
                                     ItemsSource="{Binding Clicks}"
                                     ItemTemplate="{StaticResource OptionLabelTemplate}"
                                     SelectedValuePath="Value"
                                     SelectedValue="{Binding Click, Mode=TwoWay}"
                                     AutomationProperties.Name="On click" />

                    <controls:SettingHead
                        Text="On click"
                        Hint="What happens when the meter is clicked. Hovering always names every reading in full." />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <DockPanel LastChildFill="True">
                    <ToggleButton DockPanel.Dock="Right"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Margin="16,0,0,0"
                                  IsChecked="{Binding FitToContents, Mode=TwoWay}"
                                  AutomationProperties.Name="Fit to contents" />

                    <controls:SettingHead
                        Text="Fit to the readings"
                        Hint="Take exactly the width the figures need. The meter hangs from the notification area, so its width moves only its own left edge - there is nothing to its right to shove sideways." />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FitToContents}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Back to the width it shipped at, once it is not. -->
                        <Button Style="{StaticResource ResetStyle}"
                                Margin="0,0,8,0"
                                Padding="6,0"
                                Command="{Binding ResetWidthCommand}"
                                AutomationProperties.Name="Put the width back"
                                ToolTip="Back to the width the meter shipped at" />

                        <Slider Style="{StaticResource FlatSliderStyle}"
                                Minimum="{x:Static vm:TaskbarPanelViewModel.MinimumWidth}"
                                Maximum="{x:Static vm:TaskbarPanelViewModel.MaximumWidth}"
                                Value="{Binding Width, Mode=TwoWay}"
                                Width="150"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                TickFrequency="2"
                                AutomationProperties.Name="Width" />

                        <TextBlock Text="{Binding Width, StringFormat={}{0:F0} px}"
                                   FontSize="12"
                                   Width="46"
                                   Margin="10,0,0,0"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <controls:SettingHead
                        Text="Fixed width"
                        Hint="Used when the meter is not fitted to its readings." />
                </DockPanel>
            </Border>

            <!--
                A ground of the reader's own, behind the readings only. Last on
                the tab because it is the one setting here most people never
                touch: the bar is acrylic over the wallpaper, and a meter that
                paints nothing looks like part of it. It exists for the bars
                that argument does not cover - an accent-coloured taskbar, or a
                wallpaper busy enough that no text colour is legible over it.
            -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <!-- Back to no ground, once there is one. -->
                        <Button Style="{StaticResource ResetStyle}"
                                Margin="0,0,8,0"
                                Padding="6,0"
                                Command="{Binding ResetGroundCommand}"
                                AutomationProperties.Name="Take the background away"
                                ToolTip="Back to no background, letting the taskbar show through" />

                        <ToggleButton x:Name="GroundButton"
                                      Style="{StaticResource PartToggleStyle}"
                                      MinWidth="118"
                                      AutomationProperties.Name="Choose a background"
                                      ToolTip="Choose a colour to paint behind the readings">
                            <StackPanel Orientation="Horizontal">
                                <!--
                                    The swatch shows the colour at the strength
                                    it is actually drawn, over a chequer so that
                                    a part-strength one reads as part strength
                                    rather than as a paler colour.
                                -->
                                <Border Width="14"
                                        Height="14"
                                        CornerRadius="4"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        Background="{Binding Ground.Showing}"
                                        Visibility="{Binding Ground.IsNone, Converter={StaticResource InverseBooleanToVisibility}}" />

                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Ground.Hex}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ground.IsNone}" Value="True">
                                                    <Setter Property="Text" Value="No background" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsChecked, ElementName=GroundButton, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=GroundButton}"
                               Placement="Bottom"
                               VerticalOffset="6"
                               HorizontalOffset="-60"
                               StaysOpen="True"
                                                   controls:Flyout.DismissOnOutsideClick="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Style="{StaticResource FlyoutStyle}" MinWidth="230" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="BACKGROUND" Style="{StaticResource PartHeadStyle}" />

                                    <Button Style="{StaticResource PartChoiceStyle}"
                                            Content="No background"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,9"
                                            Command="{Binding Ground.PaintCommand}"
                                            AutomationProperties.Name="Paint no background at all"
                                            ToolTip="Let the taskbar show through, which is how it ships" />

                                    <ItemsControl ItemsSource="{Binding Ground.Grounds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource InkStyle}"
                                                        Background="{Binding Converter={StaticResource InkToBrush}}"
                                                        Command="{Binding DataContext.Ground.PaintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding}"
                                                        ToolTip="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--
                                        Any colour at all, for when none of the
                                        eight is the one in mind. Dragged or
                                        typed, the same way a cell's parts are:
                                        a reader who knows the colour writes it
                                        down, one who does not slides until it
                                        looks right.
                                    -->
                                    <TextBlock Text="MIX A COLOUR" Style="{StaticResource PartHeadStyle}" Margin="0,6,0,0" />

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="R"
                                                   Style="{StaticResource MixLabelStyle}" />
                                        <Slider Grid.Row="0" Grid.Column="1"
                                                Style="{StaticResource FlatSliderStyle}"
                                                Minimum="0" Maximum="255"
                                                Value="{Binding Ground.Red, Mode=TwoWay}"
                                                AutomationProperties.Name="How much red is in the background" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="G"
                                                   Style="{StaticResource MixLabelStyle}" />
                                        <Slider Grid.Row="1" Grid.Column="1"
                                                Style="{StaticResource FlatSliderStyle}"
                                                Minimum="0" Maximum="255"
                                                Value="{Binding Ground.Green, Mode=TwoWay}"
                                                AutomationProperties.Name="How much green is in the background" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="B"
                                                   Style="{StaticResource MixLabelStyle}" />
                                        <Slider Grid.Row="2" Grid.Column="1"
                                                Style="{StaticResource FlatSliderStyle}"
                                                Minimum="0" Maximum="255"
                                                Value="{Binding Ground.Blue, Mode=TwoWay}"
                                                AutomationProperties.Name="How much blue is in the background" />
                                    </Grid>

                                    <!-- Written down, for a colour already known. -->
                                    <TextBox Text="{Binding Ground.Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,4,0,0"
                                             AutomationProperties.Name="The background as a colour code"
                                             ToolTip="The background written down, as #AARRGGBB" />

                                    <!--
                                        The control most of this is here for. A
                                        ground at full opacity hides the bar; one
                                        at part opacity lifts the figures off the
                                        wallpaper and still lets the acrylic
                                        through. In percent, because that is the
                                        unit people think in - the byte a colour
                                        is written with is not the reader's
                                        problem.
                                    -->
                                    <DockPanel Margin="0,10,0,0" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Ground.Opacity, StringFormat={}{0:F0}%}"
                                                   Width="38"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                        <TextBlock Text="OPACITY" Style="{StaticResource PartHeadStyle}" />
                                    </DockPanel>

                                    <Slider Minimum="0"
                                            Maximum="100"
                                            Value="{Binding Ground.Opacity, Mode=TwoWay}"
                                            AutomationProperties.Name="How solid the background is, in percent"
                                            ToolTip="How solid the background is, from clear through to fully opaque">
                                        <Slider.Style>
                                            <!--
                                                Greyed while there is no ground,
                                                because an opacity with nothing
                                                to apply it to is a control that
                                                appears to do nothing.
                                            -->
                                            <Style TargetType="Slider" BasedOn="{StaticResource FlatSliderStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ground.IsNone}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.35" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>

                                    <!--
                                        Shapes the ground and the wash under the
                                        pointer together: they are one surface
                                        seen twice, and a rounded highlight over
                                        a square ground would read as a mistake.
                                    -->
                                    <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Corner, StringFormat={}{0:F0} px}"
                                                   Width="44"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource ResetStyle}"
                                                Margin="0,0,6,0"
                                                Padding="6,0"
                                                Command="{Binding ResetCornerCommand}"
                                                AutomationProperties.Name="Put the roundness back"
                                                ToolTip="Back to the roundness the meter shipped with" />

                                        <TextBlock Text="ROUNDNESS" Style="{StaticResource PartHeadStyle}" />
                                    </DockPanel>

                                    <Slider Style="{StaticResource FlatSliderStyle}"
                                            Minimum="{x:Static vm:TaskbarPanelViewModel.MinimumCorner}"
                                            Maximum="{x:Static vm:TaskbarPanelViewModel.MaximumCorner}"
                                            Value="{Binding Corner, Mode=TwoWay}"
                                            AutomationProperties.Name="How rounded the meter corners are"
                                            ToolTip="How rounded the meter surface is, from square to fully rounded ends" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <controls:SettingHead
                        Text="Background"
                        Hint="Paint a colour behind the readings, so they stay legible over an accent-coloured taskbar or a busy wallpaper. Off by default: the bar is acrylic over whatever is behind it, and a meter that paints nothing of its own is the one that always looks like part of it."
                        Note="Strength decides how much of the taskbar still shows through." />
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

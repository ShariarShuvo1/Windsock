<UserControl x:Class="Windsock.App.Views.AppsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Windsock.App.Controls"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Windsock.App.ViewModels"
             xmlns:views="clr-namespace:Windsock.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppsPanelViewModel}"
             d:DesignWidth="880"
             d:DesignHeight="700">

    <UserControl.Resources>
        <!--
            A rate cell says on hover what its figure is: measured each second,
            or Windows' count for the whole app over the last five minutes. The
            two look alike in a table and mean different things.
        -->
        <Style x:Key="RateCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="ToolTip" Value="{Binding RateSource}" />
        </Style>

        <!-- Each rate cell says its figure, and a dash as "not known" (SpokenDash). -->
        <Style x:Key="SendCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource RateCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding SendText, Converter={StaticResource SpokenDash}}" />
        </Style>

        <Style x:Key="ReceiveCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource RateCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding ReceiveText, Converter={StaticResource SpokenDash}}" />
        </Style>

        <Style x:Key="TotalCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource RateCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding TotalText, Converter={StaticResource SpokenDash}}" />
        </Style>

        <Style x:Key="RecentCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding RecentText, Converter={StaticResource SpokenDash}}" />
        </Style>

        <!--
            A cell drawn by a template has no text of its own, so the grid would
            name it "Item: ..., Column Display Index: n". Each such column names
            its cells by what they show.
        -->
        <Style x:Key="LiveNameCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        </Style>

        <Style x:Key="LivePathCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding FilePath}" />
        </Style>

        <Style x:Key="LivePublisherCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Publisher, Converter={StaticResource SpokenDash}}" />
        </Style>

        <Style x:Key="LiveMenuCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName, StringFormat='Row actions for {0}'}" />
        </Style>

        <Style x:Key="TotalsNameCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>

        <Style x:Key="TotalsPathCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding FilePath}" />
        </Style>

        <Style x:Key="TotalsMenuCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat='Row actions for {0}'}" />
        </Style>

        <!--
            The app's picture beside its name. Windows' own buckets - System, and
            traffic it could not put to any app - read quieter, since they are
            not something anybody runs.
        -->
        <DataTemplate x:Key="AppNameTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center">
                    <Path Data="M 0.5 1.5 H 11.5 V 10.5 H 0.5 Z M 0.5 4 H 11.5"
                          Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                          StrokeThickness="1"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          SnapsToDevicePixels="True">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <controls:IconImage Source="{Binding Icon}"
                           Width="16"
                           Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>

                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource TextSize12_5}"
                           Text="{Binding Name}"
                           ToolTip="{Binding FilePath}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBucket}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Every app on the network. Live, it is what is talking now and how much
        each is moving; where they connect is on the Map page beside this one.
        Any other period is history: Windows' own count of each app, kept a
        minute at a time, including time Windsock was not running.
    -->
    <controls:SectionPage Title="Apps" Subtitle="{Binding Subtitle}">
        <controls:SectionPage.Actions>
            <controls:FlowRow Spacing="8" LineSpacing="8">
                <controls:Picker Style="{StaticResource PickerStyle}"
                                 MinWidth="132"
                                 ItemsSource="{Binding Periods}"
                                 ItemTemplate="{StaticResource OptionLabelTemplate}"
                                 SelectedValuePath="Period"
                                 SelectedValue="{Binding SelectedPeriod, Mode=TwoWay}"
                                 AutomationProperties.Name="Period"
                                 ToolTip="What is happening now, or a stretch of time to total up" />

                <!--
                    The page's one Pause, last among its actions as on every
                    live page. A verb, not a state: the reader is told what
                    pressing it does.
                -->
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding Live.ToggleLiveCommand}"
                        AutomationProperties.Name="{Binding Live.LiveLabel}"
                        ToolTip="Hold the table still so it can be read. Nothing stops being measured while it is paused."
                        Visibility="{Binding IsLivePeriod, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <fluent:SymbolIcon FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0">
                            <fluent:SymbolIcon.Style>
                                <Style TargetType="fluent:SymbolIcon">
                                    <Setter Property="Symbol" Value="PauseCircle" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Live.IsLive}" Value="False">
                                            <Setter Property="Symbol" Value="PlayCircle" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fluent:SymbolIcon.Style>
                        </fluent:SymbolIcon>

                        <TextBlock Text="{Binding Live.LiveLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:FlowRow>
        </controls:SectionPage.Actions>

        <Grid>
            <!--
                LIVE. One scroller around the whole view, held to at least its
                height so the table's band fills what is left; the table has no
                scroller of its own, because one region that scrolls is one
                gesture. The map that used to sit above the table has a page of
                its own now, Network › Map.
            -->
            <ScrollViewer x:Name="LiveBody"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="{StaticResource PagePadding}"
                          Visibility="{Binding IsLivePeriod, Converter={StaticResource BooleanToVisibility}}">
                <Grid DataContext="{Binding Live}" MinHeight="{Binding ViewportHeight, ElementName=LiveBody}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        What the rates are, when each process is not measured:
                        Windows' own count for each app over the last five
                        minutes. First on the page, because it is a standing fact
                        about all of it.
                    -->
                    <Border Grid.Row="0"
                            Style="{StaticResource NoticeStyle}"
                            Visibility="{Binding RateNotice, Converter={StaticResource TextToVisibility}}">
                        <DockPanel LastChildFill="True" MinHeight="30">
                            <fluent:SymbolIcon DockPanel.Dock="Left"
                                               Symbol="Info"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentBrush}" />

                            <!-- The button drops under the sentence rather than squeezing it to a word a line. -->
                            <controls:AdaptiveRow Breakpoint="0" Spacing="8" LeadFills="True" LeadMinimumWidth="220" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RateNotice}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource TextSize12_5}"
                                           ToolTip="{Binding RateDetail}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                <!--
                                    Named, and for a stronger reason than most:
                                    pressing it asks Windows for consent and
                                    restarts the app, and a button that does that
                                    must not announce itself as "button".
                                -->
                                <Button x:Name="ElevateButton"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Command="{Binding RestartElevatedCommand}"
                                        AutomationProperties.Name="Restart as administrator"
                                        AutomationProperties.HelpText="Closes Windsock and starts it again with administrator rights, after asking Windows for consent. Measuring each second and showing each process need that; nothing else does."
                                        ToolTip="Restart with administrator rights, so each app and each process is measured every second"
                                        Visibility="{Binding CanElevate, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <fluent:SymbolIcon Symbol="Shield"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,7,0" />
                                        <TextBlock Text="Restart as administrator" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </controls:AdaptiveRow>
                        </DockPanel>
                    </Border>

                    <!-- The table and what narrows it, on one band. -->
                    <Border Grid.Row="1" Style="{StaticResource FlushBandStyle}" MinHeight="220">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <controls:FlowRow Grid.Row="0" Margin="20,16,16,10" Spacing="8" LineSpacing="8">
                                <TextBox Style="{StaticResource SearchBoxStyle}"
                                         MinWidth="200"
                                         MaxWidth="340"
                                         controls:FlowRow.Fill="True"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{Binding SearchName}"
                                         ToolTip="Matches the name, description, path or id" />

                                <controls:FlowRow Spacing="8" LineSpacing="8">
                                    <!-- Only the process view has names to share. -->
                                    <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                              Content="Group"
                                              IsChecked="{Binding IsGrouped, Mode=TwoWay}"
                                              ToolTip="Collect processes that share a name under one row"
                                              Visibility="{Binding IsProcessView, Converter={StaticResource BooleanToVisibility}}" />

                                    <CheckBox Style="{StaticResource ToolbarCheckStyle}"
                                              Content="Active only"
                                              IsChecked="{Binding ActiveOnly, Mode=TwoWay}"
                                              ToolTip="Hide rows that are not moving anything right now" />

                                    <Button Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding ResetViewCommand}"
                                            Visibility="{Binding IsCustomised, Converter={StaticResource BooleanToVisibility}}"
                                            ToolTip="Put the search, filters, columns and sort back to their defaults">
                                        <StackPanel Orientation="Horizontal">
                                            <fluent:SymbolIcon Symbol="ArrowReset"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,7,0" />
                                            <TextBlock Text="Reset view" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </controls:FlowRow>

                                <!--
                                    What the rows are, then which columns they
                                    show: both about the table, so both on it.
                                -->
                                <controls:FlowRow controls:FlowRow.Trailing="True" Spacing="8" LineSpacing="8">
                                    <!--
                                        Apps or processes. Only in the full edition;
                                        greyed out, with the reason on hover, while
                                        nothing measures each process - the notice
                                        above the table offers the way to.
                                    -->
                                    <controls:Picker x:Name="ViewPicker"
                                                     Style="{StaticResource PickerStyle}"
                                                     MinWidth="118"
                                                     ItemsSource="{Binding Views}"
                                                     ItemTemplate="{StaticResource OptionLabelTemplate}"
                                                     SelectedValuePath="Processes"
                                                     SelectedValue="{Binding ChosenView, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanShowProcesses}"
                                                     ToolTipService.ShowOnDisabled="True"
                                                     ToolTip="{Binding ViewSwitchHint}"
                                                     AutomationProperties.Name="Show apps or processes" />

                                    <!-- One item with its popup, so the popup takes no gap of its own. -->
                                    <Grid>
                                        <ToggleButton x:Name="LiveColumnsButton"
                                                      Style="{StaticResource ToolbarButtonStyle}"
                                                      ToolTip="Choose which columns are shown"
                                                      AutomationProperties.Name="Choose columns">
                                            <StackPanel Orientation="Horizontal">
                                                <fluent:SymbolIcon Symbol="ColumnTriple"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,7,0" />
                                                <TextBlock Text="Columns" VerticalAlignment="Center" />
                                                <Path Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                                      StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Margin="7,1,0,0"
                                                      VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>

                                        <Popup IsOpen="{Binding IsChecked, ElementName=LiveColumnsButton, Mode=TwoWay}"
                                               controls:Flyout.MovesFocus="True"
                                               PlacementTarget="{Binding ElementName=LiveColumnsButton}"
                                               Placement="Bottom"
                                               VerticalOffset="6"
                                               HorizontalOffset="-90"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Style="{StaticResource FlyoutStyle}" MinWidth="210" Padding="6">
                                                <ScrollViewer MaxHeight="360"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding Columns}"
                                                                  Focusable="False"
                                                                  ItemTemplate="{StaticResource ColumnChoiceTemplate}" />
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </controls:FlowRow>
                            </controls:FlowRow>

                            <!--
                                Every column carries a width in pixels rather than a
                                share of the table, so each resizes on its own.
                            -->
                            <DataGrid x:Name="LiveTable"
                                      Grid.Row="1"
                                      Margin="8,0,8,8"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      Style="{StaticResource TableStyle}"
                                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                                      RowStyle="{StaticResource ProcessRowStyle}"
                                      CellStyle="{StaticResource TableCellStyle}"
                                      ItemsSource="{Binding Rows}"
                                      AutomationProperties.Name="Apps using the network">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn x:Name="LiveNameColumn"
                                                            CellTemplate="{StaticResource ProcessNameTemplate}"
                                                            CellStyle="{StaticResource LiveNameCellStyle}"
                                                            SortMemberPath="DisplayName"
                                                            Width="260"
                                                            MinWidth="140" />

                                    <DataGridTextColumn x:Name="LiveDescriptionColumn"
                                                        Binding="{Binding Description}"
                                                        SortMemberPath="Description"
                                                        Width="220"
                                                        MinWidth="140"
                                                        ElementStyle="{StaticResource TableQuietTextStyle}" />

                                    <DataGridTextColumn x:Name="LiveProcessIdColumn"
                                                        Binding="{Binding ProcessIdText}"
                                                        SortMemberPath="ProcessId"
                                                        Width="78"
                                                        MinWidth="70"
                                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                                    <DataGridTextColumn x:Name="LiveSendColumn"
                                                        Binding="{Binding SendText}"
                                                        CellStyle="{StaticResource SendCellStyle}"
                                                        SortMemberPath="SendBytesPerSecond"
                                                        Width="118"
                                                        MinWidth="88"
                                                        ElementStyle="{StaticResource TableSendStyle}" />

                                    <DataGridTextColumn x:Name="LiveReceiveColumn"
                                                        Binding="{Binding ReceiveText}"
                                                        CellStyle="{StaticResource ReceiveCellStyle}"
                                                        SortMemberPath="ReceiveBytesPerSecond"
                                                        Width="118"
                                                        MinWidth="88"
                                                        ElementStyle="{StaticResource TableReceiveStyle}" />

                                    <DataGridTextColumn x:Name="LiveTotalColumn"
                                                        Binding="{Binding TotalText}"
                                                        CellStyle="{StaticResource TotalCellStyle}"
                                                        SortMemberPath="TotalBytesPerSecond"
                                                        Width="118"
                                                        MinWidth="88"
                                                        ElementStyle="{StaticResource TableNumberStyle}" />

                                    <DataGridTextColumn x:Name="LiveConnectionColumn"
                                                        Binding="{Binding Connections}"
                                                        SortMemberPath="Connections"
                                                        Width="98"
                                                        MinWidth="82"
                                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                                    <DataGridTextColumn x:Name="LiveTcpColumn"
                                                        Binding="{Binding TcpConnections}"
                                                        SortMemberPath="TcpConnections"
                                                        Width="76"
                                                        MinWidth="66"
                                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                                    <DataGridTextColumn x:Name="LiveUdpColumn"
                                                        Binding="{Binding UdpEndpoints}"
                                                        SortMemberPath="UdpEndpoints"
                                                        Width="76"
                                                        MinWidth="66"
                                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                                    <DataGridTextColumn x:Name="LivePacketColumn"
                                                        Binding="{Binding PacketsText}"
                                                        SortMemberPath="PacketsPerSecond"
                                                        Width="104"
                                                        MinWidth="92"
                                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                                    <DataGridTextColumn x:Name="LiveSentColumn"
                                                        Binding="{Binding SentText}"
                                                        SortMemberPath="BytesSent"
                                                        Width="112"
                                                        MinWidth="88"
                                                        ElementStyle="{StaticResource TableNumberStyle}" />

                                    <DataGridTextColumn x:Name="LiveReceivedColumn"
                                                        Binding="{Binding ReceivedText}"
                                                        SortMemberPath="BytesReceived"
                                                        Width="112"
                                                        MinWidth="88"
                                                        ElementStyle="{StaticResource TableNumberStyle}" />

                                    <DataGridTextColumn x:Name="LiveTransferredColumn"
                                                        Binding="{Binding TransferredText}"
                                                        SortMemberPath="BytesTransferred"
                                                        Width="128"
                                                        MinWidth="104"
                                                        ElementStyle="{StaticResource TableNumberStyle}" />

                                    <DataGridTextColumn x:Name="LiveUptimeColumn"
                                                        Binding="{Binding UptimeText}"
                                                        SortMemberPath="UptimeSeconds"
                                                        Width="104"
                                                        MinWidth="84"
                                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                                    <DataGridTemplateColumn x:Name="LivePathColumn"
                                                            CellStyle="{StaticResource LivePathCellStyle}"
                                                            SortMemberPath="FilePath"
                                                            Width="340"
                                                            MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PathLinkStyle}"
                                                        Content="{Binding FilePath}"
                                                        Command="{Binding Owner.RevealCommand}"
                                                        CommandParameter="{Binding FilePath}"
                                                        ToolTip="{Binding FilePath}"
                                                        AutomationProperties.Name="{Binding FilePath, StringFormat='Show {0} in Explorer'}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--
                                        Who signed each program, checked on this PC
                                        with nothing sent. A mark beside an unsigned
                                        program talking to the network, and another
                                        when it reaches an address on a blocklist the
                                        person switched on.
                                    -->
                                    <DataGridTemplateColumn x:Name="LivePublisherColumn"
                                                            CellStyle="{StaticResource LivePublisherCellStyle}"
                                                            SortMemberPath="Publisher"
                                                            Width="180"
                                                            MinWidth="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0">
                                                    <fluent:SymbolIcon Symbol="ShieldError"
                                                                       FontSize="14"
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource HotBrush}"
                                                                       ToolTip="{Binding ListedNote}"
                                                                       AutomationProperties.Name="{Binding ListedNote}"
                                                                       Visibility="{Binding IsListed, Converter={StaticResource BooleanToVisibility}}" />
                                                    <fluent:SymbolIcon Symbol="Warning"
                                                                       FontSize="13"
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource HotBrush}"
                                                                       ToolTip="Not signed, or signed in a way that does not hold, and using the network"
                                                                       AutomationProperties.Name="Unsigned and using the network"
                                                                       Visibility="{Binding IsFlagged, Converter={StaticResource BooleanToVisibility}}" />
                                                    <TextBlock Text="{Binding Publisher}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="{DynamicResource TextSize12_5}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               ToolTip="{Binding SignatureNote}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--
                                        Row actions. Double-clicking a row opens the
                                        same window, but a gesture nobody can see is
                                        not a way to offer a feature.
                                    -->
                                    <DataGridTemplateColumn Width="44"
                                                            MinWidth="44"
                                                            CanUserSort="False"
                                                            CanUserResize="False"
                                                            CanUserReorder="False"
                                                            CellStyle="{StaticResource LiveMenuCellStyle}"
                                                            HeaderStyle="{StaticResource ActionsHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Named for its row: forty buttons all called "Row actions" are one name to a screen reader. -->
                                                <ToggleButton x:Name="RowMenu"
                                                              Style="{StaticResource RowMenuStyle}"
                                                              Tag="{Binding Owner}"
                                                              AutomationProperties.Name="{Binding DisplayName, StringFormat='Row actions for {0}'}"
                                                              ToolTip="More for this row (the context-menu key or Shift+F10 opens it too)">
                                                    <Grid>
                                                        <StackPanel Orientation="Vertical"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </StackPanel>

                                                        <Popup IsOpen="{Binding IsChecked, ElementName=RowMenu, Mode=TwoWay}"
                                                               controls:Flyout.MovesFocus="True"
                                                               PlacementTarget="{Binding ElementName=RowMenu}"
                                                               Placement="Bottom"
                                                               HorizontalOffset="-150"
                                                               VerticalOffset="4"
                                                               StaysOpen="False"
                                                               AllowsTransparency="True"
                                                               PopupAnimation="Fade">
                                                            <Border Style="{StaticResource FlyoutStyle}"
                                                                    MinWidth="176"
                                                                    Padding="4">
                                                                <StackPanel>
                                                                    <Button Style="{StaticResource MenuItemStyle}"
                                                                            Content="Open details"
                                                                            Command="{Binding Tag.WatchCommand, ElementName=RowMenu}"
                                                                            CommandParameter="{Binding}"
                                                                            IsEnabled="{Binding CanOpenDetails}"
                                                                            AutomationProperties.Name="Open details"
                                                                            ToolTip="Open a window showing what this is connected to" />

                                                                    <Button Style="{StaticResource MenuItemStyle}"
                                                                            Content="{Binding PinLabel}"
                                                                            Command="{Binding Tag.TogglePinCommand, ElementName=RowMenu}"
                                                                            CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="{Binding PinLabel}"
                                                                            ToolTip="Hold this row at the top of the table. Right-clicking a row does the same." />

                                                                    <Button Style="{StaticResource MenuItemStyle}"
                                                                            Content="Look up on VirusTotal…"
                                                                            Command="{Binding Tag.CheckReputationCommand, ElementName=RowMenu}"
                                                                            CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="Look up on VirusTotal"
                                                                            ToolTip="Send this program's hash, and nothing else, to VirusTotal with your own key. You are asked first." />

                                                                    <Button Style="{StaticResource MenuItemStyle}"
                                                                            Content="Block or unblock…"
                                                                            Command="{Binding Tag.ToggleBlockCommand, ElementName=RowMenu}"
                                                                            CommandParameter="{Binding}"
                                                                            Visibility="{x:Static vm:LiveAppsViewModel.FirewallMenuVisibility}"
                                                                            AutomationProperties.Name="Block or unblock in Windows Firewall"
                                                                            ToolTip="Block this program from the network with a Windows Firewall rule, or remove Windsock's block. Needs administrator rights; you are asked first." />

                                                                    <Button Style="{StaticResource MenuItemStyle}"
                                                                            Content="End…"
                                                                            Command="{Binding Tag.EndAppCommand, ElementName=RowMenu}"
                                                                            CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="End this app"
                                                                            ToolTip="Stop every process of this app at once. You are asked first; anything unsaved in it is lost." />
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1"
                                        Style="{StaticResource EmptyStateStyle}"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource EmptyTitleStyle}" />
                                <TextBlock Text="{Binding EmptyNote}" Style="{StaticResource EmptyNoteStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!--
                A PERIOD. Windows' own count of each app over the stretch chosen,
                kept in Windsock's history, so it needs no privilege and covers
                time Windsock was not running. What the period came to leads, on
                the page itself; the apps that make it up follow on a band.
            -->
            <ScrollViewer x:Name="TotalsBody"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="{StaticResource PagePadding}"
                          Visibility="{Binding IsLivePeriod, Converter={StaticResource InverseBooleanToVisibility}}">
                <Grid DataContext="{Binding Totals}" MinHeight="{Binding ViewportHeight, ElementName=TotalsBody}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Why the figures are not being kept, while they are not. -->
                    <Border Grid.Row="0"
                            Style="{StaticResource NoticeStyle}"
                            Visibility="{Binding Notice, Converter={StaticResource TextToVisibility}}">
                        <DockPanel LastChildFill="True">
                            <fluent:SymbolIcon DockPanel.Dock="Left"
                                               Symbol="Info"
                                               FontSize="15"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Notice}"
                                       FontSize="{DynamicResource TextSize12_5}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </Border>

                    <!-- What the period came to, before the apps that make it up: plates on the page. -->
                    <controls:FlowGrid Grid.Row="1" Style="{StaticResource PlateStripStyle}" MinimumColumnWidth="160">
                        <Border Style="{StaticResource PlateCellStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fluent:SymbolIcon Symbol="ArrowDownload"
                                                       FontSize="13"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DownloadBrush}" />
                                    <TextBlock Text="DOWNLOADED" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource StatValueStyle}" FontSize="{DynamicResource TextSize24}" AutomationProperties.Name="Downloaded">
                                    <Run Text="{Binding DownloadValue, Mode=OneWay}" />
                                    <Run Text="{Binding DownloadUnit, Mode=OneWay}"
                                         FontSize="{DynamicResource TextSize14}"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>

                                <TextBlock Text="Every app together" Style="{StaticResource StatNoteStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PlateCellStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fluent:SymbolIcon Symbol="ArrowUpload"
                                                       FontSize="13"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource UploadBrush}" />
                                    <TextBlock Text="UPLOADED" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource StatValueStyle}" FontSize="{DynamicResource TextSize24}" AutomationProperties.Name="Uploaded">
                                    <Run Text="{Binding UploadValue, Mode=OneWay}" />
                                    <Run Text="{Binding UploadUnit, Mode=OneWay}"
                                         FontSize="{DynamicResource TextSize14}"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>

                                <TextBlock Text="Every app together" Style="{StaticResource StatNoteStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PlateCellStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fluent:SymbolIcon Symbol="Apps"
                                                       FontSize="13"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="APPS" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding AppsText}"
                                           Style="{StaticResource StatValueStyle}"
                                           FontSize="{DynamicResource TextSize24}"
                                           AutomationProperties.Name="Apps" />

                                <TextBlock Text="{Binding TopText}" Style="{StaticResource StatNoteStyle}" />
                            </StackPanel>
                        </Border>
                    </controls:FlowGrid>

                    <StackPanel Grid.Row="2" Margin="4,10,4,0">
                        <TextBlock Text="{Binding FreshnessText}" Style="{StaticResource CardNoteStyle}" />
                        <TextBlock Style="{StaticResource CardNoteStyle}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="Windows counts each program by its file and each Store app by its package, over all the networks this PC has used. It keeps about a week of it, so days before that show only what Windsock collected at the time."
                                   Visibility="{Binding ReachesPastWindows, Converter={StaticResource BooleanToVisibility}}" />

                        <!--
                            Windows Update and Delivery Optimization this month,
                            which Windows' per-app count files under no app at all.
                            Its own view model, set from the code behind.
                        -->
                        <views:UpdateShareBand x:Name="UpdateBand" Margin="-4,12,-4,0" />
                    </StackPanel>

                    <!--
                        One app over time, opened from a row's menu: what Windsock
                        measured of it and what Windows counted, step by step.
                    -->
                    <Border x:Name="TimelineBand"
                            Grid.Row="3"
                            Style="{StaticResource BandStyle}"
                            Margin="{StaticResource BandGap}"
                            DataContext="{Binding Timeline}"
                            Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Padding="8,0"
                                        VerticalAlignment="Top"
                                        Command="{Binding CloseCommand}"
                                        AutomationProperties.Name="Close the app's history"
                                        ToolTip="Close">
                                    <fluent:SymbolIcon Symbol="Dismiss" FontSize="14" />
                                </Button>
                                <controls:Picker DockPanel.Dock="Right"
                                                 Style="{StaticResource PickerStyle}"
                                                 MinWidth="140"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Top"
                                                 ItemsSource="{Binding Spans}"
                                                 ItemTemplate="{StaticResource OptionLabelTemplate}"
                                                 SelectedValuePath="Value"
                                                 SelectedValue="{Binding Span, Mode=TwoWay}"
                                                 AutomationProperties.Name="How far back" />
                                <controls:IconImage DockPanel.Dock="Left" Source="{Binding AppIcon}" Width="20" Height="20" Margin="0,2,10,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel>
                                    <TextBlock Text="{Binding AppName}" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Style="{StaticResource CardNoteStyle}">
                                        <Run Text="{Binding TotalText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Run Text=" in all · " />
                                        <Run Text="{Binding MeasuredText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding WindowsText}" Style="{StaticResource CardNoteStyle}" Visibility="{Binding WindowsText, Converter={StaticResource TextToVisibility}}" />
                                </StackPanel>
                            </DockPanel>

                            <Grid>
                                <controls:BarSeriesChart x:Name="TimelineChart"
                                                         Height="170"
                                                         Items="{Binding Bars}"
                                                         PrimaryBrush="{DynamicResource DownloadBrush}"
                                                         SecondaryBrush="{DynamicResource UploadBrush}"
                                                         TrackBrush="{DynamicResource MeterTrackBrush}"
                                                         GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                         AxisBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                         HighlightBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                         FocusVisualStyle="{StaticResource FocusRingStyle}"
                                                         AutomationProperties.Name="{Binding AppName, StringFormat=Usage over time of {0}}" />
                                <StackPanel Style="{StaticResource EmptyStateStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Text="Nothing measured or counted for this app in this stretch" Style="{StaticResource EmptyTitleStyle}" />
                                    <TextBlock Text="Windows keeps about a week of its own figures; what Windsock measures is kept for good. Choose a longer stretch." Style="{StaticResource EmptyNoteStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SelectedDetail, ElementName=TimelineChart}"
                                       Margin="58,6,0,0"
                                       FontSize="{DynamicResource TextSize12}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" controls:LiveRegion.Speaks="True"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding BusiestText}"
                                       Margin="58,4,0,0"
                                       FontSize="{DynamicResource TextSize12}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Download and upload are what Windsock measured; the faint part is what Windows counted while Windsock was not measuring. Point at a bar, or reach the chart with Tab and move with the arrow keys."
                                       Margin="58,8,0,0"
                                       FontSize="{DynamicResource TextSize11_5}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource FlushBandStyle}" Margin="{StaticResource BandGap}" MinHeight="220">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <controls:FlowRow Grid.Row="0" Margin="20,16,16,10" Spacing="8" LineSpacing="8">
                                <TextBox Style="{StaticResource SearchBoxStyle}"
                                         MinWidth="200"
                                         MaxWidth="340"
                                         controls:FlowRow.Fill="True"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Search apps"
                                         ToolTip="Matches the app's name, kind or path" />

                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding ResetViewCommand}"
                                        Visibility="{Binding IsCustomised, Converter={StaticResource BooleanToVisibility}}"
                                        ToolTip="Put the search, filters, columns and sort back to their defaults">
                                    <StackPanel Orientation="Horizontal">
                                        <fluent:SymbolIcon Symbol="ArrowReset"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,7,0" />
                                        <TextBlock Text="Reset view" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Grid controls:FlowRow.Trailing="True">
                                    <ToggleButton x:Name="TotalsColumnsButton"
                                                  Style="{StaticResource ToolbarButtonStyle}"
                                                  ToolTip="Choose which columns are shown"
                                                  AutomationProperties.Name="Choose columns">
                                        <StackPanel Orientation="Horizontal">
                                            <fluent:SymbolIcon Symbol="ColumnTriple"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,7,0" />
                                            <TextBlock Text="Columns" VerticalAlignment="Center" />
                                            <Path Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                                  StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Margin="7,1,0,0"
                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <Popup IsOpen="{Binding IsChecked, ElementName=TotalsColumnsButton, Mode=TwoWay}"
                                           controls:Flyout.MovesFocus="True"
                                           PlacementTarget="{Binding ElementName=TotalsColumnsButton}"
                                           Placement="Bottom"
                                           VerticalOffset="6"
                                           HorizontalOffset="-90"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Style="{StaticResource FlyoutStyle}" MinWidth="210" Padding="6">
                                            <ScrollViewer MaxHeight="360"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Columns}"
                                                              Focusable="False"
                                                              ItemTemplate="{StaticResource ColumnChoiceTemplate}" />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </controls:FlowRow>

                            <DataGrid x:Name="TotalsTable"
                                      Grid.Row="1"
                                      Margin="8,0,8,8"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      Style="{StaticResource TableStyle}"
                                      ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                                      RowStyle="{StaticResource TableRowStyle}"
                                      CellStyle="{StaticResource TableCellStyle}"
                                      ItemsSource="{Binding Rows}"
                                      AutomationProperties.Name="Apps that used the network in this period">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn x:Name="TotalsNameColumn"
                                                            CellTemplate="{StaticResource AppNameTemplate}"
                                                            CellStyle="{StaticResource TotalsNameCellStyle}"
                                                            SortMemberPath="Name"
                                                            Width="260"
                                                            MinWidth="140" />

                                    <DataGridTextColumn x:Name="TotalsKindColumn"
                                                        Binding="{Binding KindText}"
                                                        SortMemberPath="KindText"
                                                        Width="110"
                                                        MinWidth="80"
                                                        ElementStyle="{StaticResource TableQuietTextStyle}" />

                                    <DataGridTextColumn x:Name="TotalsDownloadColumn"
                                                        Binding="{Binding DownloadText}"
                                                        SortMemberPath="BytesReceived"
                                                        Width="112"
                                                        MinWidth="88"
                                                        ElementStyle="{StaticResource TableReceiveStyle}" />

                                    <DataGridTextColumn x:Name="TotalsUploadColumn"
                                                        Binding="{Binding UploadText}"
                                                        SortMemberPath="BytesSent"
                                                        Width="112"
                                                        MinWidth="88"
                                                        ElementStyle="{StaticResource TableSendStyle}" />

                                    <DataGridTextColumn x:Name="TotalsTotalColumn"
                                                        Binding="{Binding TotalText}"
                                                        SortMemberPath="BytesTotal"
                                                        Width="112"
                                                        MinWidth="88"
                                                        ElementStyle="{StaticResource TableNumberStyle}" />

                                    <DataGridTextColumn x:Name="TotalsShareColumn"
                                                        Binding="{Binding ShareText}"
                                                        SortMemberPath="Share"
                                                        Width="84"
                                                        MinWidth="70"
                                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                                    <DataGridTextColumn x:Name="TotalsRecentColumn"
                                                        Binding="{Binding RecentText}"
                                                        CellStyle="{StaticResource RecentCellStyle}"
                                                        SortMemberPath="RecentRate"
                                                        Width="118"
                                                        MinWidth="96"
                                                        ElementStyle="{StaticResource TableQuietNumberStyle}" />

                                    <DataGridTemplateColumn x:Name="TotalsPathColumn"
                                                            CellStyle="{StaticResource TotalsPathCellStyle}"
                                                            SortMemberPath="FilePath"
                                                            Width="340"
                                                            MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PathLinkStyle}"
                                                        Content="{Binding FilePath}"
                                                        Command="{Binding DataContext.RevealCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanReveal}"
                                                        ToolTip="{Binding FilePath}"
                                                        AutomationProperties.Name="{Binding FilePath, StringFormat='Show {0} in Explorer'}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="44"
                                                            MinWidth="44"
                                                            CanUserSort="False"
                                                            CanUserResize="False"
                                                            CanUserReorder="False"
                                                            CellStyle="{StaticResource TotalsMenuCellStyle}"
                                                            HeaderStyle="{StaticResource ActionsHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton x:Name="RowMenu"
                                                              Style="{StaticResource RowMenuStyle}"
                                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              AutomationProperties.Name="{Binding Name, StringFormat='Row actions for {0}'}"
                                                              ToolTip="More for this app (the context-menu key or Shift+F10 opens it too)">
                                                    <Grid>
                                                        <StackPanel Orientation="Vertical"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Ellipse Width="3" Height="3" Margin="0,1.5"
                                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </StackPanel>

                                                        <Popup IsOpen="{Binding IsChecked, ElementName=RowMenu, Mode=TwoWay}"
                                                               controls:Flyout.MovesFocus="True"
                                                               PlacementTarget="{Binding ElementName=RowMenu}"
                                                               Placement="Bottom"
                                                               HorizontalOffset="-150"
                                                               VerticalOffset="4"
                                                               StaysOpen="False"
                                                               AllowsTransparency="True"
                                                               PopupAnimation="Fade">
                                                            <Border Style="{StaticResource FlyoutStyle}"
                                                                    MinWidth="176"
                                                                    Padding="4">
                                                                <StackPanel>
                                                                    <Button Style="{StaticResource MenuItemStyle}"
                                                                            Content="Usage over time"
                                                                            Command="{Binding Tag.ShowOverTimeCommand, ElementName=RowMenu}"
                                                                            CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="Usage over time"
                                                                            ToolTip="This app's use day by day, week by week or month by month" />
                                                                    <Button Style="{StaticResource MenuItemStyle}"
                                                                            Content="Show in Explorer"
                                                                            Command="{Binding Tag.RevealCommand, ElementName=RowMenu}"
                                                                            CommandParameter="{Binding}"
                                                                            IsEnabled="{Binding CanReveal}"
                                                                            AutomationProperties.Name="Show in Explorer"
                                                                            ToolTip="Open the folder this app is installed in" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1"
                                        Style="{StaticResource EmptyStateStyle}"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource EmptyTitleStyle}" />
                                <TextBlock Text="{Binding EmptyNote}" Style="{StaticResource EmptyNoteStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </controls:SectionPage>
</UserControl>

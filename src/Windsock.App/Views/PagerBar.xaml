<UserControl x:Class="Windsock.App.Views.PagerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Windsock.App.Controls"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Windsock.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PagerViewModel}"
             Visibility="{Binding IsNeeded, Converter={StaticResource BooleanToVisibility}}">

    <!--
        Under a long table: how many rows, which of them are on screen, and the
        ways to move. The count on the left, the controls on the right, wrapping
        under the count on a narrow window.
    -->
    <controls:FlowRow Spacing="8" LineSpacing="8">
        <TextBlock Text="{Binding RangeText}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   AutomationProperties.LiveSetting="Polite" />

        <controls:FlowRow controls:FlowRow.Trailing="True" Spacing="6" LineSpacing="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rows per page"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <controls:Picker Style="{StaticResource PickerStyle}"
                                 MinWidth="78"
                                 ItemsSource="{Binding PageSizes}"
                                 ItemTemplate="{StaticResource OptionLabelTemplate}"
                                 SelectedValuePath="Size"
                                 SelectedValue="{Binding SelectedPageSize, Mode=TwoWay}"
                                 AutomationProperties.Name="Rows per page"
                                 ToolTip="How many rows each page holds" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasPages, Converter={StaticResource BooleanToVisibility}}">
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding FirstCommand}"
                        AutomationProperties.Name="First page"
                        ToolTip="First page">
                    <fluent:SymbolIcon Symbol="ChevronDoubleLeft" FontSize="14" />
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Margin="4,0,0,0"
                        Command="{Binding PreviousCommand}"
                        AutomationProperties.Name="Previous page"
                        ToolTip="Previous page (Page Up)">
                    <fluent:SymbolIcon Symbol="ChevronLeft" FontSize="14" />
                </Button>

                <Border Margin="8,0,6,0"
                        Height="30"
                        MinWidth="52"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBox x:Name="PageBox"
                             Style="{StaticResource EmbeddedTextBoxStyle}"
                             Padding="8,0,8,0"
                             FontSize="12"
                             HorizontalContentAlignment="Center"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                             Text="{Binding PageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Page number"
                             ToolTip="Type a page and press Enter" />
                </Border>

                <TextBlock Text="{Binding PagesText}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding NextCommand}"
                        AutomationProperties.Name="Next page"
                        ToolTip="Next page (Page Down)">
                    <fluent:SymbolIcon Symbol="ChevronRight" FontSize="14" />
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Margin="4,0,0,0"
                        Command="{Binding LastCommand}"
                        AutomationProperties.Name="Last page"
                        ToolTip="Last page">
                    <fluent:SymbolIcon Symbol="ChevronDoubleRight" FontSize="14" />
                </Button>
            </StackPanel>
        </controls:FlowRow>
    </controls:FlowRow>
</UserControl>

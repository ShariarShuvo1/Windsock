<UserControl x:Class="Windsock.App.Views.PageSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Windsock.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PageSearchViewModel}"
             d:DesignWidth="236">

    <!--
        The search box at the top of the sidebar: type a page's name, a setting
        or a reading - ping, erase, dns, theme - and go straight to it. Ctrl+F or
        Ctrl+K from anywhere in the window puts the caret here; the arrow keys
        move through what it found, Enter goes, Escape clears and then closes.

        With the sidebar folded to icons there is no room for a box, so it is a
        button with the search glyph, and the box comes up in the flyout beside
        it with the results under it, as a folded group's sections do.

        The results never take focus: the caret stays in the box and the arrow
        keys move the highlight, so typing on never lands somewhere else.
    -->
    <UserControl.Resources>
        <Style x:Key="CompactSearchStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <fluent:SymbolIcon Symbol="Search"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A result: its name, and where it is. The chosen one sits on the accent wash, as a chosen entry does. -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,6,10,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Fill"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ToneStrokeBrush}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Fill" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type vm:SearchHit}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Kind}"
                           Margin="10,1,0,0"
                           VerticalAlignment="Top"
                           FontSize="{DynamicResource TextSize11}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource TextSize13}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Where}"
                               TextWrapping="Wrap"
                               Margin="0,1,0,0"
                               FontSize="{DynamicResource TextSize11_5}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding Where, Converter={StaticResource TextToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <TextBox x:Name="Inline"
                 Style="{StaticResource SearchBoxStyle}"
                 MinWidth="0"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Find a page or setting"
                 AutomationProperties.HelpText="Type a page, a setting or a reading, then use the arrow keys and Enter. Ctrl+F comes back here."
                 ToolTip="Find a page, a setting or a reading (Ctrl+F)"
                 PreviewKeyDown="OnBoxKeyDown"
                 TextChanged="OnQueryChanged"
                 LostKeyboardFocus="OnBoxLostFocus" />

        <Button x:Name="CompactButton"
                Style="{StaticResource CompactSearchStyle}"
                Visibility="Collapsed"
                Click="OnCompactClick"
                ToolTip="Find a page or setting (Ctrl+F)"
                AutomationProperties.Name="Find a page or setting" />

        <Popup x:Name="Results"
               PlacementTarget="{Binding ElementName=Root}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="True"
               AllowsTransparency="True"
               Focusable="False">
            <Border x:Name="Panel" Style="{StaticResource FlyoutStyle}" Width="340" Padding="6">
                <StackPanel>
                    <TextBox x:Name="InPopup"
                             Style="{StaticResource SearchBoxStyle}"
                             Margin="0,0,0,6"
                             Visibility="Collapsed"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Find a page or setting"
                             AutomationProperties.HelpText="Type a page, a setting or a reading, then use the arrow keys and Enter."
                             PreviewKeyDown="OnBoxKeyDown"
                             LostKeyboardFocus="OnBoxLostFocus" />

                    <ListBox x:Name="List"
                             ItemsSource="{Binding Results}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ResultItemStyle}"
                             ItemTemplate="{StaticResource ResultTemplate}"
                             Focusable="False"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             MaxHeight="420"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnResultClicked"
                             AutomationProperties.Name="Search results" />

                    <!-- Typed, and nothing matched: what was looked for, and what can be. -->
                    <TextBlock Text="{Binding EmptyText}"
                               TextWrapping="Wrap"
                               Margin="8,6,8,8"
                               FontSize="{DynamicResource TextSize12}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />

                    <!-- Read out as the list changes, so a screen reader hears how much the typing found. -->
                    <TextBlock Text="{Binding Summary}"
                               Height="0"
                               Opacity="0"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="{Binding Summary}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        WPF's TextBlock cannot be selected - unlike WinUI, it has no
        IsTextSelectionEnabled property. Selectable display text therefore has
        to be a read-only TextBox stripped of its chrome.

        The bare ControlTemplate is the point: the Fluent TextBox template draws
        a border, a background and a focus underline, none of which belong on
        text that only looks like a label. Reducing it to PART_ContentHost keeps
        the selection behaviour and the I-beam cursor while removing the chrome.
    -->
    <Style x:Key="SelectableTextStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small uppercase caption above a value, used throughout the app. -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!--
        The large live figure. Tabular numerals matter here: with proportional
        digits a 1 is narrower than a 0, so a value updating twice a second
        would visibly shift width as its digits change.
    -->
    <Style x:Key="ReadoutTextStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource SelectableTextStyle}">
        <Setter Property="FontSize" Value="46" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- The unit beside a readout, set smaller and quieter. -->
    <Style x:Key="ReadoutUnitTextStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource SelectableTextStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="7,0,0,9" />
    </Style>

</ResourceDictionary>

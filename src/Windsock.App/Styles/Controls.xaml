<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Windsock.App.Controls"
                    xmlns:converters="clr-namespace:Windsock.App.Converters"
                    xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />

    <!-- For the line that stands in for an empty list, and the badge that
         should not be an empty box. -->
    <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    <converters:TextToVisibilityConverter x:Key="TextToVisibility" />

    <!-- A colour chosen for one part of one cell, and the weight it carries. -->
    <converters:InkToBrushConverter x:Key="InkToBrush" />
    <converters:BoolToWeightConverter x:Key="BoolToWeight" />
    <converters:MarkToSymbolConverter x:Key="MarkToSymbol" />
    <converters:WeightToVariantConverter x:Key="WeightToVariant" />

    <!--
        Row template for pickers whose items expose a Label.

        Set explicitly rather than relying on DisplayMemberPath: a custom
        ComboBox template has to render the selection box itself, and the
        auto-generated template DisplayMemberPath produces does not reach it -
        the box would fall back to ToString() on the item.
    -->
    <DataTemplate x:Key="OptionLabelTemplate">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
    </DataTemplate>

    <!--
        A section surface. Rounded and lifted one step above the window rather
        than outlined, so sections read as distinct without any rule between
        them. Reused by every section the app grows.
    -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="22,18,22,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        One setting: its name and what it does on the left, the control that
        changes it on the right. Its own surface within the card, the same way
        the tab band and the notice are.
    -->
    <!--
        The name of a setting, with its reason behind the mark beside it.

        The reason is a tooltip rather than a second line, because a page where
        every setting explains itself at length is a page that reads as a wall
        and gets skimmed. The mark is a real control - it takes focus, answers
        the keyboard and can be clicked - so the reason is reachable without a
        mouse, and it is given to screen readers as help text besides.
    -->
    <Style TargetType="{x:Type controls:SettingHead}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Hint, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingHead}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Text}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <Button x:Name="PART_Mark"
                                Width="18"
                                Height="18"
                                Margin="6,1,0,0"
                                Cursor="Help"
                                FocusVisualStyle="{x:Null}"
                                VerticalAlignment="Center"
                                Visibility="{TemplateBinding Hint, Converter={StaticResource TextToVisibility}}"
                                AutomationProperties.Name="What this does"
                                AutomationProperties.HelpText="{TemplateBinding Hint}">
                            <ToolTipService.ToolTip>
                                <ToolTip MaxWidth="320"
                                         Placement="Right"
                                         HorizontalOffset="4">
                                    <StackPanel>
                                        <TextBlock Text="{TemplateBinding Hint}"
                                                   TextWrapping="Wrap" />

                                        <!--
                                            Held apart from the reason above it:
                                            two paragraphs pressed together read
                                            as one long one, and this one is
                                            usually a different kind of thing -
                                            what the setting cannot do, or what
                                            it is doing at this moment.
                                        -->
                                        <TextBlock Text="{TemplateBinding Note}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,11,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{TemplateBinding Note, Converter={StaticResource TextToVisibility}}" />
                                    </StackPanel>
                                </ToolTip>
                            </ToolTipService.ToolTip>

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Face"
                                            CornerRadius="9"
                                            Background="Transparent"
                                            SnapsToDevicePixels="True">
                                        <fluent:SymbolIcon x:Name="Glyph"
                                                           Symbol="Info"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Glyph"
                                                    Property="Foreground"
                                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Trigger>

                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Face"
                                                    Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter TargetName="Glyph"
                                                    Property="Foreground"
                                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Putting one setting, or a whole tab of them, back the way it shipped.
        Quiet and gone while there is nothing to put back: a way out of a choice
        nobody made is one more thing to read.
    -->
    <Style x:Key="ResetStyle" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            CornerRadius="5"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <fluent:SymbolIcon Symbol="ArrowReset"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0" />

                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        The chart's hover readout. This one does carry a hairline border: it
        floats over the plot rather than sitting beside it, so it needs an edge
        to separate it from whatever it happens to cover.
    -->
    <Style x:Key="PopoverStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9,12,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!--
        Row inside a picker's popup. Carries the Windows 11 selection idiom: a
        soft rounded fill plus an accent pill on the leading edge, which reads
        as "selected" even where the fill alone would be too subtle.
    -->
    <Style x:Key="PickerItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="12,7,12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="5"
                            Margin="4,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Pill"
                                    Width="3"
                                    Height="16"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Compact picker, templated rather than restyled.

        The stock Fluent ComboBox is built for form fields: it is tall, boxed,
        and draws a focus underline that fights a card header. This keeps the
        Windows 11 behaviour and state vocabulary - rest, hover, open, keyboard
        focus, disabled - at header scale.
    -->
    <Style x:Key="PickerStyle" TargetType="{x:Type controls:Picker}">
        <!-- Every other control that answers a click says so under the pointer.
             This one was only ever getting a hand by accident, from the tab it
             happened to be sitting in. -->
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <!-- No outline at rest. The fill is what separates the control from
             the surface it sits on, the same as everywhere else here; the only
             time a border appears is to show keyboard focus. -->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="11,0,6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItemStyle}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Picker}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False" />

                            <Path x:Name="Chevron"
                                  Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Margin="0,0,11,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5"
                                  IsHitTestVisible="False">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>

                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   VerticalOffset="5"
                                   PopupAnimation="Fade"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="0,4"
                                        MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorTertiaryBrush}" />

                            <!-- Rotated rather than swapped so opening reads as
                                 one motion instead of a glyph change. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                         To="180"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                         To="0"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Picker embedded inside another field: no chrome of its own. -->
    <Style x:Key="EmbeddedPickerStyle"
           TargetType="{x:Type controls:Picker}"
           BasedOn="{StaticResource PickerStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="7,0,4,0" />
    </Style>

    <!-- Editable text embedded inside another field, stripped of its box. -->
    <Style x:Key="EmbeddedTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,0,4,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Number plus unit in a single field. The unit half only appears once a
        number is present, so the empty state reads as one word rather than as a
        blank box qualified by a dangling unit.
    -->
    <Style x:Key="DurationBoxStyle" TargetType="{x:Type controls:DurationBox}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="30" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DurationBox}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Grid MinWidth="54">
                                <TextBox x:Name="PART_Number"
                                         Style="{StaticResource EmbeddedTextBoxStyle}"
                                         FontSize="{TemplateBinding FontSize}"
                                         Foreground="{TemplateBinding Foreground}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding PlaceholderText}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="11,0,4,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>

                            <Border x:Name="Divider"
                                    Width="1"
                                    Margin="1,7"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <controls:Picker x:Name="PART_Unit"
                                             Style="{StaticResource EmbeddedPickerStyle}"
                                             Visibility="Collapsed"
                                             ItemsSource="{TemplateBinding Units}"
                                             ItemTemplate="{StaticResource OptionLabelTemplate}"
                                             SelectedValuePath="Unit"
                                             SelectedValue="{Binding SelectedUnit, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                             AutomationProperties.Name="Time unit" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasText" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Divider" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Unit" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A readout that doubles as a series toggle. Unchecked dims the whole block
        rather than changing its text, so the reading stays legible - the series
        is still being recorded, only hidden from the plot.
    -->
    <Style x:Key="SeriesToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,5,9,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Body" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Body" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Collapses a section. Chevron only: it sits in a header that already
        names the section, so a caption would repeat it.

        The glyph points up at rest, which is the expanded state, and rotates
        down when collapsed - the direction always shows where the content will
        go, not where it is.
    -->
    <Style x:Key="SectionCollapseStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Chevron"
                              Data="M 0 4 L 4 0 L 8 4"
                              Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                         To="180"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                         To="0"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Nudges the tab strip along when the tabs overflow it. Shown only while
        there is something in that direction to reach, so a strip that fits
        carries no chrome.
    -->
    <Style x:Key="TabScrollButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="30" />
        <!-- Horizontal only: any vertical margin would push the arrow off the
             centre line the tab labels sit on. -->
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <!-- Dimmed rather than hidden: a button that vanished
                             would hand its width back to the tabs and shift
                             them just as a scroll finished. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.3" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One tab, carrying its selection as a soft filled pill.

        Nothing is outlined and nothing is underlined: the selected tab is a
        shade lifted off the card and its label steps from secondary to primary,
        which is enough to read at a glance without adding a rule to a surface
        that has none.
    -->
    <Style x:Key="TabStripItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,9,18,10" />
        <Setter Property="Margin" Value="0,0,4,0" />

        <!--
            The cursor belongs to the tab's own template, not to the tab.

            A tab item's content is bridged into its routed events as the
            logical parent - the reason handling a click on a tab catches clicks
            from the panel inside it - and QueryCursor travels that same route.
            Set here, the hand was answered for every point in the panel below,
            so the whole tab body read as clickable. Set on the button the tab
            actually draws, it means the tab and nothing else.
        -->
        <!-- Selection follows focus on a tab strip, so the pill already shows
             where the keyboard is; the stock dotted rectangle on top of it is
             just noise. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Shell"
                          Background="Transparent"
                          Cursor="Hand"
                          SnapsToDevicePixels="True">
                        <Border x:Name="Fill" Background="Transparent" CornerRadius="8" />

                        <ContentPresenter ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <!-- Last, so it wins over hover: a selected tab under
                             the pointer must not look unselected. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Shell" Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        The tab strip itself. The panel is a horizontal StackPanel rather than
        the TabPanel a TabControl uses by default: TabPanel wraps overflow onto
        further rows, and tabs on two rows stop reading as one set of tabs.
        Instead the strip keeps one line and scrolls, which is what every tab
        strip a user has met already does.
    -->
    <Style x:Key="TabStripStyle" TargetType="{x:Type controls:TabStrip}">
        <!--
            A surface of its own, distinct from both the card it heads and the
            window behind it - contrast without a single rule or outline. The
            selected tab is then lifted again out of the band.
        -->
        <Setter Property="Background" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,16,0,0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource TabStripItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TabStrip}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--
                            The strip's own background paints the band behind
                            the tabs. Transparent by default, so the tabs sit
                            straight on whatever is behind them; set it and the
                            strip reads as a band instead.

                            Rounded on all four corners: the band is a strip
                            standing on the window's ground rather than the top
                            of a card, so a squared bottom edge would be meeting
                            nothing.
                        -->
                        <Border Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="10,8,10,8"
                                SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PART_ScrollBack"
                                    Grid.Column="0"
                                    Style="{StaticResource TabScrollButtonStyle}"
                                    Visibility="{Binding IsOverflowing, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibility}}"
                                    IsEnabled="{Binding CanScrollBack, RelativeSource={RelativeSource TemplatedParent}}"
                                    AutomationProperties.Name="Scroll tabs left">
                                <Path Data="M 4 0 L 0 4 L 4 8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Button>

                            <!--
                                Hidden rather than disabled: disabling the bar
                                would also stop the panel from overflowing, so
                                the tabs would compress instead of scrolling.
                            -->
                            <ScrollViewer x:Name="PART_Scroll"
                                          Grid.Column="1"
                                          Focusable="False"
                                          PanningMode="HorizontalOnly"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>

                            <Button x:Name="PART_ScrollForward"
                                    Grid.Column="2"
                                    Style="{StaticResource TabScrollButtonStyle}"
                                    Visibility="{Binding IsOverflowing, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibility}}"
                                    IsEnabled="{Binding CanScrollForward, RelativeSource={RelativeSource TemplatedParent}}"
                                    AutomationProperties.Name="Scroll tabs right">
                                <Path Data="M 0 0 L 4 4 L 0 8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Button>
                        </Grid>
                        </Border>

                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Row="1"
                                          Margin="{TemplateBinding Padding}"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
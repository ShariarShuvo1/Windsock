<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Windsock.App.Controls"
                    xmlns:converters="clr-namespace:Windsock.App.Converters"
                    xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />

    <!-- For the line that stands in for an empty list, and the badge that
         should not be an empty box. -->
    <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    <converters:TextToVisibilityConverter x:Key="TextToVisibility" />

    <!-- A colour chosen for one part of one cell, and the weight it carries. -->
    <converters:InkToBrushConverter x:Key="InkToBrush" />
    <converters:BoolToWeightConverter x:Key="BoolToWeight" />
    <converters:MarkToSymbolConverter x:Key="MarkToSymbol" />
    <converters:WeightToVariantConverter x:Key="WeightToVariant" />

    <!--
        Row template for pickers whose items expose a Label.

        Set explicitly rather than relying on DisplayMemberPath: a custom
        ComboBox template has to render the selection box itself, and the
        auto-generated template DisplayMemberPath produces does not reach it -
        the box would fall back to ToString() on the item.
    -->
    <DataTemplate x:Key="OptionLabelTemplate">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
    </DataTemplate>

    <!--
        A card: one block of a page. A step above the page it sits on, with a
        hairline of its own, because the page is now a surface too and a fill
        one step apart from it is too faint an edge on its own.

        The spacing every page shares lives here and in the page frame below:
        24 either side of a page, 16 between the cards on it, and 20 from a
        card's edge to anything written inside it. Pages use the Card control
        below; this is the same surface for the few places that draw a card
        behind rows of a grid rather than around a child.
    -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,16,20,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        One subject on a page, on one surface. What is inside a card runs edge
        to edge and is divided by hairlines; the card clips it to its corners.
    -->
    <Style TargetType="{x:Type controls:Card}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Card}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <controls:RoundClip Radius="11">
                            <ContentPresenter />
                        </controls:RoundClip>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A part of a card: a chart, a list, a heading and what it heads. -->
    <Style x:Key="SectionStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,16,20,18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        The heading of a group of rows inside a card: more room above it than a
        row has, none below, and no rule under it, so it reads as belonging to
        what follows rather than as a row of its own.
    -->
    <Style x:Key="GroupHeadStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,18,20,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- One figure in a strip of them: the strip's rules are its edges. -->
    <Style x:Key="StatCellStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,14,16,15" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The strip itself: equal columns, hairlines between them, wrapping on narrow windows. -->
    <Style x:Key="StatStripStyle" TargetType="{x:Type controls:FlowGrid}">
        <Setter Property="IsBalanced" Value="True" />
        <Setter Property="MinimumColumnWidth" Value="150" />
        <Setter Property="DividerBrush" Value="{DynamicResource CardStrokeBrush}" />
    </Style>

    <!--
        The same strip without rules: each figure on a plate a shade off the page,
        with a sliver of page between them. For figures that sit straight on the
        page, where a hairline grid read as a box of its own.
    -->
    <Style x:Key="PlateStripStyle" TargetType="{x:Type controls:FlowGrid}" BasedOn="{StaticResource StatStripStyle}">
        <Setter Property="DividerBrush" Value="{x:Null}" />
        <Setter Property="Spacing" Value="2" />
    </Style>

    <Style x:Key="PlateCellStyle" TargetType="Border" BasedOn="{StaticResource StatCellStyle}">
        <Setter Property="Background" Value="{DynamicResource PlateBrush}" />
    </Style>

    <!-- The gap between one card and the next. -->
    <Thickness x:Key="BlockGap">0,16,0,0</Thickness>

    <!-- The inset of everything under a page's heading. -->
    <Thickness x:Key="PagePadding">24,0,24,24</Thickness>

    <!-- The name at the head of a card, and the line that qualifies it. -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="CardNoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!--
        Where a chart is drawn. On the card itself rather than in a box of its
        own: a box around the chart inside the box of the card was one frame
        more than the picture needed, and the gridlines already say where the
        plot is.
    -->
    <Style x:Key="ChartWellStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,6,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="StatNoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style TargetType="{x:Type controls:RuledPanel}">
        <Setter Property="DividerBrush" Value="{DynamicResource CardStrokeBrush}" />
    </Style>

    <!-- One setting inside a group: name on the left, control on the right. -->
    <Style x:Key="SettingRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,12,20,12" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        The inside of a setting row: the name on the left and the control on the
        right while both fit, and the control under the name once the name would
        be cut short to make room for it.
    -->
    <Style x:Key="SettingLayoutStyle" TargetType="{x:Type controls:AdaptiveRow}">
        <Setter Property="Breakpoint" Value="0" />
        <Setter Property="Spacing" Value="10" />
        <Setter Property="LeadFills" Value="True" />
        <Setter Property="LeadMinimumWidth" Value="190" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        The frame of every section: its title and one line of context, the
        actions that belong to the whole page set against them, and the page
        underneath. The actions drop under the title when there is not room for
        both on one line, rather than squeezing the title into an ellipsis.
    -->
    <Style TargetType="{x:Type controls:SectionPage}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SectionPage}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <controls:AdaptiveRow x:Name="Head"
                                              Margin="24,20,24,18"
                                              Breakpoint="520"
                                              Spacing="12"
                                              LeadFills="True"
                                              LeadMinimumWidth="240">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.HeadingLevel="Level1"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                <TextBlock x:Name="SubtitleText"
                                           Text="{TemplateBinding Subtitle}"
                                           Margin="0,3,0,0"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{TemplateBinding Subtitle}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ContentPresenter x:Name="ActionsHost"
                                              Content="{TemplateBinding Actions}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                        </controls:AdaptiveRow>

                        <ContentPresenter Grid.Row="1" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Actions" Value="{x:Null}">
                            <Setter TargetName="ActionsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One setting: its name and what it does on the left, the control that
        changes it on the right. Its own surface within the card, the same way
        the tab band and the notice are.
    -->
    <!--
        The name of a setting, with its reason behind the mark beside it.

        The reason is a tooltip rather than a second line, because a page where
        every setting explains itself at length is a page that reads as a wall
        and gets skimmed. The mark is a real control - it takes focus, answers
        the keyboard and can be clicked - so the reason is reachable without a
        mouse, and it is given to screen readers as help text besides.
    -->
    <Style TargetType="{x:Type controls:SettingHead}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Hint, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingHead}">
                    <!--
                        One wrapping line with the mark set in it, rather than the
                        name and the mark side by side: a long name in a narrow
                        window wraps and takes the mark with it to the end of the
                        words, where it used to be cut off with the mark beyond
                        the edge.
                    -->
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Run Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        <InlineUIContainer BaselineAlignment="Center">
                        <Button x:Name="PART_Mark"
                                Width="18"
                                Height="18"
                                Margin="4,0,0,-3"
                                Cursor="Help"
                                FocusVisualStyle="{x:Null}"
                                VerticalAlignment="Center"
                                Visibility="{TemplateBinding Hint, Converter={StaticResource TextToVisibility}}"
                                AutomationProperties.Name="What this does"
                                AutomationProperties.HelpText="{TemplateBinding Hint}">
                            <ToolTipService.ToolTip>
                                <ToolTip MaxWidth="320"
                                         Placement="Right"
                                         HorizontalOffset="4"
                                         FontSize="12.5"
                                         FontWeight="Normal">
                                    <StackPanel>
                                        <TextBlock Text="{TemplateBinding Hint}"
                                                   TextWrapping="Wrap" />

                                        <!--
                                            Held apart from the reason above it:
                                            two paragraphs pressed together read
                                            as one long one, and this one is
                                            usually a different kind of thing -
                                            what the setting cannot do, or what
                                            it is doing at this moment.
                                        -->
                                        <TextBlock Text="{TemplateBinding Note}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,11,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{TemplateBinding Note, Converter={StaticResource TextToVisibility}}" />
                                    </StackPanel>
                                </ToolTip>
                            </ToolTipService.ToolTip>

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Face"
                                            CornerRadius="9"
                                            Background="Transparent"
                                            SnapsToDevicePixels="True">
                                        <fluent:SymbolIcon x:Name="Glyph"
                                                           Symbol="Info"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Glyph"
                                                    Property="Foreground"
                                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Trigger>

                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Face"
                                                    Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter TargetName="Glyph"
                                                    Property="Foreground"
                                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        </InlineUIContainer>
                    </TextBlock>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Putting one setting, or a whole tab of them, back the way it shipped.
        Quiet and gone while there is nothing to put back: a way out of a choice
        nobody made is one more thing to read.
    -->
    <Style x:Key="ResetStyle" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            CornerRadius="5"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <fluent:SymbolIcon Symbol="ArrowReset"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0" />

                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The chart's hover readout. This one does carry a hairline border: it
        floats over the plot rather than sitting beside it, so it needs an edge
        to separate it from whatever it happens to cover.
    -->
    <Style x:Key="PopoverStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9,12,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!--
        Row inside a picker's popup. Carries the Windows 11 selection idiom: a
        soft rounded fill plus an accent pill on the leading edge, which reads
        as "selected" even where the fill alone would be too subtle.
    -->
    <Style x:Key="PickerItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="12,7,12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="5"
                            Margin="4,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Pill"
                                    Width="3"
                                    Height="16"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Compact picker, templated rather than restyled.

        The stock Fluent ComboBox is built for form fields: it is tall, boxed,
        and draws a focus underline that fights a card header. This keeps the
        Windows 11 behaviour and state vocabulary - rest, hover, open, keyboard
        focus, disabled - at header scale.
    -->
    <Style x:Key="PickerStyle" TargetType="{x:Type controls:Picker}">
        <!-- Every other control that answers a click says so under the pointer.
             This one was only ever getting a hand by accident, from the tab it
             happened to be sitting in. -->
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <!-- The same hairline the buttons beside it carry. A fill alone used to
             be enough against a grey card; against a white one the light theme's
             control fill is the card's own colour, and the picker vanished. -->
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="11,0,6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItemStyle}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Picker}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False" />

                            <Path x:Name="Chevron"
                                  Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Margin="0,0,11,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5"
                                  IsHitTestVisible="False">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>

                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   VerticalOffset="5"
                                   PopupAnimation="Fade"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource PopupBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="0,4"
                                        MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorTertiaryBrush}" />

                            <!-- Rotated rather than swapped so opening reads as
                                 one motion instead of a glyph change. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                         To="180"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                         To="0"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Picker embedded inside another field: no chrome of its own. -->
    <Style x:Key="EmbeddedPickerStyle"
           TargetType="{x:Type controls:Picker}"
           BasedOn="{StaticResource PickerStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="7,0,4,0" />
    </Style>

    <!-- Editable text embedded inside another field, stripped of its box. -->
    <Style x:Key="EmbeddedTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,0,4,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A readout that doubles as a series toggle. Unchecked dims the whole block
        rather than changing its text, so the reading stays legible - the series
        is still being recorded, only hidden from the plot.
    -->
    <Style x:Key="SeriesToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,5,9,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Body" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Body" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Collapses a section. Chevron only: it sits in a header that already
        names the section, so a caption would repeat it.

        The glyph points up at rest, which is the expanded state, and rotates
        down when collapsed - the direction always shows where the content will
        go, not where it is.
    -->
    <Style x:Key="SectionCollapseStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Chevron"
                              Data="M 0 4 L 4 0 L 8 4"
                              Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                         To="180"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                         To="0"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The button at the head of the sidebar that folds it to icons and opens it
        to names again.

        It shares the sections' geometry exactly - the same height, the same
        square for its glyph - so its icon sits on the column the section icons
        stand in, and folding the sidebar moves none of them.
    -->
    <Style x:Key="NavigationToggleStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Expand the sidebar" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="ToolTipService.HorizontalOffset" Value="6" />
        <Setter Property="AutomationProperties.Name" Value="Expand the sidebar" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Fill" Background="Transparent" CornerRadius="8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                The mark, not a panel glyph: the button is the
                                app's name plate as well as the fold. What it does
                                is still said by its tooltip and automation name,
                                and the hover fill still shows it can be pressed.
                                The artwork carries its own navy plate, so it is
                                clipped to a rounded square like an app icon.
                            -->
                            <Border Width="22"
                                    Height="22"
                                    CornerRadius="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/Windsock;component/Assets/Logo.png"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <DockPanel Grid.Column="1"
                                       LastChildFill="True"
                                       Margin="2,0,12,1"
                                       VerticalAlignment="Center"
                                       Opacity="{Binding NameOpacity, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationPane}}}">
                                <!--
                                    The hint the mark cannot give: which way a
                                    press folds the sidebar. Only on hover or
                                    keyboard focus, so the name plate stays quiet
                                    the rest of the time. At the far end of the
                                    button, against the edge it moves, rather than
                                    tucked against the name. Folded, the name
                                    column is clipped away and it goes with it.
                                -->
                                <fluent:SymbolIcon x:Name="Chevron"
                                                   DockPanel.Dock="Right"
                                                   Symbol="ChevronRight"
                                                   FontSize="12"
                                                   Margin="8,1,0,0"
                                                   Opacity="0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{TemplateBinding Foreground}" />

                                <TextBlock Text="Windsock"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DockPanel>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Symbol" Value="ChevronLeft" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="False" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="ToolTip" Value="Collapse the sidebar" />
                <Setter Property="AutomationProperties.Name" Value="Collapse the sidebar" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The ring round a group reached by the keyboard. A section needs none -
        selection follows focus, so its pill already shows where the keyboard is -
        but a group takes focus without being chosen, and would otherwise give no
        sign of it. A focus visual, so a click never leaves one behind.
    -->
    <Style x:Key="NavigationFocusStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="8"
                            BorderThickness="1.5"
                            BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One entry in the sidebar: its icon in a fixed square, and its name beside
        it.

        The square never moves, so folding the sidebar slides nothing sideways;
        the edge closes over the names, which fade as it does. Selection is the
        soft filled pill the tabs used, plus a short accent bar at its leading
        edge, so the chosen section still reads when only icons are showing and
        the pill alone is a small shape to pick out.

        A group carries a chevron at its far end and lists its sections under it,
        shorter, with smaller icons set in from the group's own so they read as
        belonging to it. While a group is folded - or the whole
        sidebar is - and one of its sections is the page, the group wears that
        section's selection, so the page is never unaccounted for in the column.

        A live figure (NavigationPane.Reading) sits before the chevron, and fades
        with the names.

        Named on hover only while the names are folded away. With them showing,
        a tooltip would just repeat the word under the pointer.
    -->
    <Style x:Key="NavigationItemStyle" TargetType="{x:Type controls:NavigationItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <!-- A dock panel lines items up to the left unless told otherwise. -->
        <Setter Property="DockPanel.Dock" Value="Top" />
        <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="ToolTipService.HorizontalOffset" Value="6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavigationItem}">
                    <!-- The hand is on the drawn part, not the item: a tab item
                         bridges its panel's routed events, cursor queries
                         included, and a hand set on the item answered for the
                         whole panel. -->
                    <Grid x:Name="Shell"
                          Height="40"
                          Background="Transparent"
                          Cursor="Hand"
                          SnapsToDevicePixels="True">
                        <Border x:Name="Fill" Background="Transparent" CornerRadius="8" />

                        <Border x:Name="Marker"
                                Width="3"
                                Height="16"
                                CornerRadius="1.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0" />

                        <Grid x:Name="Columns">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <fluent:SymbolIcon x:Name="Glyph"
                                               Symbol="{Binding (controls:NavigationPane.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}" />

                            <ContentPresenter x:Name="Label"
                                              Grid.Column="1"
                                              ContentSource="Header"
                                              Margin="2,0,10,1"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              Opacity="{Binding NameOpacity, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationPane}}}" />

                            <TextBlock x:Name="Reading"
                                       Grid.Column="2"
                                       Text="{Binding (controls:NavigationPane.Reading), RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="0,0,10,1"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       FontWeight="Normal"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Opacity="{Binding NameOpacity, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationPane}}}" />

                            <fluent:SymbolIcon x:Name="Chevron"
                                               Grid.Column="3"
                                               Symbol="ChevronDown"
                                               FontSize="12"
                                               Margin="0,1,12,0"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Opacity="{Binding NameOpacity, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationPane}}}" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Reading" Property="Text" Value="">
                            <Setter TargetName="Reading" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="HasChildren" Value="True">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Chevron" Property="Symbol" Value="ChevronUp" />
                        </Trigger>

                        <!-- A section inside a group: shorter, lighter, its icon smaller and set in. -->
                        <Trigger Property="IsChild" Value="True">
                            <Setter TargetName="Shell" Property="Height" Value="34" />
                            <Setter TargetName="Columns" Property="Margin" Value="14,0,0,0" />
                            <Setter TargetName="Glyph" Property="FontSize" Value="16" />
                            <Setter TargetName="Label" Property="Margin" Value="0,0,10,1" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                        </Trigger>

                        <Trigger SourceName="Shell" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <!-- The group of the page, open: its section is marked below it. -->
                        <Trigger Property="HasSelectedChild" Value="True">
                            <Setter TargetName="Glyph" Property="IconVariant" Value="Filled" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <!-- The group of the page, folded: it stands in for its section. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasSelectedChild" Value="True" />
                                <Condition Property="IsExpanded" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fill"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter TargetName="Marker" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </MultiTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasSelectedChild, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsPaneShown, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationPane}}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Fill"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter TargetName="Marker" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </MultiDataTrigger>

                        <!-- After hover, so a selected section under the
                             pointer still looks selected. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter TargetName="Marker" Property="Opacity" Value="1" />
                            <Setter TargetName="Glyph" Property="IconVariant" Value="Filled" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Shell" Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPaneShown, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationPane}}}"
                         Value="True">
                <Setter Property="ToolTipService.IsEnabled" Value="False" />
            </DataTrigger>
            <Trigger Property="HasChildren" Value="True">
                <Setter Property="FocusVisualStyle" Value="{StaticResource NavigationFocusStyle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The sidebar and the page beside it.

        Two layers. Underneath, the page with a strip of room kept clear on its
        left; on top, the sidebar itself, pinned to the left edge at whatever
        width it is gliding through. Beside the page the kept room follows the
        sidebar, so the page gives way as it opens. Over the page - a window too
        narrow for the names - the kept room stays at the compact width, the
        sidebar opens across the page, and nothing underneath moves.

        The sidebar and the page are the same surface on the window's ground,
        two rounded panes with a gutter of ground between them, so the page is
        visibly the thing the sidebar opens rather than cards scattered on the
        window. The sidebar takes an edge only while it lies over the page,
        where it would otherwise meet a surface of its own shade.
    -->
    <Style TargetType="{x:Type controls:NavigationPane}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CompactPaneWidth" Value="54" />
        <Setter Property="OpenPaneWidth" Value="220" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavigationItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <!-- A section docked to the bottom sits there, away from the
                     rest: where a settings entry is expected to be. -->
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"
                               KeyboardNavigation.DirectionalNavigation="Cycle" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavigationPane}">
                    <Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="{TemplateBinding ReservedWidth}" />

                            <!--
                                The page's own surface. Clipped to its rounded
                                shape, because a page scrolls, and a card
                                scrolled up under a square clip showed its
                                corners poking past the page's round ones.
                            -->
                            <Border x:Name="PageSurface"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True">
                                <controls:RoundClip Radius="12">
                                    <ContentPresenter x:Name="PART_Body"
                                                      Content="{TemplateBinding Body}" />
                                </controls:RoundClip>
                            </Border>
                        </Grid>

                        <Border x:Name="PART_Pane"
                                HorizontalAlignment="Left"
                                Width="{TemplateBinding PaneWidth}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <DockPanel ClipToBounds="True">
                                <ToggleButton x:Name="PART_Toggle"
                                              DockPanel.Dock="Top"
                                              Margin="0,0,0,10"
                                              Style="{StaticResource NavigationToggleStyle}"
                                              IsChecked="{Binding IsPaneShown, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                                <!--
                                    Scrolls when the window is shorter than the
                                    sections, rather than cutting off the last of
                                    them. The list is held to at least the height
                                    it is given, so while there is room Settings
                                    still docks to the bottom. No bar: the folded
                                    column has no width to spare for one, and the
                                    wheel and the keyboard both still move it.
                                -->
                                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsPresenter MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOverlay" Value="True">
                            <Setter TargetName="PART_Pane"
                                    Property="BorderBrush"
                                    Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
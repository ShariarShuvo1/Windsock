<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark-theme palette, taken from the mark itself. The icon is three flat
        segments tapering across a deep navy ground (#0E2231): the two leading
        ones in cyan (#2DC1FC, hue 197) and the trailing one in pale ice
        (#D9F0FD). Download therefore carries the mark's own cyan exactly, and
        upload takes its warm counterpoint at hue 36, which stays
        distinguishable under the common forms of colour blindness where a
        green/red pair would not.

        The neutrals lean a few degrees toward that navy rather than sitting on
        pure grey, so the window and the mark read as one thing. The light
        palette redefines these same keys; only lightness changes between the
        two, so the app keeps one identity.
    -->

    <Color x:Key="BrandNavyColor">#FF0E2231</Color>
    <Color x:Key="BrandIceColor">#FFD9F0FD</Color>

    <!-- Section accent. Hue 187 sits inside the mark's cyan family (which
         measures 197-206 across its three segments) but clear of the download
         series, so a section icon reads as brand rather than as a data
         series. Deliberately not the mark's own cyan: if the two matched, a
         section heading and a line on the chart would be the same colour
         saying different things. -->
    <Color x:Key="AccentColor">#FF4DD0E1</Color>

    <Color x:Key="DownloadColor">#FF2DC1FC</Color>
    <Color x:Key="UploadColor">#FFFFB74D</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DownloadBrush" Color="{StaticResource DownloadColor}" />
    <SolidColorBrush x:Key="UploadBrush" Color="{StaticResource UploadColor}" />
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandIceColor}" />

    <!--
        Table rows. Set against the card a table sits on, so the stripe is
        legible at a glance while each interactive state stays a clear step
        above the one below it: stripe, hover, selection.
    -->
    <SolidColorBrush x:Key="RowStripeBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#384DD0E1" />

    <!--
        The surfaces the window is built from, deepest first.

        The ground is the window itself, and shows only as the gutter around
        the two panes. The sidebar and the page are one surface, a step up, so
        the page reads as the thing the sidebar opens rather than as cards
        loose on a background. Cards sit a step above the page and carry a
        hairline of their own; wells - the grounds charts and maps are drawn
        on - sink a step below the card they are in.
    -->
    <SolidColorBrush x:Key="WindowGroundBrush" Color="#FF0B0D10" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF15181C" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF1C2026" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF23282F" />
    <!-- The shapes a page shows in place of what it is still waiting for. -->
    <SolidColorBrush x:Key="BoneBrush" Color="#FF20242A" />
    <!-- A figure set on its own ground, a shade off the page, where a rule would otherwise part it from its neighbours. -->
    <SolidColorBrush x:Key="PlateBrush" Color="#FF1B1E23" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CanvasGroundBrush" Color="#FF14171B" />

    <!-- Anything that floats: flyouts, drop-downs, the chart's hover readout. -->
    <SolidColorBrush x:Key="PopupBrush" Color="#FF242931" />

    <!-- The world map: land a shade above the sea it sits in, coastlines a
         shade above that, and the country under the pointer picked out. Its own
         tones rather than borrowed ones, because a map is the one drawing where
         the background carries meaning. -->
    <SolidColorBrush x:Key="MapLandBrush" Color="#FF20262D" />
    <SolidColorBrush x:Key="MapCoastBrush" Color="#FF38424D" />
    <SolidColorBrush x:Key="MapLandLitBrush" Color="#FF2C4A52" />

    <!-- The busiest country, when the map is shaded by traffic. Everything
         else is mixed between this and the plain land. -->
    <SolidColorBrush x:Key="MapBusyBrush" Color="#FF26525C" />

    <!--
        One hue per part of the machine, so a tile is recognisable before its
        caption is read. The network takes the mark's cyan, because it is what
        Windsock is for and the tile a reader looks at first. The other four are
        spread evenly around the wheel from it - periwinkle, green, violet and
        rose - at the same lightness, so no one tile shouts louder than the
        others. Rose rather than amber for storage: amber is upload, and the
        network tile draws upload beside it.
    -->
    <Color x:Key="NetworkColor">#FF2DC1FC</Color>
    <Color x:Key="ProcessorColor">#FF7C9DFF</Color>
    <Color x:Key="GraphicsColor">#FF6FD49A</Color>
    <Color x:Key="MemoryColor">#FFC09BF6</Color>
    <Color x:Key="StorageColor">#FFF48FB8</Color>

    <SolidColorBrush x:Key="NetworkBrush" Color="{StaticResource NetworkColor}" />
    <SolidColorBrush x:Key="ProcessorBrush" Color="{StaticResource ProcessorColor}" />
    <SolidColorBrush x:Key="GraphicsBrush" Color="{StaticResource GraphicsColor}" />
    <SolidColorBrush x:Key="MemoryBrush" Color="{StaticResource MemoryColor}" />
    <SolidColorBrush x:Key="StorageBrush" Color="{StaticResource StorageColor}" />

    <!--
        The unfilled part of a meter. Dim enough to read as a groove rather
        than as a second value.
    -->
    <SolidColorBrush x:Key="MeterTrackBrush" Color="#1FFFFFFF" />

    <!-- A reading that has crossed from busy into hot. -->
    <SolidColorBrush x:Key="HotBrush" Color="#FFFF8A65" />

    <!-- A state that is fine: the connection is up. Semantic, not a series. -->
    <SolidColorBrush x:Key="GoodBrush" Color="#FF6FD49A" />

</ResourceDictionary>

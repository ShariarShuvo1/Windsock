<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                    xmlns:commands="clr-namespace:Windsock.App.Commands"
                    xmlns:controls="clr-namespace:Windsock.App.Controls">

    <!--
        Surface for a flyout the user reaches into - a filter box, a column
        list. Distinct from PopoverStyle, which is the chart's read-only
        tooltip and deliberately ignores the mouse.
    -->
    <Style x:Key="FlyoutStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        The grab handle between two column headings.
        Invisible until the pointer is near it: a permanent rule down every
        header would be the only outlined thing in the window, but with nothing
        there at all the columns would look fixed.
    -->
    <Style x:Key="ColumnGripperStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Line"
                                Width="1"
                                Margin="0,9"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                Opacity="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter TargetName="Line"
                                    Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The funnel in a column heading. Tinted while its filter is doing something. -->
    <Style x:Key="HeaderFilterStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="3,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!--
            Out of the way until wanted. Six funnels standing in six headings
            is a row of noise above every table; faded out, the headings read
            as words and the control is still exactly where the hand expects
            it. Faded rather than collapsed so revealing one does not reflow
            the heading under the pointer.
        -->
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <!-- A filter that is doing something stays visible and
                             tinted, so a narrowed column says so at rest. -->
                        <DataTrigger Binding="{Binding HasFilter}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFilterOpen}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A column heading: click to sort, funnel to filter, edges to resize.

        The two grippers are template parts the grid looks for by name; without
        them the columns cannot be resized at all. Everything else is bound
        through Content, which is the column's own view model, so the heading
        and its filter share one object.
    -->
    <Style x:Key="TableHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0,4,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}"
                                  DataContext="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           HorizontalAlignment="{Binding Alignment}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <Path x:Name="SortAscending"
                                      Grid.Column="1"
                                      Data="M 0 3.5 L 3.5 0 L 7 3.5"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />

                                <Path x:Name="SortDescending"
                                      Grid.Column="1"
                                      Data="M 0 0 L 3.5 3.5 L 7 0"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />

                                <ToggleButton x:Name="FilterToggle"
                                              Grid.Column="2"
                                              Style="{StaticResource HeaderFilterStyle}"
                                              IsChecked="{Binding IsFilterOpen, Mode=TwoWay}"
                                              ToolTip="Filter this column"
                                              AutomationProperties.Name="Filter column">
                                    <Grid>
                                        <fluent:SymbolIcon Symbol="Filter"
                                                           FontSize="12"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />

                                        <Popup IsOpen="{Binding IsFilterOpen, Mode=TwoWay}"
                                               StaysOpen="False"
                                               Placement="Bottom"
                                               HorizontalOffset="-176"
                                               VerticalOffset="6"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               Focusable="False">
                                            <Border Style="{StaticResource FlyoutStyle}" Width="212">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Margin="2,0,0,6" />

                                                    <TextBox x:Name="FilterInput"
                                                             Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontWeight="Normal"
                                                             MinHeight="28"
                                                             VerticalContentAlignment="Center"
                                                             AutomationProperties.Name="Column filter" />

                                                    <TextBlock Text="{Binding FilterHint}"
                                                               FontSize="11"
                                                               FontWeight="Normal"
                                                               Margin="2,6,0,0"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                                    <Button Content="Clear"
                                                            Command="{Binding ClearFilterCommand}"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,8,0,0"
                                                            Padding="10,3"
                                                            FontSize="11"
                                                            FontWeight="Normal" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!--
                            One handle per boundary, on the trailing edge, so a
                            drag always resizes the column to its left.

                            The grid offers a leading handle too, and using both
                            puts two of them on every boundary: they sit side by
                            side, look like one divider, and resize different
                            columns depending on which half was grabbed. The
                            trailing edge alone is the convention every other
                            table uses.

                            It stays wholly inside its own header: the next
                            header is painted after this one, so anything
                            hanging past the edge would be covered by it and
                            neither seen nor grabbed.
                        -->
                        <Thumb x:Name="PART_RightHeaderGripper"
                               HorizontalAlignment="Right"
                               Style="{StaticResource ColumnGripperStyle}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="FilterToggle" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortAscending" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortDescending" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row. Flat, with no rule under it: the spacing does that job. -->
    <Style x:Key="TableRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                SnapsToDevicePixels="True" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Banding first: hover and selection are states the
                             user is causing, and they have to win over it. -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource RowStripeBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                        <!-- A plain lift rather than an accent wash: the name in
                             the row is what carries the accent, and accent text
                             on an accent ground is a colour reading against
                             itself. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A cell. Stripped of the stock border and focus rectangle. -->
    <Style x:Key="TableCellStyle" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <!-- Stretched rather than centred: a cell that draws
                             tree lines has to reach the top and bottom of its
                             row, or the line running down a group breaks at
                             every row boundary. The text styles centre
                             themselves. -->
                        <ContentPresenter VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Opens a group. A button rather than a toggle: the row it belongs to is
        rebuilt on every tick, so the open state lives in the panel and is read
        back from the row rather than held in the control.
    -->
    <Style x:Key="GroupExpanderStyle" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Chevron"
                              Data="M 0 0 L 4 4 L 0 8"
                              Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Chevron"
                                    Property="Stroke"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <!-- Points at the rows it is about to reveal, and turns
                             down once they are there. -->
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter TargetName="Chevron"
                                    Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The name cell. Every row keeps the same gutter whether it has a chevron
        or not, so the names line up; a group's members are stepped in past it
        and joined to their group by a line, which says what indentation alone
        only implies.
    -->
    <!--
        A path that opens where it points. Styled as text rather than as a
        button, because it is a path first: the underline on hover is what says
        it will do something.
    -->
    <Style x:Key="PathLinkStyle" TargetType="Button">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!--
                        A folder in front of the path, so it reads as somewhere
                        to go before the pointer is anywhere near it. Text alone
                        was indistinguishable from the two lines above it, and a
                        link nobody can see is a link nobody clicks.
                    -->
                    <Border x:Name="Shell"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="4,2"
                            Margin="-4,0,0,0"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <fluent:SymbolIcon x:Name="Glyph"
                                               Symbol="FolderOpen"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Content}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Label"
                                    Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            <Setter TargetName="Glyph"
                                    Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.7" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            <Setter TargetName="Glyph"
                                    Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>

                        <!-- No file behind the path: it is only a fact, so it
                             stops pretending to be a way anywhere. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>

                        <Trigger Property="Content" Value="">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ProcessNameTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource GroupExpanderStyle}"
                    Visibility="{Binding IsExpandable, Converter={StaticResource BooleanToVisibility}}"
                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}"
                    ToolTip="Show the processes in this group"
                    AutomationProperties.Name="Expand group" />

            <!-- The step a member takes in from its group. -->
            <Border Grid.Column="1"
                    Width="16"
                    Background="Transparent"
                    Visibility="{Binding IsChild, Converter={StaticResource BooleanToVisibility}}" />

            <!--
                Drawn from the first column but wider than it, so the elbow
                reaches across the step without needing a column of its own.
                The trunk sits under where the group's chevron is.
            -->
            <Grid Grid.Column="0"
                  Width="34"
                  HorizontalAlignment="Left"
                  Visibility="{Binding IsChild, Converter={StaticResource BooleanToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Width="1"
                        Margin="9,0,0,0"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Border Grid.Row="1"
                        Width="1"
                        Margin="9,0,0,0"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Visibility="{Binding IsLastChild, Converter={StaticResource InverseBooleanToVisibility}}" />

                <Border Grid.Row="0"
                        Height="1"
                        Margin="9,0,5,0"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            </Grid>

            <!--
                The program's own icon, the way the task manager shows it. A
                placeholder while it is being read, and for a program whose icon
                cannot be read at all, so the column never has a hole in it.
            -->
            <Grid Grid.Column="2" Width="16" Height="16" Margin="2,0,0,0" VerticalAlignment="Center">
                <!--
                    A plain window outline for the programs Windows will not
                    give an icon for - service hosts, mostly. Stroked in the
                    same tone as the quieter text rather than filled, so the
                    column reads as a column of icons whether or not a
                    particular program has one.
                -->
                <Path Data="M 0.5 1.5 H 11.5 V 10.5 H 0.5 Z M 0.5 4 H 11.5"
                      Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                      StrokeThickness="1"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      SnapsToDevicePixels="True">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <Image Source="{Binding Icon}"
                       Width="16"
                       Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>

            <!-- One block, so the count follows the name instead of drifting
                 to the far side of the column, and the pair trims together. -->
            <TextBlock Grid.Column="3"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Style.Triggers>
                            <!-- The selected row names itself in the accent, the
                                 same way the selected tab does, so selection is
                                 something to see rather than something to
                                 notice. -->
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                         Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                <Run Text="{Binding CountText, Mode=OneWay}"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </TextBlock>
        </Grid>
    </DataTemplate>

    <Style x:Key="TableTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Numbers line up on the right, with tabular figures so they stay in
         column as the digits change. -->
    <Style x:Key="TableNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TableTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="TableQuietNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TableNumberStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="TableQuietTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
        A connection's text, struck through while it is switched off the graph.

        Struck rather than dimmed, which is what it used to be: a closed socket
        is already dimmed, and one appearance for two unrelated states is a
        reader having to guess which one they are looking at. A line through the
        words says "left out" and nothing else does.
    -->
    <Style x:Key="ConnectionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableTextStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsShown}" Value="False">
                <Setter Property="TextDecorations" Value="Strikethrough" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConnectionQuietTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TableQuietTextStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsShown}" Value="False">
                <Setter Property="TextDecorations" Value="Strikethrough" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A checkbox, drawn to match the app rather than borrowed from the system
        theme. The whole label is the target, not just the little box.
    -->
    <Style x:Key="CheckStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="17"
                                    Height="17"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="1.2"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="Tick"
                                      Data="M 0 3.4 L 3 6.4 L 8.4 1"
                                      Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Opacity="0" />
                            </Border>

                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Row"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The same checkbox, sized for a row of toolbar controls. The padding has
        to come down with the height: the list variant is spaced for a list, and
        at the height of a toolbar field that spacing leaves the box no room and
        clips it.
    -->
    <Style x:Key="ToolbarCheckStyle" TargetType="CheckBox" BasedOn="{StaticResource CheckStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="AdapterChoiceTemplate">
        <CheckBox Style="{StaticResource CheckStyle}"
                  Content="{Binding Label}"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                  IsEnabled="{Binding CanUntick}" />
    </DataTemplate>

    <DataTemplate x:Key="ColumnChoiceTemplate">
        <CheckBox Style="{StaticResource CheckStyle}"
                  Content="{Binding Title}"
                  IsChecked="{Binding IsVisible, Mode=TwoWay}" />
    </DataTemplate>

    <!--
        Rates carry the same two colours the chart does, so up and down mean the
        same thing everywhere in the app. A process moving nothing stays grey:
        the colour marks activity, and colouring every row would mark nothing.
    -->
    <Style x:Key="TableSendStyle" TargetType="TextBlock" BasedOn="{StaticResource TableNumberStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasSend}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource UploadBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TableReceiveStyle" TargetType="TextBlock" BasedOn="{StaticResource TableNumberStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasReceive}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DownloadBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The three dots that open a row's own menu. Quiet until the pointer is
        near it: it sits on every row, and eight bright dots down the edge of a
        table would compete with the numbers.
    -->
    <Style x:Key="RowMenuStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One line of a small menu: full width, no border, fill on hover. -->
    <Style x:Key="MenuItemStyle" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The heading over a column of buttons. It has no name to show and nothing
        to sort or filter by, so it is the header surface and nothing else.
    -->
    <Style x:Key="ActionsHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A row that can be lit from elsewhere: pointing at a bar on the chart
        lights its row here, and pointing at a row lights its bar there.

        Selection still wins. A lit row is a passing thing that follows the
        pointer; a selected one is a choice, and the choice should not flicker
        as the pointer travels.
    -->
    <Style x:Key="HistoryRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource TableRowStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A connection row. A socket that has closed is held for a few seconds and
        faded rather than removed at once, so a connection that lives less than
        one reading does not merely flicker past.
    -->
    <!--
        The corner control on the graph. Drawn rather than lettered, and it says
        which way it will go: outward while the graph is in its card, inward
        while it has the screen.
    -->
    <Style x:Key="GraphCornerStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Glyph"
                              Data="M 0 3 L 0 0 L 3 0 M 7 0 L 10 0 L 10 3 M 10 7 L 10 10 L 7 10 M 3 10 L 0 10 L 0 7"
                              Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                            <Setter TargetName="Glyph"
                                    Property="Data"
                                    Value="M 3 0 L 3 3 L 0 3 M 7 0 L 7 3 L 10 3 M 10 7 L 7 7 L 7 10 M 0 7 L 3 7 L 3 10" />
                        </DataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Glyph"
                                    Property="Stroke"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A node on the traffic graph. A button rather than something drawn,
        because a node is a thing you point at, tab to, press and have read
        aloud - and a button is all of that already.
    -->
    <Style x:Key="GraphNodeStyle" TargetType="Button">
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell"
                                    Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Shell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A peer node, which additionally lights when its rows in the table below
        are pointed at, and stays lit while it is the branch being followed.

        Stepping back while another branch is followed is not here: that is a
        fade, and so is the one a node arrives and leaves with. Two owners of
        one property means whichever wrote last wins, so the view owns it and
        multiplies the two together.
    -->
    <Style x:Key="GraphPeerNodeStyle" TargetType="Button" BasedOn="{StaticResource GraphNodeStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A hop node. Smaller than a peer and quieter: a route is a dozen of these
        and only two or three of them are ever the point, so they are the shape
        of the picture rather than the subject of it. It carries the same lit,
        followed and stepped-back states, because it answers to the same click
        and the same pointer as everything else on the graph.
    -->
    <Style x:Key="GraphHopNodeStyle" TargetType="Button" BasedOn="{StaticResource GraphNodeStyle}">
        <Setter Property="Padding" Value="9,4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The process at the middle. Everything else on the graph is somewhere its
        traffic goes; this is the thing the window is about, and it used to be
        the smallest, plainest box on screen. Now it is the largest, it carries
        the program's own icon, and it sits on a surface a step away from the
        one the peers stand on - three differences that are none of them a
        colour, so nothing here can be mistaken for a node that is lit, chosen,
        or set aside.
    -->
    <Style x:Key="GraphHubNodeStyle" TargetType="Button" BasedOn="{StaticResource GraphNodeStyle}">
        <Setter Property="Padding" Value="13,9" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1.6" />
    </Style>

    <!--
        A program's node, on the map of the whole machine. It stands between the
        machine in the middle and everywhere its traffic goes, so it is drawn
        between the two as well: a step larger than a peer, on the same surface
        the hub uses, and carrying the program's own icon. Nothing here is a
        colour, so a program can still be lit, followed or set aside without any
        of the three being mistaken for what kind of node it is.
    -->
    <Style x:Key="GraphProcessNodeStyle" TargetType="Button" BasedOn="{StaticResource GraphNodeStyle}">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A node on the world map. Everything that is a labelled box on the free
        layout is a dot here, because a map of the earth with two hundred
        captions on it is not a map: the shape of where the traffic goes is the
        thing being shown, and the names come back on hover and on whichever
        branch is being followed.

        Round rather than square, because a dot on a map is round and because
        these sit on top of coastlines where a square reads as a place name box.
    -->
    <Style x:Key="GraphWorldNodeStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CanvasGroundBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999"
                            SnapsToDevicePixels="True" />

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="2.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A far end: somewhere out there, and the point of the whole picture. -->
    <Style x:Key="GraphWorldPeerStyle" TargetType="Button" BasedOn="{StaticResource GraphWorldNodeStyle}">
        <Style.Triggers>
            <!--
                Somewhere on this machine rather than out on the earth. It has
                no location to be drawn at, so it sits beside the program it
                belongs to and is drawn quietly enough not to be mistaken for a
                place that does.
            -->
            <DataTrigger Binding="{Binding IsLocal}" Value="True">
                <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A waypoint: the shape of the road rather than either end of it. -->
    <Style x:Key="GraphWorldHopStyle" TargetType="Button" BasedOn="{StaticResource GraphWorldNodeStyle}">
        <Setter Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
        This machine, in the middle of the map. The one dot that is worth a
        glyph: it is where the reader is, everything else is measured from it,
        and at fifteen pixels a picture is the only thing that fits.
    -->
    <Style x:Key="GraphWorldProcessStyle" TargetType="Button" BasedOn="{StaticResource GraphWorldNodeStyle}">
        <Setter Property="Background" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999"
                            SnapsToDevicePixels="True">
                        <fluent:SymbolIcon Symbol="Desktop"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource CanvasGroundBrush}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A piece of a window that can be lifted out into one of its own.

        The button floats over the top right corner of whatever it holds rather
        than taking a strip of height above it: every one of these sits on
        something worth looking at, and a row of chrome over each would cost
        more than the button is worth. What is left behind is the same box with
        a sentence in it, because a hole where a chart was reads as the chart
        having broken.
    -->
    <!-- The corner button itself: quiet until the pointer is near it. -->
    <Style x:Key="DetachCornerStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <fluent:SymbolIcon x:Name="Glyph"
                                           Symbol="WindowNew"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell"
                                    Property="Background"
                                    Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                            <Setter TargetName="Shell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Setter TargetName="Glyph"
                                    Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:DetachHost" x:Key="{x:Type controls:DetachHost}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DetachHost">
                    <Grid>
                        <ContentPresenter x:Name="Held" />

                        <!-- Where the content went, while it is gone. -->
                        <StackPanel x:Name="Gone"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="360">
                            <TextBlock Text="{TemplateBinding Note}"
                                       FontSize="12.5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <Button Style="{DynamicResource ToolbarButtonStyle}"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{x:Static controls:DetachHost.BringBack}"
                                    AutomationProperties.Name="{Binding WindowTitle,
                                        RelativeSource={RelativeSource TemplatedParent},
                                        StringFormat='Bring {0} back'}"
                                    ToolTip="Put it back in this window">
                                <StackPanel Orientation="Horizontal">
                                    <fluent:SymbolIcon Symbol="ArrowMinimize"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0" />
                                    <TextBlock Text="Bring it back" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button x:Name="Lift"
                                Style="{DynamicResource DetachCornerStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,2,2,0"
                                Command="{x:Static controls:DetachHost.TakeOut}"
                                AutomationProperties.Name="{Binding WindowTitle,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    StringFormat='Open {0} in its own window'}"
                                ToolTip="Open this in a window of its own" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDetached" Value="True">
                            <Setter TargetName="Held" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Gone" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Lift" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="CanDetach" Value="False">
                            <Setter TargetName="Lift" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The drawer the graph keeps its switches in.

        Floating over the picture rather than taking a strip of it, and shut
        unless it is wanted: the switches are read once and then left alone for
        the rest of a session, while the picture is what the window is for. It
        is the same argument the graph already makes for its own controls, taken
        one step further.
    -->
    <Style x:Key="GraphDrawerStyle" TargetType="Border">
        <Setter Property="Width" Value="272" />
        <Setter Property="Margin" Value="0,12,12,48" />
        <Setter Property="Padding" Value="4,4,4,8" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- One switch in the drawer, and the line that says what it does. -->
    <Style x:Key="GraphDrawerRowStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="10,8,10,8" />
    </Style>

    <Style x:Key="GraphDrawerNoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="26,3,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="GraphDrawerHeadStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- The cross that shuts it, and the divider under its heading. -->
    <Style x:Key="GraphDrawerCloseStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,2,2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shell" Background="Transparent" CornerRadius="6">
                        <fluent:SymbolIcon Symbol="Dismiss"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell"
                                    Property="Background"
                                    Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The popover a node shows on hover, or when it is tabbed to. A real
        tooltip rather than a drawn one: the chart has to draw its own because a
        bar is not an element, but a node is, so this is the framework's job.
    -->
    <Style x:Key="GraphPopoverStyle" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Left" />
        <Setter Property="HorizontalOffset" Value="-10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9,12,10"
                            SnapsToDevicePixels="True">
                        <!--
                            Bounded, so a popover can never run off the screen
                            and take half of what it says with it. The scroller
                            is a backstop rather than an affordance: a tooltip
                            closes the moment the pointer moves off the thing it
                            belongs to, so it cannot be scrolled by hand. What
                            keeps these readable is that everything in them that
                            can grow is capped; this only makes sure the cap
                            failing is visible rather than silent.
                        -->
                        <ScrollViewer MaxHeight="440"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ContentPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- What a node says on the node itself: two lines, no more. -->
    <DataTemplate x:Key="GraphPeerNodeTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                A far end is somewhere out on the internet, and saying so on the
                node is what keeps it from reading as one more waypoint. Quiet
                rather than coloured: it is a kind, not a state, and the states
                on this graph are all told in colour.
            -->
            <fluent:SymbolIcon Grid.Column="0"
                               FontSize="13"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <fluent:SymbolIcon.Style>
                    <Style TargetType="fluent:SymbolIcon">
                        <Setter Property="Symbol" Value="Globe" />
                        <Style.Triggers>
                            <!--
                                Somewhere on this machine rather than out on the
                                network: the traffic never reaches a network
                                card, so it should not wear the same globe as
                                somewhere on the other side of the world.
                            -->
                            <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                <Setter Property="Symbol" Value="Desktop" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </fluent:SymbolIcon.Style>
            </fluent:SymbolIcon>

        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Label}"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <TextBlock Text="{Binding RateText}"
                       FontSize="10.5"
                       Margin="0,1,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        What a program says on the map: its icon, its name, and what it is
        moving. The icon is the point - forty boxes of text is a list, and a
        picture wants to be recognised rather than read.
    -->
    <DataTemplate x:Key="GraphProcessNodeTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{Binding Icon}"
                   Width="18"
                   Height="18"
                   Margin="0,0,9,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <TextBlock Text="{Binding RateText}"
                           FontSize="10.5"
                           Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GraphHopNodeTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Label}"
                       FontSize="10.5"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Latency}"
                       FontSize="10"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GraphNoteNodeTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                The program's own icon, which is the fastest way to know which
                box is the process. Gone rather than blank where Windows has
                none, so the words simply take the room back.
            -->
            <Image Grid.Column="0"
                   Source="{Binding Icon}"
                   Width="24"
                   Height="24"
                   Margin="0,0,11,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <TextBlock Text="{Binding Body}"
                           FontSize="10.5"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GraphMachineNodeTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <fluent:SymbolIcon Grid.Column="0"
                               Symbol="Desktop"
                               FontSize="22"
                               Margin="0,0,11,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <TextBlock Text="{Binding Body}"
                           FontSize="10.5"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        Lines in a popover. A line with nothing to say takes no room rather than
        leaving a gap, so the same template serves a peer with three facts and
        one with eight.
    -->
    <Style x:Key="PopoverLineStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PopoverNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource PopoverLineStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!--
        A pinned process. The pinned row is always the top row, so its place in
        the table cannot say whether it is up there by choice or by traffic:
        the tint is what says which.
    -->
    <Style x:Key="ProcessRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource TableRowStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConnectionRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource TableRowStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsClosed}" Value="True">
                <Setter Property="Opacity" Value="0.45" />
            </DataTrigger>

            <!--
                Lit from the graph: hovering a peer lights every socket that
                makes it up, which is what says a node and eight rows are the
                same thing.
            -->
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The grid itself. The header, row and cell styles are deliberately not
        set here: assigned through this style they lose to the Fluent theme's
        own, and the stock header comes back complete with its separators and
        filled sort arrow. The view sets those three on the grid element, where
        a local value wins.
    -->
    <Style x:Key="TableStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="ColumnHeaderHeight" Value="36" />
        <Setter Property="ColumnWidth" Value="Auto" />
        <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="False" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <!-- Toolbar search field: icon, placeholder, and a clear button once typed in. -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <fluent:SymbolIcon Grid.Column="0"
                                               Symbol="Search"
                                               FontSize="14"
                                               Margin="9,0,7,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <Grid Grid.Column="1">
                                <!--
                                    Nudged to where the text will actually
                                    appear. The editable surface keeps a pixel
                                    either side of the text for the caret, which
                                    a plain TextBlock does not, so without this
                                    the hint sits two pixels left of what
                                    replaces it and the caret cuts through its
                                    first letter. Measured, not guessed.
                                -->
                                <TextBlock x:Name="Placeholder"
                                           Text="Search processes"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Background="Transparent" />
                            </Grid>

                            <Button x:Name="Clear"
                                    Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Margin="2,0,3,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{x:Static commands:TextCommands.Clear}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="Clear search"
                                    AutomationProperties.Name="Clear search">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Ring"
                                                Background="Transparent"
                                                CornerRadius="12"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ring"
                                                        Property="Background"
                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <fluent:SymbolIcon Symbol="Dismiss"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Clear" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar button: same height as the pickers, no chrome until touched. -->
    <Style x:Key="ToolbarButtonStyle" TargetType="ButtonBase">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The answer a dialog leads with. Filled rather than outlined, because a
        dialog asks a question and one of the answers has to look like the one
        to reach for.
    -->
    <Style x:Key="PrimaryButtonStyle" TargetType="ButtonBase"
           BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Windsock.App.ViewModels"
                    xmlns:controls="clr-namespace:Windsock.App.Controls"
                    xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">

    <!--
        The meter itself, and the controls the Taskbar tab configures it with.

        The meter's template is defined once and used three times: by the window
        that sits in the taskbar, and by the two swatches beside its settings
        that show it against a dark and a light bar. A preview drawn by the same
        code as the thing it previews cannot drift away from it.
    -->

    <!--
        One reading: what it is, the figure, and its unit, kept together as one
        group against the right edge of its slot.

        Together is the point. An earlier version spread the label and the figure
        to opposite ends of the slot so that figures of different lengths would
        line up in a column - which they did, with a hand's width of empty bar
        between the arrow and the number it belonged to. Reading a pair means
        seeing them as a pair.
    -->
    <!--
        A place's last minute drawn behind its figure, faint enough to read the
        figure over. Gone unless the place asked for a graph, and gone from
        behind when the graph stands alone in the figure's room instead.
    -->
    <Style x:Key="MeterSparkBehindStyle" TargetType="controls:MeterSpark">
        <Setter Property="AutomationProperties.Name" Value="Last minute" />
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="Margin" Value="0,3,0,3" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Graph}" Value="None">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding GraphAlone}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The graph in the figure's own room, for a place that asked for it alone. -->
    <Style x:Key="MeterSparkAloneStyle" TargetType="controls:MeterSpark">
        <Setter Property="AutomationProperties.Name" Value="Last minute" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="14" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GraphAlone}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The figure, stood aside while its graph takes its room. -->
    <Style x:Key="MeterFigureStyle" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GraphAlone}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The windsock, in the mark's place, for the place that shows it. -->
    <Style x:Key="MeterPacerStyle" TargetType="controls:MeterPacer">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPacer}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="MeterSlotTemplate" DataType="{x:Type vm:MeterSlotViewModel}">
        <!--
            Every part reads from the cell rather than from the meter: two cells
            on one meter may be different sizes, weights and colours, because
            each answers its own question - and each sits at whichever end of
            its place it was told to.
        -->
        <Grid Margin="0,0,8,0">
        <controls:MeterSpark Style="{StaticResource MeterSparkBehindStyle}"
                             Values="{Binding SparkValues}"
                             Count="{Binding SparkCount}"
                             Version="{Binding SparkVersion}"
                             Mode="{Binding Graph}"
                             Ceiling="{Binding SparkCeiling}"
                             Ink="{Binding Figure}" />

        <controls:SlotRow LeftCount="{Binding PartsOnTheLeft}"
                          VerticalAlignment="Center">
            <!--
                A picture of the part of the machine, or the short name for it.
                Both are the mark, so both take the mark colour and the mark
                size; a mark carrying weight is filled rather than bolder,
                because a picture has no bold. One place in the row holds both,
                so the row has three parts however the mark is drawn.
            -->
            <Grid Margin="0,0,4,0" VerticalAlignment="Center">
            <fluent:SymbolIcon Symbol="{Binding Mark, Converter={StaticResource MarkToSymbol}}"
                               IconVariant="{Binding Weight, Converter={StaticResource WeightToVariant}}"
                               Foreground="{Binding LabelInk}"
                               FontSize="{Binding SupportSize}"
                               VerticalAlignment="Center">
                <fluent:SymbolIcon.Style>
                    <Style TargetType="fluent:SymbolIcon">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding MarkIsIcon}" Value="True" />
                                    <Condition Binding="{Binding IsPacer}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </fluent:SymbolIcon.Style>
            </fluent:SymbolIcon>

            <controls:MeterPacer Style="{StaticResource MeterPacerStyle}"
                                 Speed="{Binding Speed}"
                                 Ink="{Binding LabelInk}" />

            <TextBlock Text="{Binding Label}"
                       Foreground="{Binding LabelInk}"
                       FontSize="{Binding SupportSize}"
                       FontWeight="{Binding Weight}"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="{Binding Label, Converter={StaticResource TextToVisibility}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MarkIsIcon}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>

            <!--
                Figures tabular, so every digit is as wide as every other and
                a reading's width depends only on how many digits it has; and
                each part as wide as the room the meter keeps for it, which is
                what holds the meter still while the digits change. The figure
                sits at the right of its room, against its unit; the unit at
                the left of its own.
            -->
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding Value}"
                           Style="{StaticResource MeterFigureStyle}"
                           Foreground="{Binding Figure}"
                           FontSize="{Binding Size}"
                           FontWeight="{Binding Weight}"
                           MinWidth="{Binding ValueReserve}" />

                <controls:MeterSpark Style="{StaticResource MeterSparkAloneStyle}"
                                     Values="{Binding SparkValues}"
                                     Count="{Binding SparkCount}"
                                     Version="{Binding SparkVersion}"
                                     Mode="{Binding Graph}"
                                     Ceiling="{Binding SparkCeiling}"
                                     Ink="{Binding Figure}" />
            </Grid>

            <TextBlock Text="{Binding Unit}"
                       Foreground="{Binding Support}"
                       FontSize="{Binding SupportSize}"
                       MinWidth="{Binding UnitReserve}"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="{Binding UnitShown, Converter={StaticResource BooleanToVisibility}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GraphAlone}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </controls:SlotRow>
        </Grid>
    </DataTemplate>

    <!--
        One reading on a taskbar down the side of the screen: the mark and the
        figure on one line, the unit under the figure. A bar there is about as
        wide as one of its buttons, and a figure with its unit beside it does
        not fit across it even shrunk as far as it stays legible; with the unit
        underneath it does, and the bar has length to spare for the second
        line. The figure keeps its room, as on any bar, so the column holds
        still while the digits change.
    -->
    <DataTemplate x:Key="MeterSlotUnderTemplate" DataType="{x:Type vm:MeterSlotViewModel}">
        <Grid Margin="0,0,8,0">
        <controls:MeterSpark Style="{StaticResource MeterSparkBehindStyle}"
                             Values="{Binding SparkValues}"
                             Count="{Binding SparkCount}"
                             Version="{Binding SparkVersion}"
                             Mode="{Binding Graph}"
                             Ceiling="{Binding SparkCeiling}"
                             Ink="{Binding Figure}" />

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,3,0" VerticalAlignment="Center">
                <fluent:SymbolIcon Symbol="{Binding Mark, Converter={StaticResource MarkToSymbol}}"
                                   IconVariant="{Binding Weight, Converter={StaticResource WeightToVariant}}"
                                   Foreground="{Binding LabelInk}"
                                   FontSize="{Binding SupportSize}"
                                   VerticalAlignment="Center">
                    <fluent:SymbolIcon.Style>
                        <Style TargetType="fluent:SymbolIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding MarkIsIcon}" Value="True" />
                                        <Condition Binding="{Binding IsPacer}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </fluent:SymbolIcon.Style>
                </fluent:SymbolIcon>

                <controls:MeterPacer Style="{StaticResource MeterPacerStyle}"
                                     Speed="{Binding Speed}"
                                     Ink="{Binding LabelInk}" />

                <TextBlock Text="{Binding Label}"
                           Foreground="{Binding LabelInk}"
                           FontSize="{Binding SupportSize}"
                           FontWeight="{Binding Weight}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="{Binding Label, Converter={StaticResource TextToVisibility}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MarkIsIcon}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding Value}"
                           Style="{StaticResource MeterFigureStyle}"
                           Foreground="{Binding Figure}"
                           FontSize="{Binding Size}"
                           FontWeight="{Binding Weight}"
                           MinWidth="{Binding ValueReserve}" />

                <controls:MeterSpark Style="{StaticResource MeterSparkAloneStyle}"
                                     Width="34"
                                     Values="{Binding SparkValues}"
                                     Count="{Binding SparkCount}"
                                     Version="{Binding SparkVersion}"
                                     Mode="{Binding Graph}"
                                     Ceiling="{Binding SparkCeiling}"
                                     Ink="{Binding Figure}" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Text="{Binding Unit}"
                       Foreground="{Binding Support}"
                       FontSize="{Binding SupportSize}"
                       HorizontalAlignment="Right"
                       Margin="0,-2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="{Binding UnitShown, Converter={StaticResource BooleanToVisibility}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GraphAlone}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        </Grid>
    </DataTemplate>

    <!--
        The whole meter: as many rows and columns of readings as the reader has
        asked for. A uniform grid, so every slot is the same size and the
        columns line up down the bar.
    -->
    <DataTemplate x:Key="MeterTemplate" DataType="{x:Type vm:TaskbarMeterViewModel}">
        <!--
            Pulled back by the room each reading carries on its right, so the
            last column does not leave a strip of empty bar after it. Every
            column keeps its gap; only the one at the end has nothing to be
            apart from.
        -->
        <ItemsControl ItemsSource="{Binding Slots}"
                      FontFamily="Segoe UI"
                      VerticalAlignment="Stretch"
                      Margin="0,0,-8,0"
                      Focusable="False">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemTemplate" Value="{StaticResource MeterSlotTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UnitBelow}" Value="True">
                            <Setter Property="ItemTemplate" Value="{StaticResource MeterSlotUnderTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>

    <!--
        The hover card's frame: the app's popover look - its popup tone, a
        hairline edge and rounded corners, the same as a chart's or a map
        node's popover - because it floats above the taskbar like Windows' own
        flyouts. No drop shadow of WPF's own: on a layered window it draws as a
        grey box.
    -->
    <Style x:Key="MeterCardStyle" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource PopupBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,11,14,13"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A switch, for the settings that are simply on or off.

        WPF has no switch of its own, and a check box is the wrong shape for
        this: a tick says "this is included in a set", a switch says "this is
        running". Everything the Taskbar page turns on takes effect the moment it
        is turned on, which is the second of those. The keyboard's ring is the
        shared focus visual, drawn only for the keyboard.
    -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" Width="42" Height="24">
                        <Border x:Name="Track"
                                Width="38"
                                Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                BorderThickness="1" />

                        <Ellipse x:Name="Thumb"
                                 Width="12"
                                 Height="12"
                                 Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="6,0,0,0" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,6,0" />
                            <!-- Against a filled track the thumb has to be the
                                 page's own ground rather than a text colour,
                                 or it disappears into the accent. -->
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SurfaceBrush}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="14" />
                            <Setter TargetName="Thumb" Property="Height" Value="14" />
                            <Setter TargetName="Thumb" Property="Margin" Value="5,0,0,0" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,5,0" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One cell of the slot board: what that position on the bar shows,
        standing where it will stand on the bar. The board is the page's lead,
        so its cells are plates on the page - one step off it, no outline, two
        pixels of page between them - like the Overview's figures.
    -->
    <Style x:Key="SlotCellStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Background" Value="{DynamicResource PlateBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToneStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8,8,9" />
        <Setter Property="Margin" Value="0,0,2,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        The place a new row or column would arrive in, standing in the grid
        before it exists, the same size as a slot. Quiet rather than outlined:
        the translucent fill the page's buttons have, so it reads as something
        to press rather than as a slot that has lost its contents. The whole
        place is the button.
    -->
    <Style x:Key="SlotAddStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Margin" Value="0,0,2,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            CornerRadius="8"
                            Background="{DynamicResource QuietFillBrush}"
                            BorderBrush="{DynamicResource ToneStrokeBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource QuietPressedBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The plus in the middle of that place. -->
    <Style x:Key="SlotAddSignStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize19}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!--
        One part of a cell in the editor: the mark, the figure or the unit.

        Each is a button of its own, because each is configured on its own: the
        reader points at the thing they want to change rather than hunting for
        its name in a list of settings. Drawn as the meter draws it - same
        colour, same weight - so the cell is a picture of what the taskbar will
        show rather than a description of it. The part whose sheet is open
        takes the accent's soft fill.
    -->
    <Style x:Key="CellPartStyle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face"
                            CornerRadius="4"
                            Padding="3,2"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One colour a part may be painted. A swatch keeps a hairline of its own,
        so a white one on a white sheet is still a swatch.
    -->
    <Style x:Key="InkStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            CornerRadius="5"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True" />

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A choice inside a part's sheet: "Taskbar text", "Left", "Picture".
        Quiet like every other button - the translucent fill, no outline - so
        it is one step off the sheet it sits on.
    -->
    <Style x:Key="PartChoiceStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize11_5}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ToneStrokeBrush}"
                            Background="{DynamicResource QuietFillBrush}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource QuietPressedBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The same as a choice, but one that stays down: what is under it is
        shown while it is. Down, it takes the accent's soft fill.
    -->
    <Style x:Key="PartToggleStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize11_5}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ToneStrokeBrush}"
                            Background="{DynamicResource QuietFillBrush}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Putting one part of one cell back the way it started. Quiet: it sits in
        the corner of every sheet, and a reader looking at three of them at once
        should be reading the choices rather than the ways out of them.
    -->
    <Style x:Key="PartResetStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize11}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            CornerRadius="5"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <!--
                            Gone rather than greyed while there is nothing to
                            put back: a way out of a choice nobody made is one
                            more thing to read in a sheet already full of them.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A slider in the app's own flat drawing rather than the one WPF ships,
        which is a decade older than everything around it. Used for mixing a
        colour by hand and for setting how wide the meter is; what it counts is
        set where it is used, since those are not the same numbers.
    -->
    <Style x:Key="FlatSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource QuietHoverBrush}" />

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Focusable="False"
                                              Opacity="0"
                                              AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0}: less'}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False"
                                              Opacity="0"
                                              AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0}: more'}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                                     Stroke="{DynamicResource ToneStrokeBrush}"
                                                     StrokeThickness="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The letter beside a colour slider. The same values the cell mixer sets
        inline, named once so the two mixers cannot drift apart.
    -->
    <Style x:Key="MixLabelStyle" TargetType="TextBlock">
        <Setter Property="Width" Value="14" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize10_5}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- The heading of a part of a sheet: "COLOUR", "SITS AT". -->
    <Style x:Key="PartHeadStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize10}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- A line of explanation inside a sheet. -->
    <Style x:Key="PartNoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize11}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
        Emptying a slot: a cross in the corner of the cell it empties, which is
        where a thing is dismissed from. Gone while the slot is already blank -
        a control that would do nothing is worse than no control.
    -->
    <Style x:Key="SlotDropStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            CornerRadius="5"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Cross"
                              Data="M 0 0 L 7 7 M 7 0 L 0 7"
                              Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                            <Setter TargetName="Cross" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The cell's own corner button for what is beyond its three parts: a
        graph, colour levels, taking turns, a feed. A toggle, because it opens
        a sheet as the parts do.
    -->
    <Style x:Key="SlotMoreStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face"
                            CornerRadius="5"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlotAddressStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize10}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- What a cell does beyond its three parts, in a line under them: "Graph · 3 levels". -->
    <Style x:Key="SlotExtrasStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize10_5}" />
        <Setter Property="Margin" Value="3,5,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
        A one-click layout on the Layouts band: a tile one step up from the
        band, its name and what it puts on the bar. The layout the meter has
        now takes the accent's soft fill.
    -->
    <Style x:Key="PresetTileStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,2,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{DynamicResource InsetBrush}"
                            BorderBrush="{DynamicResource ToneStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{DynamicResource TilePadding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsChosen}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

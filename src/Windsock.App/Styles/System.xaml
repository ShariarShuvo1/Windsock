<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:Windsock.App.Controls"
                    xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">

    <!--
        The System pages. One part of the machine at a time - chosen in the
        sidebar - with its chart first, and under it everything the machine will
        say about that part.

        Flat surfaces throughout, never a gradient. Each part keeps its own hue
        on its chart line and meters, which is what tells the five pages apart
        at a glance.
    -->

    <!-- A small reading set beside a name: a temperature, a drive's wear. -->
    <Style x:Key="TileBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        Placeholders. A page waiting for its first reading draws its own shape in
        these rather than a line of text, so the eye already knows where things
        will be, and nothing jumps when they arrive.

        The group breathes while it is on screen, unless Windows has animation
        switched off; a hidden one does not tick at all.
    -->
    <Style x:Key="SkeletonStyle" TargetType="FrameworkElement">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Breathe">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1"
                                             To="0.45"
                                             Duration="0:0:0.9"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Breathe" />
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One placeholder shape: a line of text, a figure, a bar. -->
    <Style x:Key="BoneStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BoneBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A fact beside a chart: its label over its figure, the height the real pair takes. -->
    <Style x:Key="FactBoneStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border>
                        <StackPanel>
                            <Border Style="{StaticResource BoneStyle}" Width="56" Height="9" Margin="0,3,0,5" />
                            <Border Style="{StaticResource BoneStyle}" Width="110" Height="14" Margin="0,0,0,2" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A figure in a strip: label, figure, note. -->
    <Style x:Key="StatBoneStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource PlateCellStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource BoneStyle}" Width="84" Height="9" Margin="0,2,0,0" />
                            <Border Style="{StaticResource BoneStyle}" Width="72" Height="20" Margin="0,9,0,0" />
                            <Border Style="{StaticResource BoneStyle}" Width="100" Height="9" Margin="0,7,0,1" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A named meter: its name, the bar, its reading. -->
    <Style x:Key="MeterBoneStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource BoneStyle}" Width="22" Height="10" />
                        <Border Grid.Column="1" Style="{StaticResource BoneStyle}" Height="8" HorizontalAlignment="Stretch" />
                        <Border Grid.Column="2" Style="{StaticResource BoneStyle}" Width="28" Height="10" HorizontalAlignment="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A titled list of meters: engines, busiest processes. -->
    <Style x:Key="ListBoneStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource BoneStyle}" Width="90" Height="14" Margin="0,0,0,14" />
                            <ContentControl Style="{StaticResource MeterBoneStyle}" Margin="0,0,0,10" />
                            <ContentControl Style="{StaticResource MeterBoneStyle}" Margin="0,0,0,10" />
                            <ContentControl Style="{StaticResource MeterBoneStyle}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A titled gauge: the name, the bar, the figure and a note. -->
    <Style x:Key="GaugeBoneStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource BoneStyle}" Width="70" Height="14" />
                            <Border Style="{StaticResource BoneStyle}" Height="10" Margin="0,14,0,12" HorizontalAlignment="Stretch" />
                            <Border Style="{StaticResource BoneStyle}" Width="160" Height="14" />
                            <Border Style="{StaticResource BoneStyle}" Width="200" Height="10" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The label over a network figure, in the colour its line has on the chart
        above, with the same arrow: download cyan and down, upload amber and up.
        Only the label and its arrow take the colour; the figure stays the plain
        bright text it is everywhere else, so the eye finds a direction by colour
        and still reads the number as the number.
    -->
    <Style x:Key="DirectionLabelStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource DownloadBrush}" />
        <Setter Property="Tag" Value="ArrowDownload" />
        <Setter Property="Template">
            <Setter.Value>
                <!--
                    The arrow docked and the words filling what is left, so a
                    label too long for a narrow plate - or for a larger Windows
                    text size - wraps rather than ending "DOWNLOADED TODA".
                -->
                <ControlTemplate TargetType="ContentControl">
                    <DockPanel LastChildFill="True">
                        <fluent:SymbolIcon DockPanel.Dock="Left"
                                           Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{DynamicResource TextSize12}"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Top"
                                           Foreground="{TemplateBinding Foreground}" />
                        <TextBlock Text="{TemplateBinding Content}"
                                   Style="{StaticResource StatLabelStyle}"
                                   TextTrimming="None"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UploadLabelStyle" TargetType="ContentControl" BasedOn="{StaticResource DirectionLabelStyle}">
        <Setter Property="Foreground" Value="{DynamicResource UploadBrush}" />
        <Setter Property="Tag" Value="ArrowUpload" />
    </Style>

    <!--
        The column beside every System chart. Shared, so the plot starts at the
        same place whichever tile is chosen.
    -->
    <sys:Double x:Key="ChartLeadWidth">272</sys:Double>

    <Style x:Key="PartChartStyle" TargetType="controls:ShareChart">
        <Setter Property="Stroke" Value="{DynamicResource NetworkBrush}" />
        <Setter Property="GridBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="AxisBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="LabelBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SurfaceBrush" Value="{DynamicResource CardBrush}" />
        <Setter Property="PlateBrush" Value="{DynamicResource PopupBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Part}" Value="Processor">
                <Setter Property="Stroke" Value="{DynamicResource ProcessorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Part}" Value="Graphics">
                <Setter Property="Stroke" Value="{DynamicResource GraphicsBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Part}" Value="Memory">
                <Setter Property="Stroke" Value="{DynamicResource MemoryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Part}" Value="Storage">
                <Setter Property="Stroke" Value="{DynamicResource StorageBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Part}" Value="Battery">
                <Setter Property="Stroke" Value="{DynamicResource BatteryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A label over a figure beside a chart. Stacked rather than side by side,
        so a long figure - "1.64 GB of 8.00 GB" - wraps nothing and pushes
        nothing out of the column.
    -->
    <DataTemplate x:Key="TileFactTemplate">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{Binding Label}"
                       FontSize="{DynamicResource TextSize11_5}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{Binding Value}"
                       FontSize="{DynamicResource TextSize14}"
                       FontWeight="SemiBold"
                       Margin="0,1,0,0"
                       TextTrimming="CharacterEllipsis"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>
    </DataTemplate>

    <!-- A label above a figure, inside the detail panel. -->
    <Style x:Key="DetailCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style x:Key="DetailValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="DetailNoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize11_5}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!--
        A meter with its name on the left and its reading on the right. The
        name column is fixed so that a column of them lines up, and the reading
        column is fixed so the bars all end in the same place.
    -->
    <DataTemplate x:Key="CoreMeterTemplate">
        <Grid Margin="0,0,14,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Label}"
                       FontSize="{DynamicResource TextSize10_5}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <controls:MeterBar Grid.Column="1"
                               Height="8"
                               VerticalAlignment="Center"
                               Fraction="{Binding Fraction}"
                               Fill="{DynamicResource ProcessorBrush}"
                               Track="{DynamicResource MeterTrackBrush}" />

            <TextBlock Grid.Column="2"
                       Text="{Binding Value}"
                       FontSize="{DynamicResource TextSize10_5}"
                       Margin="7,0,0,0"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </DataTemplate>

    <!--
        The label column is as wide as the longest label in the list rather than
        a fixed width, and every row shares that width so the bars still line
        up. A fixed column either wastes half the card on short names or leaves
        no room for the bar in a narrow window.
    -->
    <DataTemplate x:Key="EngineMeterTemplate">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MeterLabel" />
                <ColumnDefinition Width="*" MinWidth="30" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MeterValue" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Label}"
                       FontSize="{DynamicResource TextSize11_5}"
                       MaxWidth="170"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <controls:MeterBar Grid.Column="1"
                               Height="8"
                               VerticalAlignment="Center"
                               Fraction="{Binding Fraction}"
                               Fill="{DynamicResource GraphicsBrush}"
                               Track="{DynamicResource MeterTrackBrush}" />

            <TextBlock Grid.Column="2"
                       Text="{Binding Value}"
                       FontSize="{DynamicResource TextSize11_5}"
                       MinWidth="32"
                       Margin="8,0,0,0"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="VolumeTemplate">
        <Grid Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="VolumeLabel" />
                <ColumnDefinition Width="*" MinWidth="30" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        MaxWidth="200"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}"
                           FontSize="{DynamicResource TextSize12}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <TextBlock Text="{Binding Format}"
                           FontSize="{DynamicResource TextSize10_5}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <controls:MeterBar Grid.Column="1"
                               Height="9"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Fraction="{Binding Fraction}"
                               Fill="{DynamicResource StorageBrush}"
                               Track="{DynamicResource MeterTrackBrush}" />

            <TextBlock Grid.Column="2"
                       Text="{Binding Free}"
                       FontSize="{DynamicResource TextSize11_5}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MemoryModuleTemplate">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ModuleSlot" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ModuleSize" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ModuleSpeed" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Slot}"
                       FontSize="{DynamicResource TextSize12}"
                       MaxWidth="220"
                       Margin="0,0,16,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Size}"
                       FontSize="{DynamicResource TextSize12}"
                       FontWeight="SemiBold"
                       Margin="0,0,16,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <TextBlock Grid.Column="2"
                       Text="{Binding Speed}"
                       FontSize="{DynamicResource TextSize12}"
                       Margin="0,0,16,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Grid.Column="3"
                       Text="{Binding Part}"
                       FontSize="{DynamicResource TextSize12}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>

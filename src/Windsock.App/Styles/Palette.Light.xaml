<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light-theme palette. Same hues as the dark palette (the mark's cyan at
        197, and 36 against it), taken several steps darker so they hold
        contrast against the near-white Fluent surfaces instead of washing out.
        The mark's own values are too light to use here: cyan #2DC1FC on white
        is close to unreadable, which is the whole reason this file exists.
    -->

    <Color x:Key="BrandNavyColor">#FF0E2231</Color>
    <Color x:Key="BrandIceColor">#FFD9F0FD</Color>

    <!-- Section accent. Hue 187 sits inside the mark's cyan family but clear
         of the download series, so a section icon reads as brand rather than
         as a data series. -->
    <Color x:Key="AccentColor">#FF00838F</Color>

    <Color x:Key="DownloadColor">#FF0288D1</Color>
    <Color x:Key="UploadColor">#FFC77700</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DownloadBrush" Color="{StaticResource DownloadColor}" />
    <SolidColorBrush x:Key="UploadBrush" Color="{StaticResource UploadColor}" />
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandNavyColor}" />

    <!--
        Table rows. Dark on light rather than light on dark, and weaker: the
        same contrast ratio reads as heavier over a pale surface.
    -->
    <SolidColorBrush x:Key="RowStripeBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3300838F" />

    <!--
        The same three surfaces, deepest first. Over a pale ground the steps are
        smaller: the eye reads the same contrast ratio as heavier on light than
        it does on dark.
    -->
    <SolidColorBrush x:Key="WindowGroundBrush" Color="#FFE4E4E4" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#FFEFEFEF" />

    <!--
        The graph's own ground, sunk into the card the same way. Below the card
        and below the nodes, and still clear of the window behind it so the well
        reads as part of the card rather than a hole through it.
    -->
    <SolidColorBrush x:Key="CanvasGroundBrush" Color="#FFEDEDED" />

    <!-- The world map: land a shade below the sea it sits in, coastlines below
         that, and the country under the pointer picked out. -->
    <SolidColorBrush x:Key="MapLandBrush" Color="#FFDCDCDC" />
    <SolidColorBrush x:Key="MapCoastBrush" Color="#FFB4B4B4" />
    <SolidColorBrush x:Key="MapLandLitBrush" Color="#FFC3E1E5" />

    <!-- The busiest country, when the map is shaded by traffic. Everything
         else is mixed between this and the plain land. -->
    <SolidColorBrush x:Key="MapBusyBrush" Color="#FFAFD8DE" />


    <!--
        The same four hues, taken darker in the same way the accent is, so each
        tile keeps its identity against a near-white surface instead of washing
        out into it.
    -->
    <Color x:Key="ProcessorColor">#FF00838F</Color>
    <Color x:Key="GraphicsColor">#FF2E7D32</Color>
    <Color x:Key="MemoryColor">#FF6A3AB2</Color>
    <Color x:Key="StorageColor">#FFC77700</Color>

    <SolidColorBrush x:Key="ProcessorBrush" Color="{StaticResource ProcessorColor}" />
    <SolidColorBrush x:Key="GraphicsBrush" Color="{StaticResource GraphicsColor}" />
    <SolidColorBrush x:Key="MemoryBrush" Color="{StaticResource MemoryColor}" />
    <SolidColorBrush x:Key="StorageBrush" Color="{StaticResource StorageColor}" />

    <SolidColorBrush x:Key="MeterTrackBrush" Color="#1F000000" />

    <SolidColorBrush x:Key="HotBrush" Color="#FFD84315" />

</ResourceDictionary>

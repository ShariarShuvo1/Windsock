<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windsock's tools for AI assistants: a Model Context Protocol server over
    stdio, which an assistant starts as a
    child process. Read-only, and it reads only the local feed, so it does
    nothing at all until the feed is switched on in Windsock. Its own small
    program rather than a mode of Windsock.exe, so an assistant never starts the
    GUI, and stdout - the protocol's channel - is never anybody else's.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Windsock.Mcp</RootNamespace>
    <AssemblyName>Windsock.Mcp</AssemblyName>
    <ApplicationIcon>..\Windsock.App\Assets\Windsock.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Windsock.Core\Windsock.Core.csproj" />
  </ItemGroup>

</Project>

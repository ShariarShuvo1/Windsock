<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Clear inherited sources so the build only ever resolves from sources
       declared here. Combined with packageSourceMapping below this closes the
       dependency-confusion hole where an unexpected feed can shadow a package. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
